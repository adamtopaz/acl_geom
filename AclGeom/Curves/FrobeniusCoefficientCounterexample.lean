import AclGeom.Curves.DerivationExtension
import Mathlib.Algebra.CharP.Algebra
import Mathlib.Algebra.CharP.Reduced
import Mathlib.Algebra.MvPolynomial.Derivation
import Mathlib.RingTheory.Localization.FractionRing

/-!
# Field-point faithfulness does not detect ordinary coefficient derivations

The Frobenius-twisted affine family has distinct field-valued parameters and consists of
bijections. Every ordinary parameter derivation kills its coefficients, even on a rational
function field with a nonzero derivation. Named consumer: the corrected effective-field
variation producer, which works over the field generated by the coefficients themselves.

**Status:** proved companion to the corrected effective-field variation producer. This
refutes the attempted coefficient-detection inference, not the source genus or affine-action
statement.
-/

namespace AclGeom

noncomputable section

universe u

private theorem frobenius_affine_family (E : Type u) [Field E]
    (p : ℕ) [Fact p.Prime] [CharP E p] :
    Function.Injective (fun q : Eˣ × E ↦ fun x : E ↦ (q.1 : E) ^ p * x + q.2 ^ p) ∧
      ∀ q : Eˣ × E, Function.Bijective (fun x : E ↦ (q.1 : E) ^ p * x + q.2 ^ p) := by
  constructor
  · intro q r h
    have hb : q.2 = r.2 := frobenius_inj E p (by
      simpa only [frobenius_def, mul_zero, zero_add] using congrFun h 0)
    have ha : (q.1 : E) = (r.1 : E) := frobenius_inj E p (by
      have h1 := congrFun h 1
      simp only [mul_one, hb] at h1
      exact add_right_cancel h1)
    exact Prod.ext (Units.ext ha) hb
  · intro q
    have ha : (q.1 : E) ^ p ≠ 0 := pow_ne_zero p q.1.ne_zero
    constructor
    · intro x y h
      exact mul_left_cancel₀ ha (add_right_cancel h)
    · intro y
      refine ⟨(y - q.2 ^ p) / (q.1 : E) ^ p, ?_⟩
      field_simp
      ring

/-- The affine Frobenius coefficient family is faithful on every field extension of k, but
ordinary derivations of its original two-variable parameter field cannot detect any of its
coefficients. A nonzero ordinary derivation of that field is constructed internally.
Named consumer: the corrected coefficient-field variation theorem; passing to the field
generated by the actual coefficients avoids this false field-point-to-derivation inference. -/
theorem field_point_faithfulness_does_not_detect_coefficient_derivations
    (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [CharP k p] :
    let C := FractionRing (MvPolynomial (Fin 2) k)
    ∃ D : Derivation k C C, D ≠ 0 ∧
      (∀ (E : Type u) [Field E] [Algebra k E],
        Function.Injective (fun q : Eˣ × E ↦ fun x : E ↦ (q.1 : E) ^ p * x + q.2 ^ p) ∧
          ∀ q : Eˣ × E, Function.Bijective (fun x : E ↦ (q.1 : E) ^ p * x + q.2 ^ p)) ∧
      ∀ (δ : Derivation k C C) (q : Cˣ × C),
        δ ((q.1 : C) ^ p) = 0 ∧ δ (q.2 ^ p) = 0 := by
  let C := FractionRing (MvPolynomial (Fin 2) k)
  dsimp only
  have : CharP C p := charP_of_injective_algebraMap (algebraMap k C).injective p
  let D : Derivation k C C :=
    ((Algebra.linearMap (MvPolynomial (Fin 2) k) C).compDer
      (MvPolynomial.pderiv (0 : Fin 2))).extendOfFormallyEtale
  have hDX : D (algebraMap (MvPolynomial (Fin 2) k) C (MvPolynomial.X (0 : Fin 2))) = 1 := by
    dsimp only [D]
    rw [Derivation.extendOfFormallyEtale_algebraMap]
    change algebraMap (MvPolynomial (Fin 2) k) C
      (MvPolynomial.pderiv (0 : Fin 2) (MvPolynomial.X 0)) = 1
    rw [MvPolynomial.pderiv_X_self, map_one]
  refine ⟨D, ?_, ?_, ?_⟩
  · intro h
    have hz : D (algebraMap (MvPolynomial (Fin 2) k) C (MvPolynomial.X (0 : Fin 2))) = 0 := by
      rw [h]
      rfl
    exact one_ne_zero (hDX.symm.trans hz)
  · intro E _ _
    have : CharP E p := charP_of_injective_algebraMap (algebraMap k E).injective p
    exact frobenius_affine_family E p
  · intro δ q
    have hp (x : C) : δ (x ^ p) = 0 := by
      rw [Derivation.leibniz_pow, ← Nat.cast_smul_eq_nsmul C,
        CharP.cast_eq_zero C p, zero_smul]
    exact ⟨hp _, hp _⟩

end

end AclGeom
