import AclGeom.Main
import Mathlib.Algebra.Order.Group.End

/-!
# The automorphism exact sequence

Let `K/k` be relatively algebraically closed with `trdeg(K/k) ≥ 5`, and let `π` be a chosen
perfection of `K`. The automorphisms of `K^perf` carrying `k^perf` onto itself form the group
`PairAut(k^perf, K^perf)` (`Perfection.pairAut`). Each one acts on `𝒢(K/k)` by its transported
lattice map `M ↦ Φ(M^perf) ∩ K` (`Perfection.pairAutAction`, blueprint (20.6)). The closing
paragraph of the proof of blueprint Thm `target` gives the exact sequence
`1 → ⟨Frob⟩ → PairAut(k^perf, K^perf) → Aut 𝒢(K/k) → 1`:

* the action is surjective (`Perfection.pairAutAction_surjective`), by existence;
* its kernel is the subgroup generated by Frobenius (`Perfection.ker_pairAutAction`), by the
  Frobenius kernel theorem;
* the kernel is trivial in characteristic zero (`Perfection.ker_pairAutAction_eq_bot`) and
  infinite cyclic in positive characteristic (`Perfection.kerPairAutActionEquivInt`).

**Status:** proved.
-/

namespace AclGeom

noncomputable section

namespace Perfection

variable {k K : Type*} [Field k] [Field K] [Algebra k K] (π : Perfection K)

variable (k) in
/-- `PairAut(k^perf, K^perf)`: the automorphisms of the chosen perfection carrying the perfected
base onto itself. -/
def pairAut : Subgroup (RingAut π.carrier) where
  carrier := {Φ | CrossBase.Compatible (k := π.basePerf k) (l := π.basePerf k) Φ}
  mul_mem' hΦ hΨ := CrossBase.Compatible.trans hΨ hΦ
  one_mem' := CrossBase.compatible_refl
  inv_mem' hΦ := CrossBase.Compatible.symm hΦ

theorem mem_pairAut {Φ : RingAut π.carrier} :
    Φ ∈ π.pairAut k ↔ CrossBase.Compatible (k := π.basePerf k) (l := π.basePerf k) Φ :=
  Iff.rfl

variable (k) in
/-- The action of `PairAut(k^perf, K^perf)` on `𝒢(K/k)` by the transported lattice map. -/
def pairAutAction : π.pairAut k →* (ClosedIF k K ≃o ClosedIF k K) where
  toFun Φ := π.inducedIso π ((π.mem_pairAut).1 Φ.2)
  map_one' := π.inducedIso_refl
  map_mul' Φ Ψ := inducedIso_trans ((π.mem_pairAut).1 Ψ.2) ((π.mem_pairAut).1 Φ.2)

theorem pairAutAction_apply (Φ : π.pairAut k) :
    π.pairAutAction k Φ = π.inducedIso π ((π.mem_pairAut).1 Φ.2) :=
  rfl

/-- **Surjectivity**: every automorphism of `𝒢(K/k)` is induced by an automorphism of the
chosen perfection carrying `k^perf` onto itself. -/
theorem pairAutAction_surjective (hk : IsRAC (⊥ : IntermediateField k K))
    (htr : (5 : Cardinal) ≤ Algebra.trdeg k K) : Function.Surjective (π.pairAutAction k) := by
  intro φ
  obtain ⟨-, Φ, hΦ, h, -⟩ := reconstruction_target π π hk hk htr φ
  exact ⟨⟨Φ, hΦ⟩, ((induces_iff_eq_inducedIso hΦ).1 h).symm⟩

/-- Integral Frobenius powers belong to `PairAut(k^perf, K^perf)`. -/
theorem frobZPow_mem_pairAut (hk : IsRAC (⊥ : IntermediateField k K)) (n : ℤ) :
    π.frobZPow n ∈ π.pairAut k :=
  π.compatible_frobZPow hk n

/-- Integral powers of the Frobenius element of `PairAut(k^perf, K^perf)`. -/
private theorem frob_zpow (hk : IsRAC (⊥ : IntermediateField k K)) (n : ℤ) :
    (⟨π.frobZPow 1, π.frobZPow_mem_pairAut hk 1⟩ : π.pairAut k) ^ n =
      ⟨π.frobZPow n, π.frobZPow_mem_pairAut hk n⟩ := by
  apply Subtype.ext
  rw [SubgroupClass.coe_zpow]
  simp only [frobZPow, frobeniusZPow, zpow_one]

/-- **The kernel** of the action is the subgroup generated by Frobenius. -/
theorem ker_pairAutAction (hk : IsRAC (⊥ : IntermediateField k K))
    (htr : (5 : Cardinal) ≤ Algebra.trdeg k K) :
    (π.pairAutAction k).ker = Subgroup.zpowers ⟨π.frobZPow 1, π.frobZPow_mem_pairAut hk 1⟩ := by
  ext Φ
  rw [MonoidHom.mem_ker, Subgroup.mem_zpowers_iff]
  have h1 : π.Induces π (OrderIso.refl (ClosedIF k K)) (RingEquiv.refl π.carrier) := by
    have h := induces_inducedIso (π := π) (ρ := π) (CrossBase.compatible_refl (k := π.basePerf k))
    rwa [inducedIso_refl] at h
  constructor
  · intro h
    have hΦ : π.Induces π (OrderIso.refl (ClosedIF k K)) (Φ : RingAut π.carrier) := by
      have h' := induces_inducedIso (π := π) (ρ := π) ((π.mem_pairAut).1 Φ.2)
      rw [← pairAutAction_apply, h] at h'
      exact h'
    obtain ⟨n, hn⟩ := (h1.iff_exists_eq_trans_frobZPow htr).1 hΦ
    refine ⟨n, ?_⟩
    rw [π.frob_zpow hk]
    apply Subtype.ext
    exact (hn.trans (RingEquiv.ext fun _ ↦ rfl)).symm
  · rintro ⟨n, rfl⟩
    rw [π.frob_zpow hk, pairAutAction_apply]
    exact π.inducedIso_frobZPow hk n

/-- **Characteristic zero**: the action is injective. -/
theorem ker_pairAutAction_eq_bot (hk : IsRAC (⊥ : IntermediateField k K))
    (htr : (5 : Cardinal) ≤ Algebra.trdeg k K) (hp : π.p = 1) : (π.pairAutAction k).ker = ⊥ := by
  rw [π.ker_pairAutAction hk htr, Subgroup.zpowers_eq_bot]
  apply Subtype.ext
  exact frobeniusZPow_eq_one_of_eq_one (K := π.carrier) π.p hp 1

/-- **Positive characteristic**: the kernel of the action is infinite cyclic, generated by
Frobenius. -/
def kerPairAutActionEquivInt (hk : IsRAC (⊥ : IntermediateField k K))
    (htr : (5 : Cardinal) ≤ Algebra.trdeg k K) (hp : π.p ≠ 1) :
    Multiplicative ℤ ≃* (π.pairAutAction k).ker :=
  MulEquiv.ofBijective (zpowersHom _ ⟨⟨π.frobZPow 1, π.frobZPow_mem_pairAut hk 1⟩, by
    rw [π.ker_pairAutAction hk htr]
    exact Subgroup.mem_zpowers _⟩) <| by
  constructor
  · intro m n h
    have h' := congrArg
      (fun x : (π.pairAutAction k).ker ↦ ((x : π.pairAut k) : RingAut π.carrier)) h
    simp only [zpowersHom_apply, SubgroupClass.coe_zpow] at h'
    have hpow (j : ℤ) : π.frobZPow 1 ^ j = π.frobZPow j := by
      simp only [frobZPow, frobeniusZPow, zpow_one]
    rw [hpow, hpow] at h'
    apply Multiplicative.toAdd.injective
    apply trans_frobZPow_injective (π := π) (ρ := π) (OrderIso.refl (ClosedIF k K)) htr hp
      (RingEquiv.refl π.carrier)
    exact (RingEquiv.ext fun _ ↦ rfl).trans (h'.trans (RingEquiv.ext fun _ ↦ rfl))
  · rintro ⟨Φ, hΦ⟩
    rw [π.ker_pairAutAction hk htr, Subgroup.mem_zpowers_iff] at hΦ
    obtain ⟨n, hn⟩ := hΦ
    refine ⟨Multiplicative.ofAdd n, Subtype.ext ?_⟩
    rw [zpowersHom_apply, toAdd_ofAdd, SubgroupClass.coe_zpow]
    exact hn

end Perfection

end

end AclGeom
