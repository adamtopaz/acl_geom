/-- Clause `X_free` is the exact rank-two minimal-parameter statement for
the `A`-family: no atom below `A` makes the generic incidence algebraic. -/
theorem X_rep_notMem_racl_atom_Y (hψ : w.Psi)
    (A' : Point k K) (hA' : A'.1 ≤ w.A) :
    w.X.rep ∉ racl k ({A'.rep, w.Y.rep} : Set K) := by
  intro hX
  exact hψ.X_free A' hA'
    (point_le_sup_of_rep_mem_racl_pair w.X A' w.Y hX)

/-- Clause `Z_freeB` gives minimal parameter rank two for the `B`-family. -/
theorem Z_rep_notMem_racl_atom_Y (hψ : w.Psi)
    (B' : Point k K) (hB' : B'.1 ≤ w.B) :
    w.Z.rep ∉ racl k ({B'.rep, w.Y.rep} : Set K) := by
  intro hZ
  exact hψ.Z_freeB B' hB'
    (point_le_sup_of_rep_mem_racl_pair w.Z B' w.Y hZ)

/-- Clause `Z_freeC` gives minimal parameter rank two for the `C`-family. -/
theorem Z_rep_notMem_racl_atom_X (hψ : w.Psi)
    (C' : Point k K) (hC' : C'.1 ≤ w.C) :
    w.Z.rep ∉ racl k ({C'.rep, w.X.rep} : Set K) := by
  intro hZ
  exact hψ.Z_freeC C' hC'
    (point_le_sup_of_rep_mem_racl_pair w.Z C' w.X hZ)

/-- **Exact parameter-rank input for the three correspondence families.**
The displayed `A,B,C` parameter pairs are independent, while the atom
clauses say that no rank-one subparameter already defines the corresponding
generic incidence. -/
theorem psi_family_parameters_rank_two_minimal (hψ : w.Psi) :
    AlgebraicIndependent k w.aReps ∧
      AlgebraicIndependent k w.bReps ∧
      AlgebraicIndependent k w.cReps ∧
      (∀ A' : Point k K, A'.1 ≤ w.A →
        w.X.rep ∉ racl k ({A'.rep, w.Y.rep} : Set K)) ∧
      (∀ B' : Point k K, B'.1 ≤ w.B →
        w.Z.rep ∉ racl k ({B'.rep, w.Y.rep} : Set K)) ∧
      (∀ C' : Point k K, C'.1 ≤ w.C →
        w.Z.rep ∉ racl k ({C'.rep, w.X.rep} : Set K)) :=
  ⟨w.aReps_independent hψ, w.bReps_independent hψ,
    w.cReps_independent hψ, w.X_rep_notMem_racl_atom_Y hψ,
    w.Z_rep_notMem_racl_atom_Y hψ,
    w.Z_rep_notMem_racl_atom_X hψ⟩

