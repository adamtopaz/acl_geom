      w.Y_rep_mem_racl_abReps_snoc_Z hψ

/-- After adjoining the independent `B` parameters, the `A` family member
has the selected `(X,Y)` prime branch used in composition. -/
theorem aFamily_map_le_abBranch (hψ : w.Psi) :
    Ideal.map
        (MvPolynomial.map
          (IntermediateField.inclusion w.aField_le_abField))
        (w.xyCorrespondencePairOverA hψ).ideal ≤
      (w.xyCorrespondencePair hψ).ideal := by
  change Ideal.map
      (MvPolynomial.map
        (IntermediateField.inclusion w.aField_le_abField))
      (idealOf (↥w.aField) ![w.X.rep, w.Y.rep]) ≤
    idealOf (↥w.abField) ![w.X.rep, w.Y.rep]
  exact idealOf_map_le_of_intermediateField_le
    w.aField_le_abField ![w.X.rep, w.Y.rep]

/-- After adjoining the independent `A` parameters, the `B` family member
has the selected `(Y,Z)` prime branch used in composition. -/
theorem bFamily_map_le_abBranch (hψ : w.Psi) :
    Ideal.map
        (MvPolynomial.map
          (IntermediateField.inclusion w.bField_le_abField))
        (w.yzCorrespondencePairOverB hψ).ideal ≤
      (w.yzCorrespondencePair hψ).ideal := by
  change Ideal.map
      (MvPolynomial.map
        (IntermediateField.inclusion w.bField_le_abField))
      (idealOf (↥w.bField) ![w.Y.rep, w.Z.rep]) ≤
    idealOf (↥w.abField) ![w.Y.rep, w.Z.rep]
  exact idealOf_map_le_of_intermediateField_le
    w.bField_le_abField ![w.Y.rep, w.Z.rep]

/-- The endpoint branch selected by composing the actual `X → Y` and
`Y → Z` generic pairs from a `Psi` witness. -/
def xzCorrespondencePair (hψ : w.Psi) :
    FiniteCorrespondencePair (↥w.abField) K :=
  (w.xyCorrespondencePair hψ).comp (w.yzCorrespondencePair hψ) rfl

/-- The output family member parametrized by `C`, presented by its actual
generic pair `(X,Z)`. -/
