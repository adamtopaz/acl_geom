import AclGeom.Config.Psi
import AclGeom.Correspondence.RankTwoMultiplication
import AclGeom.Correspondence.FamilyGroupoid
import AclGeom.Correspondence.PartialQuadrangle

/-!
# The selected-component core of the Ψ composition identity

Blueprint equation (8.6) composes the finite correspondence from `Y` to
`X`, parametrized by `A`, with the correspondence from `Y` to `Z`,
parametrized by `B`.  Its first indispensable input is that
`(A₁,A₂,B₁,B₂,Y,X,Z)` is the selected generic point of a rank-five fiber
product.

This module derives that statement directly from the clauses of `Psi`:

* the reverse finite-rank bridge turns `rank_AB` into algebraic
  independence of the four chosen representatives of `A` and `B`;
* `Y_notLe` makes `Y` generic over those four parameters;
* `X_le` and the first projection of `Z_le` make `X` and `Z` algebraic over
  the five generators;
* the second projection of `Z_le` presents `(X,Z)` as the family member
  parametrized by `C`;
* after adjoining all six parameters, the literal pair `(X,Z)` selects a
  common prime component over both the composite `A,B` branch and the
  `C`-parametrized branch.

Together, the rank-five calculation and common-cover prime-ideal theorem are
the selected-component assertion in blueprint (8.6).  Finite base change is
handled honestly: extended ideals are only contained in the selected prime,
since other branches may split off.

**Status:** complete selected-component input for M4a / blueprint (8.6);
global parameter-family and group-chunk assembly remains in progress.
-/

namespace AclGeom

open IntermediateField
open CategoryTheory

noncomputable section

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

namespace QWitness

variable (w : QWitness k K)

/-- Elementwise algebraicity of one point representative over two others
is the corresponding lattice incidence. -/
theorem point_le_sup_of_rep_mem_racl_pair
    (P Q R : Point k K)
    (h : P.rep ∈ racl k ({Q.rep, R.rep} : Set K)) :
    P.1 ≤ Q.1 ⊔ R.1 := by
  rw [← P.point_rep]
  apply ClosedIF.point_le_iff.2
  rw [← Q.point_rep, ← R.point_rep]
  change P.rep ∈
    ((ClosedIF.point k Q.rep ⊔ ClosedIF.point k R.rep).1 :
      IntermediateField k K)
  rw [coe_sup_point₂]
  exact h

/-- The four representatives of the two rank-two parameter fields `A` and
`B`, in the order used by the fiber-product count. -/
def abReps : Fin 4 → K :=
  ![w.A₁.rep, w.A₂.rep, w.B₁.rep, w.B₂.rep]

/-- The two representatives of the `A` parameter. -/
def aReps : Fin 2 → K := ![w.A₁.rep, w.A₂.rep]

/-- The two representatives of the `B` parameter. -/
def bReps : Fin 2 → K := ![w.B₁.rep, w.B₂.rep]

/-- The join `A` is generated by `aReps`. -/
theorem a_eq_iSup_point :
    w.A = ⨆ i, ClosedIF.point k (w.aReps i) := by
  rw [A, ← w.A₁.point_rep, ← w.A₂.point_rep,
    sup_eq_iSup_two]
  congr
  funext i
  fin_cases i <;> rfl

/-- The join `B` is generated by `bReps`. -/
theorem b_eq_iSup_point :
    w.B = ⨆ i, ClosedIF.point k (w.bReps i) := by
  rw [B, ← w.B₁.point_rep, ← w.B₂.point_rep,
    sup_eq_iSup_two]
  congr
  funext i
  fin_cases i <;> rfl

/-- The join `A ∨ B` is generated by the four chosen representatives. -/
theorem ab_join_eq_iSup_point :
    w.A ⊔ w.B = ⨆ i, ClosedIF.point k (w.abReps i) := by
  apply le_antisymm
  · refine sup_le (sup_le ?_ ?_) (sup_le ?_ ?_)
    · exact le_iSup_of_le 0 (by simp [abReps])
    · exact le_iSup_of_le 1 (by simp [abReps])
    · exact le_iSup_of_le 2 (by simp [abReps])
    · exact le_iSup_of_le 3 (by simp [abReps])
  · refine iSup_le fun i ↦ ?_
    fin_cases i
    · simpa [abReps, A, B] using
        (le_sup_left.trans le_sup_left :
          w.A₁.1 ≤ (w.A₁.1 ⊔ w.A₂.1) ⊔ (w.B₁.1 ⊔ w.B₂.1))
    · simpa [abReps, A, B] using
        (le_sup_right.trans le_sup_left :
          w.A₂.1 ≤ (w.A₁.1 ⊔ w.A₂.1) ⊔ (w.B₁.1 ⊔ w.B₂.1))
    · simpa [abReps, A, B] using
        (le_sup_left.trans le_sup_right :
          w.B₁.1 ≤ (w.A₁.1 ⊔ w.A₂.1) ⊔ (w.B₁.1 ⊔ w.B₂.1))
    · simpa [abReps, A, B] using
        (le_sup_right.trans le_sup_right :
          w.B₂.1 ≤ (w.A₁.1 ⊔ w.A₂.1) ⊔ (w.B₁.1 ⊔ w.B₂.1))

/-- Clause `rank_AB` forces the displayed representatives of `A` and `B`
to be algebraically independent. -/
theorem abReps_independent (hψ : w.Psi) :
    AlgebraicIndependent k w.abReps := by
  apply algebraicIndependent_of_rankEq_iSup_point
  rw [← w.ab_join_eq_iSup_point]
  exact hψ.rank_AB

/-- The `A` parameter has rank two. -/
theorem aReps_independent (hψ : w.Psi) :
    AlgebraicIndependent k w.aReps := by
  have h := AlgebraicIndependent.comp_pair
    (w.abReps_independent hψ) (i := (0 : Fin 4)) (j := (1 : Fin 4))
    (by decide)
  simpa [abReps, aReps] using h

/-- The `B` parameter has rank two. -/
theorem bReps_independent (hψ : w.Psi) :
    AlgebraicIndependent k w.bReps := by
  have h := AlgebraicIndependent.comp_pair
    (w.abReps_independent hψ) (i := (2 : Fin 4)) (j := (3 : Fin 4))
    (by decide)
  simpa [abReps, bReps] using h

/-- The four representatives of `A` and `C`. -/
def acReps : Fin 4 → K :=
  ![w.A₁.rep, w.A₂.rep, w.C₁.rep, w.C₂.rep]

/-- The four representatives of `B` and `C`. -/
def bcReps : Fin 4 → K :=
  ![w.B₁.rep, w.B₂.rep, w.C₁.rep, w.C₂.rep]

/-- The join `A ∨ C` is generated by `acReps`. -/
theorem ac_join_eq_iSup_point :
    w.A ⊔ w.C = ⨆ i, ClosedIF.point k (w.acReps i) := by
  apply le_antisymm
  · refine sup_le (sup_le ?_ ?_) (sup_le ?_ ?_)
    · exact le_iSup_of_le 0 (by simp [acReps])
    · exact le_iSup_of_le 1 (by simp [acReps])
    · exact le_iSup_of_le 2 (by simp [acReps])
    · exact le_iSup_of_le 3 (by simp [acReps])
  · refine iSup_le fun i ↦ ?_
    fin_cases i
    · simpa [acReps, A, C] using
        (le_sup_left.trans le_sup_left :
          w.A₁.1 ≤ (w.A₁.1 ⊔ w.A₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))
    · simpa [acReps, A, C] using
        (le_sup_right.trans le_sup_left :
          w.A₂.1 ≤ (w.A₁.1 ⊔ w.A₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))
    · simpa [acReps, A, C] using
        (le_sup_left.trans le_sup_right :
          w.C₁.1 ≤ (w.A₁.1 ⊔ w.A₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))
    · simpa [acReps, A, C] using
        (le_sup_right.trans le_sup_right :
          w.C₂.1 ≤ (w.A₁.1 ⊔ w.A₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))

/-- Clause `rank_AC` makes the displayed `A,C` representatives
independent. -/
theorem acReps_independent (hψ : w.Psi) :
    AlgebraicIndependent k w.acReps := by
  apply algebraicIndependent_of_rankEq_iSup_point
  rw [← w.ac_join_eq_iSup_point]
  exact hψ.rank_AC

/-- The join `B ∨ C` is generated by `bcReps`. -/
theorem bc_join_eq_iSup_point :
    w.B ⊔ w.C = ⨆ i, ClosedIF.point k (w.bcReps i) := by
  apply le_antisymm
  · refine sup_le (sup_le ?_ ?_) (sup_le ?_ ?_)
    · exact le_iSup_of_le 0 (by simp [bcReps])
    · exact le_iSup_of_le 1 (by simp [bcReps])
    · exact le_iSup_of_le 2 (by simp [bcReps])
    · exact le_iSup_of_le 3 (by simp [bcReps])
  · refine iSup_le fun i ↦ ?_
    fin_cases i
    · simpa [bcReps, B, C] using
        (le_sup_left.trans le_sup_left :
          w.B₁.1 ≤ (w.B₁.1 ⊔ w.B₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))
    · simpa [bcReps, B, C] using
        (le_sup_right.trans le_sup_left :
          w.B₂.1 ≤ (w.B₁.1 ⊔ w.B₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))
    · simpa [bcReps, B, C] using
        (le_sup_left.trans le_sup_right :
          w.C₁.1 ≤ (w.B₁.1 ⊔ w.B₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))
    · simpa [bcReps, B, C] using
        (le_sup_right.trans le_sup_right :
          w.C₂.1 ≤ (w.B₁.1 ⊔ w.B₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))

/-- Clause `rank_BC` makes the displayed `B,C` representatives
independent. -/
theorem bcReps_independent (hψ : w.Psi) :
    AlgebraicIndependent k w.bcReps := by
  apply algebraicIndependent_of_rankEq_iSup_point
  rw [← w.bc_join_eq_iSup_point]
  exact hψ.rank_BC

/-- The two representatives of the output parameter `C`. -/
def cReps : Fin 2 → K := ![w.C₁.rep, w.C₂.rep]

/-- The join `C` is generated by `cReps`. -/
theorem c_eq_iSup_point :
    w.C = ⨆ i, ClosedIF.point k (w.cReps i) := by
  apply le_antisymm
  · refine sup_le ?_ ?_
    · exact le_iSup_of_le 0 (by simp [cReps])
    · exact le_iSup_of_le 1 (by simp [cReps])
  · refine iSup_le fun i ↦ ?_
    fin_cases i <;> simp [cReps, C]

/-- The `C` parameter has rank two. -/
theorem cReps_independent (hψ : w.Psi) :
    AlgebraicIndependent k w.cReps := by
  have h := AlgebraicIndependent.comp_pair
    (w.acReps_independent hψ) (i := (2 : Fin 4)) (j := (3 : Fin 4))
    (by decide)
  simpa [acReps, cReps] using h

/-- The six displayed representatives of `A,B,C`. -/
def abcReps : Fin 6 → K :=
  ![w.A₁.rep, w.A₂.rep, w.B₁.rep, w.B₂.rep,
    w.C₁.rep, w.C₂.rep]

/-- Concatenate rank-two parameters in the `A,B,C` order used by equation
(8.6). -/
def compositionParameterTuple
    (a b c : Fin 2 → K) : Fin 6 → K :=
  ![a 0, a 1, b 0, b 1, c 0, c 1]

/-- The rank-two parameter composition locus selected by the actual
`(A,B,C)` tuple of a `Psi` witness.  Its orientation is `A ≫ B = C`,
matching the literal `X → Y → Z` correspondence chain. -/
def psiFamilyCompositionRelation
    (a b c : Fin 2 → K) : Prop :=
  idealOf k (compositionParameterTuple a b c) = idealOf k w.abcReps

/-- The displayed `(A,B,C)` parameters lie on their selected composition
locus. -/
theorem psiFamilyCompositionRelation_selected :
    w.psiFamilyCompositionRelation w.aReps w.bReps w.cReps := by
  change idealOf k w.abcReps = idealOf k w.abcReps
  rfl

/-- The genuine three-object groupoid presented by the rank-two
`A/B/C` family composition locus. -/
abbrev psiParameterFamilyGroupoid :=
  PresentedFamilyGroupoidOf w.psiFamilyCompositionRelation

/-- The rank-two `A`-family arrow, oriented `X → Y`. -/
def psiAArrow (a : Fin 2 → K) :
    PresentedFamilyGroupoidOf.x0 w.psiFamilyCompositionRelation ⟶
      PresentedFamilyGroupoidOf.x1 w.psiFamilyCompositionRelation :=
  PresentedFamilyGroupoidOf.t w.psiFamilyCompositionRelation a

/-- The rank-two `B`-family arrow, oriented `Y → Z`. -/
def psiBArrow (b : Fin 2 → K) :
    PresentedFamilyGroupoidOf.x1 w.psiFamilyCompositionRelation ⟶
      PresentedFamilyGroupoidOf.x2 w.psiFamilyCompositionRelation :=
  PresentedFamilyGroupoidOf.s w.psiFamilyCompositionRelation b

/-- The rank-two output `C`-family arrow, oriented `X → Z`. -/
def psiCArrow (c : Fin 2 → K) :
    PresentedFamilyGroupoidOf.x0 w.psiFamilyCompositionRelation ⟶
      PresentedFamilyGroupoidOf.x2 w.psiFamilyCompositionRelation :=
  PresentedFamilyGroupoidOf.u w.psiFamilyCompositionRelation c

/-- Every selected rank-two parameter triple gives the literal
`A`-then-`B` composition in the presented family groupoid. -/
theorem psiA_comp_psiB_eq_psiC {a b c : Fin 2 → K}
    (h : w.psiFamilyCompositionRelation a b c) :
    w.psiAArrow a ≫ w.psiBArrow b = w.psiCArrow c :=
  PresentedFamilyGroupoidOf.t_comp_s_eq_u
    w.psiFamilyCompositionRelation h

/-- The total parameter join is generated by `abcReps`. -/
theorem abc_join_eq_iSup_point :
    w.A ⊔ w.B ⊔ w.C = ⨆ i, ClosedIF.point k (w.abcReps i) := by
  apply le_antisymm
  · refine sup_le (sup_le (sup_le ?_ ?_) (sup_le ?_ ?_))
      (sup_le ?_ ?_)
    · exact le_iSup_of_le 0 (by simp [abcReps])
    · exact le_iSup_of_le 1 (by simp [abcReps])
    · exact le_iSup_of_le 2 (by simp [abcReps])
    · exact le_iSup_of_le 3 (by simp [abcReps])
    · exact le_iSup_of_le 4 (by simp [abcReps])
    · exact le_iSup_of_le 5 (by simp [abcReps])
  · refine iSup_le fun i ↦ ?_
    fin_cases i
    · simpa [abcReps, A, B, C] using
        (le_sup_left.trans le_sup_left |>.trans le_sup_left :
          w.A₁.1 ≤ w.A₁.1 ⊔ w.A₂.1 ⊔
            (w.B₁.1 ⊔ w.B₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))
    · simpa [abcReps, A, B, C] using
        (le_sup_right.trans le_sup_left |>.trans le_sup_left :
          w.A₂.1 ≤ w.A₁.1 ⊔ w.A₂.1 ⊔
            (w.B₁.1 ⊔ w.B₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))
    · simpa [abcReps, A, B, C] using
        (le_sup_left.trans le_sup_right |>.trans le_sup_left :
          w.B₁.1 ≤ w.A₁.1 ⊔ w.A₂.1 ⊔
            (w.B₁.1 ⊔ w.B₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))
    · simpa [abcReps, A, B, C] using
        (le_sup_right.trans le_sup_right |>.trans le_sup_left :
          w.B₂.1 ≤ w.A₁.1 ⊔ w.A₂.1 ⊔
            (w.B₁.1 ⊔ w.B₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))
    · simpa [abcReps, A, B, C] using
        (le_sup_left.trans le_sup_right :
          w.C₁.1 ≤ w.A₁.1 ⊔ w.A₂.1 ⊔
            (w.B₁.1 ⊔ w.B₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))
    · simpa [abcReps, A, B, C] using
        (le_sup_right.trans le_sup_right :
          w.C₂.1 ≤ w.A₁.1 ⊔ w.A₂.1 ⊔
            (w.B₁.1 ⊔ w.B₂.1) ⊔ (w.C₁.1 ⊔ w.C₂.1))

/-- The rank-four `A,B` flat already contains `C`. -/
theorem ab_eq_abc (hψ : w.Psi) :
    w.A ⊔ w.B = w.A ⊔ w.B ⊔ w.C :=
  RankEq.eq_of_le le_sup_left hψ.rank_AB hψ.rank_ABC

/-- The rank-four `A,C` flat already contains `B`. -/
theorem ac_eq_abc (hψ : w.Psi) :
    w.A ⊔ w.C = w.A ⊔ w.B ⊔ w.C :=
  RankEq.eq_of_le
    (sup_le (le_sup_left.trans le_sup_left) le_sup_right)
    hψ.rank_AC hψ.rank_ABC

/-- The rank-four `B,C` flat already contains `A`. -/
theorem bc_eq_abc (hψ : w.Psi) :
    w.B ⊔ w.C = w.A ⊔ w.B ⊔ w.C :=
  RankEq.eq_of_le
    (sup_le (le_sup_right.trans le_sup_left) le_sup_right)
    hψ.rank_BC hψ.rank_ABC

/-- Every output-parameter coordinate is algebraic over the two input
parameter tuples. -/
theorem cReps_mem_racl_abReps (hψ : w.Psi) (i : Fin 2) :
    w.cReps i ∈ racl k (Set.range w.abReps) := by
  have hp : ClosedIF.point k (w.cReps i) ≤ w.C := by
    rw [w.c_eq_iSup_point]
    exact le_iSup (fun j ↦ ClosedIF.point k (w.cReps j)) i
  have hC : w.C ≤ w.A ⊔ w.B := by
    rw [w.ab_eq_abc hψ]
    exact le_sup_right
  rw [w.ab_join_eq_iSup_point] at hC
  exact mem_iSup_point_iff.1
    ((hp.trans hC) (ClosedIF.mem_point_self (w.cReps i)))

/-- Every right-input coordinate is algebraic over the left input and
output parameter tuples. -/
theorem bReps_mem_racl_acReps (hψ : w.Psi) (i : Fin 2) :
    w.bReps i ∈ racl k (Set.range w.acReps) := by
  have hp : ClosedIF.point k (w.bReps i) ≤ w.B := by
    rw [w.b_eq_iSup_point]
    exact le_iSup (fun j ↦ ClosedIF.point k (w.bReps j)) i
  have hB : w.B ≤ w.A ⊔ w.C := by
    rw [w.ac_eq_abc hψ]
    exact le_sup_right.trans le_sup_left
  rw [w.ac_join_eq_iSup_point] at hB
  exact mem_iSup_point_iff.1
    ((hp.trans hB) (ClosedIF.mem_point_self (w.bReps i)))

/-- Every left-input coordinate is algebraic over the right input and
output parameter tuples. -/
theorem aReps_mem_racl_bcReps (hψ : w.Psi) (i : Fin 2) :
    w.aReps i ∈ racl k (Set.range w.bcReps) := by
  have hp : ClosedIF.point k (w.aReps i) ≤ w.A := by
    rw [w.a_eq_iSup_point]
    exact le_iSup (fun j ↦ ClosedIF.point k (w.aReps j)) i
  have hA : w.A ≤ w.B ⊔ w.C := by
    rw [w.bc_eq_abc hψ]
    exact le_sup_left.trans le_sup_left
  rw [w.bc_join_eq_iSup_point] at hA
  exact mem_iSup_point_iff.1
    ((hp.trans hA) (ClosedIF.mem_point_self (w.aReps i)))

/-- The `Psi` parameter locus, packaged as a generically finite
rank-two multiplication correspondence. -/
def psiParameterMultiplication (hψ : w.Psi) :
    RankTwoFiniteCorrespondenceMultiplication (k := k) (Ω := K) where
  left := w.aReps
  right := w.bReps
  output := w.cReps
  leftRight_independent := by
    simpa [rankTwoPairTuple, aReps, bReps, abReps] using
      w.abReps_independent hψ
  leftOutput_independent := by
    simpa [rankTwoPairTuple, aReps, cReps, acReps] using
      w.acReps_independent hψ
  rightOutput_independent := by
    simpa [rankTwoPairTuple, bReps, cReps, bcReps] using
      w.bcReps_independent hψ
  output_mem_left_right := by
    intro i
    simpa [rankTwoPairTuple, aReps, bReps, abReps] using
      w.cReps_mem_racl_abReps hψ i
  right_mem_left_output := by
    intro i
    simpa [rankTwoPairTuple, aReps, cReps, acReps] using
      w.bReps_mem_racl_acReps hψ i
  left_mem_right_output := by
    intro i
    simpa [rankTwoPairTuple, bReps, cReps, bcReps] using
      w.aReps_mem_racl_bcReps hψ i

/-- The generic ideal of the packaged multiplication correspondence is
the selected six-parameter `Psi` ideal. -/
@[simp] theorem psiParameterMultiplication_ideal (hψ : w.Psi) :
    (w.psiParameterMultiplication hψ).ideal = idealOf k w.abcReps := by
  rfl

/-- The configuration-specific composition relation is exactly
realization of the packaged rank-two multiplication locus. -/
theorem psiFamilyCompositionRelation_iff_isRealization
    (hψ : w.Psi) (a b c : Fin 2 → K) :
    w.psiFamilyCompositionRelation a b c ↔
      (w.psiParameterMultiplication hψ).IsRealization a b c := by
  rw [psiFamilyCompositionRelation,
    RankTwoFiniteCorrespondenceMultiplication.IsRealization,
    w.psiParameterMultiplication_ideal hψ]
  rfl

/-- Every independent generic pair of rank-two input parameters has an
output on the selected `Psi` composition locus. -/
theorem exists_psiParameter_output [IsAlgClosed K] (hψ : w.Psi)
    {a b : Fin 2 → K}
    (hab : AlgebraicIndependent k (rankTwoPairTuple a b)) :
    ∃ c : Fin 2 → K, w.psiFamilyCompositionRelation a b c := by
  obtain ⟨c, hc⟩ := (w.psiParameterMultiplication hψ).exists_output hab
  exact ⟨c, (w.psiFamilyCompositionRelation_iff_isRealization hψ a b c).2 hc⟩

/-- Every independent generic left-input/output pair admits a right
division solution on the selected `Psi` locus. -/
theorem exists_psiParameter_right [IsAlgClosed K] (hψ : w.Psi)
    {a c : Fin 2 → K}
    (hac : AlgebraicIndependent k (rankTwoPairTuple a c)) :
    ∃ b : Fin 2 → K, w.psiFamilyCompositionRelation a b c := by
  obtain ⟨b, hb⟩ := (w.psiParameterMultiplication hψ).exists_right hac
  exact ⟨b, (w.psiFamilyCompositionRelation_iff_isRealization hψ a b c).2 hb⟩

/-- Every independent generic right-input/output pair admits a left
division solution on the selected `Psi` locus. -/
theorem exists_psiParameter_left [IsAlgClosed K] (hψ : w.Psi)
    {b c : Fin 2 → K}
    (hbc : AlgebraicIndependent k (rankTwoPairTuple b c)) :
    ∃ a : Fin 2 → K, w.psiFamilyCompositionRelation a b c := by
  obtain ⟨a, ha⟩ := (w.psiParameterMultiplication hψ).exists_left hbc
  exact ⟨a, (w.psiFamilyCompositionRelation_iff_isRealization hψ a b c).2 ha⟩

/-- The `A` representatives occur among `abReps`. -/
theorem aReps_range_subset_abReps :
    Set.range w.aReps ⊆ Set.range w.abReps := by
  rintro _ ⟨i, rfl⟩
  fin_cases i <;> simp [aReps, abReps]

/-- The `B` representatives occur among `abReps`. -/
theorem bReps_range_subset_abReps :
    Set.range w.bReps ⊆ Set.range w.abReps := by
  rintro _ ⟨i, rfl⟩
  fin_cases i <;> simp [bReps, abReps]

