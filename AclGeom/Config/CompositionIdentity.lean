/-- Clause `Y_notLe` says that `Y` is generic over the four `A,B`
parameters. -/
theorem Y_rep_notMem_racl_abReps (hψ : w.Psi) :
    w.Y.rep ∉ racl k (Set.range w.abReps) := by
  intro hY
  apply hψ.Y_notLe
  have hpoint : w.Y.1 ≤ ⨆ i, ClosedIF.point k (w.abReps i) := by
    rw [← w.Y.point_rep]
    exact ClosedIF.point_le_iff.2
      (mem_iSup_point_iff.2 hY)
  rw [← w.ab_join_eq_iSup_point] at hpoint
  exact hpoint.trans le_sup_left

