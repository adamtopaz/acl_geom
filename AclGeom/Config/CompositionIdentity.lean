      w.Y_rep_mem_racl_abReps_snoc_X hψ
  source_mem_target := by
    rw [abField, mem_racl_adjoin_base_iff, Set.union_singleton]
    simpa only [Fin.range_snoc] using
      w.X_rep_mem_racl_abReps_snoc_Y hψ

