private theorem commonCoefficientOverAlternative_finiteDimensional
    (T : Fin 8 → CommonCurveAmbient K)
    (F : IntermediateField k (CommonCurveAmbient K))
    (hF : F = adjoin k (Set.range T))
    (hclose : racl k (Set.range R.commonInputTuple) =
      racl k (Set.range T))
    (hFE : F ≤ R.commonCoefficientExtendedField) :
    FiniteDimensional (↥F) (↥(extendScalars hFE)) := by
  let S : Set (CommonCurveAmbient K) :=
    Set.range R.commonInputTuple ∪
      Set.range R.algebraicCoefficientTuple
  have key : extendScalars hFE =
      adjoin (↥F) S := by
    refine restrictScalars_injective k ?_
    rw [extendScalars_restrictScalars, restrictScalars_adjoin_eq_sup]
    change R.commonCoefficientExtendedField =
      F ⊔ R.commonCoefficientExtendedField
    exact (sup_eq_right.2 hFE).symm
  rw [key]
  letI : Fintype S :=
    Set.Finite.fintype
      ((Set.finite_range R.commonInputTuple).union
        (Set.finite_range R.algebraicCoefficientTuple))
  exact finiteDimensional_adjoin fun z hz ↦ by
    change z ∈ Set.range R.commonInputTuple ∪
      Set.range R.algebraicCoefficientTuple at hz
    have hzCommon : z ∈ racl k (Set.range R.commonInputTuple) := by
      rcases hz with hz | hz
      · exact subset_racl k _ hz
      · obtain ⟨i, rfl⟩ := hz
        exact R.algebraicCoefficientTuple_mem_commonInput_racl i
    rw [hclose] at hzCommon
    have hzAlg : IsAlgebraic (adjoin k (Set.range T)) z :=
      (mem_racl_iff k).1 hzCommon
    rw [← hF] at hzAlg
    exact hzAlg.isIntegral

/-- The common coefficient enlargement is finite over the alternative
`sA` input field, not only over the original inputs. -/
theorem commonCoefficientOverRepeatedSA_finiteDimensional :
    FiniteDimensional (↥R.repeatedSAAlternativeInputField)
      (↥R.commonCoefficientOverRepeatedSA) :=
  R.commonCoefficientOverAlternative_finiteDimensional
    R.repeatedSAInputTuple R.repeatedSAAlternativeInputField
    R.repeatedSAAlternativeInputField_eq_adjoin
    R.commonInput_racl_eq_repeatedSAInput
    R.repeatedSAAlternativeInputField_le_extended

