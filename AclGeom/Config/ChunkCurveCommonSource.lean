    commonCurveEmbedding (k := k) (K := K) (e i) ∈ racl k
      (Set.range R.commonInputTuple) := by
  apply R.map_mem_input_racl
  fin_cases i
  · exact subset_racl k _ ⟨2, rfl⟩
  · exact subset_racl k _ ⟨3, rfl⟩

