        (R := R.se) R.seCommonBaseData hψ).sourceField :
          Set (CommonCurveAmbient K)) := by
  change ((adjoin (↥R.sAaCommonBaseData.coefficientField)
      {R.sAaCommonBaseData.source}) : Set (CommonCurveAmbient K)) =
