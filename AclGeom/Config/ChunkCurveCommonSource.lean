alternative `sA` input field. -/
def commonCoefficientOverRepeatedSA :
    IntermediateField (↥R.repeatedSAAlternativeInputField)
      (CommonCurveAmbient K) :=
  extendScalars R.repeatedSAAlternativeInputField_le_extended

