private theorem commonCoefficientOverAlternative_finiteDimensional
    (T : Fin 8 → CommonCurveAmbient K)
    (F : IntermediateField k (CommonCurveAmbient K))
    (hF : F = adjoin k (Set.range T))
    (hclose : racl k (Set.range R.commonInputTuple) =
      racl k (Set.range T))
    (hFE : F ≤ R.commonCoefficientExtendedField) :
    FiniteDimensional (↥F) (↥(extendScalars hFE)) := by
  let S : Set (CommonCurveAmbient K) :=
    Set.range R.commonInputTuple ∪
      Set.range R.algebraicCoefficientTuple
  have key : extendScalars hFE =
      adjoin (↥F) S := by
    refine restrictScalars_injective k ?_
    rw [extendScalars_restrictScalars, restrictScalars_adjoin_eq_sup]
    change R.commonCoefficientExtendedField =
      F ⊔ R.commonCoefficientExtendedField
    exact (sup_eq_right.2 hFE).symm
  rw [key]
  letI : Fintype S :=
    Set.Finite.fintype
      ((Set.finite_range R.commonInputTuple).union
        (Set.finite_range R.algebraicCoefficientTuple))
  exact finiteDimensional_adjoin fun z hz ↦ by
    change z ∈ Set.range R.commonInputTuple ∪
      Set.range R.algebraicCoefficientTuple at hz
    have hzCommon : z ∈ racl k (Set.range R.commonInputTuple) := by
      rcases hz with hz | hz
      · exact subset_racl k _ hz
      · obtain ⟨i, rfl⟩ := hz
        exact R.algebraicCoefficientTuple_mem_commonInput_racl i
    rw [hclose] at hzCommon
    have hzAlg : IsAlgebraic (adjoin k (Set.range T)) z :=
      (mem_racl_iff k).1 hzCommon
    rw [← hF] at hzAlg
    exact hzAlg.isIntegral

/-- The common coefficient enlargement is finite over the alternative
`sA` input field, not only over the original inputs. -/
theorem commonCoefficientOverRepeatedSA_finiteDimensional :
    FiniteDimensional (↥R.repeatedSAAlternativeInputField)
      (↥R.commonCoefficientOverRepeatedSA) :=
  R.commonCoefficientOverAlternative_finiteDimensional
    R.repeatedSAInputTuple R.repeatedSAAlternativeInputField
    R.repeatedSAAlternativeInputField_eq_adjoin
    R.commonInput_racl_eq_repeatedSAInput
    R.repeatedSAAlternativeInputField_le_extended

/-- The common coefficient enlargement is finite over the alternative
direct-`u` input field. -/
theorem commonCoefficientOverRepeatedU_finiteDimensional :
    FiniteDimensional (↥R.repeatedUAlternativeInputField)
      (↥R.commonCoefficientOverRepeatedU) :=
  R.commonCoefficientOverAlternative_finiteDimensional
    R.repeatedUInputTuple R.repeatedUAlternativeInputField
    R.repeatedUAlternativeInputField_eq_adjoin
    R.commonInput_racl_eq_repeatedUInput
    R.repeatedUAlternativeInputField_le_extended

/-- The common coefficient enlargement is finite over the alternative
direct-`uB` input field. -/
theorem commonCoefficientOverRepeatedUB_finiteDimensional :
    FiniteDimensional (↥R.repeatedUBAlternativeInputField)
      (↥R.commonCoefficientOverRepeatedUB) :=
  R.commonCoefficientOverAlternative_finiteDimensional
    R.repeatedUBInputTuple R.repeatedUBAlternativeInputField
    R.repeatedUBAlternativeInputField_eq_adjoin
    R.commonInput_racl_eq_repeatedUBInput
    R.repeatedUBAlternativeInputField_le_extended

/-- The common coefficient enlargement is finite over the original
eight-input field. -/
theorem commonCoefficientOverInput_finiteDimensional :
    FiniteDimensional (↥R.seCommonBaseData.coefficientField)
      (↥R.commonCoefficientOverInput) := by
  have key : R.commonCoefficientOverInput =
      adjoin (↥R.seCommonBaseData.coefficientField)
        (Set.range R.algebraicCoefficientTuple) := by
    refine restrictScalars_injective k ?_
    unfold commonCoefficientOverInput
    rw [extendScalars_restrictScalars]
    unfold commonCoefficientExtendedField
      PsiCurveCompositionBaseChangeRealization.CommonBaseData.coefficientField
    rw [adjoin_adjoin_left, adjoin_union]
  rw [key]
  letI : Fintype (Set.range R.algebraicCoefficientTuple) :=
    Set.Finite.fintype (Set.finite_range R.algebraicCoefficientTuple)
  exact finiteDimensional_adjoin fun z hz ↦ by
    obtain ⟨i, rfl⟩ := hz
    have hmem : R.algebraicCoefficientTuple i ∈
        racl (↥R.seCommonBaseData.coefficientField)
          (∅ : Set (CommonCurveAmbient K)) := by
      rw [PsiCurveCompositionBaseChangeRealization.CommonBaseData.coefficientField,
        mem_racl_adjoin_base_iff, Set.union_empty]
      exact R.algebraicCoefficientTuple_mem_commonInput_racl i
    exact (isAlgebraic_of_mem_racl_empty hmem).isIntegral

/-- One normal coefficient field containing the original common inputs and
all three algebraic replacement blocks. -/
def commonCoefficientNormalField :
    IntermediateField (↥R.seCommonBaseData.coefficientField)
      (CommonCurveAmbient K) :=
  FiniteCover.normalClosureOver R.commonCoefficientField_le_extended

/-- The finite coefficient enlargement lies in its normal closure. -/
theorem commonCoefficientOverInput_le_normalField :
    R.commonCoefficientOverInput ≤ R.commonCoefficientNormalField :=
  FiniteCover.extendScalars_le_normalClosureOver
    R.commonCoefficientField_le_extended

/-- The common coefficient normal field remains finite over the original
eight-input field. -/
theorem commonCoefficientNormalField_finiteDimensional :
    FiniteDimensional (↥R.seCommonBaseData.coefficientField)
      (↥R.commonCoefficientNormalField) :=
  FiniteCover.normalClosureOver_finiteDimensional
    R.commonCoefficientField_le_extended
    R.commonCoefficientOverInput_finiteDimensional

/-- The common coefficient normal field is normal over the original
eight-input field. -/
theorem commonCoefficientNormalField_normal :
    Normal (↥R.seCommonBaseData.coefficientField)
      (↥R.commonCoefficientNormalField) := by
  letI : FiniteDimensional (↥R.seCommonBaseData.coefficientField)
      (↥(extendScalars R.commonCoefficientField_le_extended)) :=
    R.commonCoefficientOverInput_finiteDimensional
  exact FiniteCover.normalClosureOver_normal
    R.commonCoefficientField_le_extended
    (Algebra.IsAlgebraic.of_finite _ _)

/-- The full finite coefficient enlargement embeds in the underlying
`k`-field of its normal closure. -/
theorem commonCoefficientExtendedField_le_normalField :
    R.commonCoefficientExtendedField ≤
      R.commonCoefficientNormalField.restrictScalars k := by
  have h : R.commonCoefficientOverInput.restrictScalars k ≤
      R.commonCoefficientNormalField.restrictScalars k :=
    R.commonCoefficientOverInput_le_normalField
  simpa [commonCoefficientOverInput] using h

/-- The original common eight-input field lies in the underlying ground
field of its coefficient normalization. -/
theorem commonCoefficientField_le_normalField :
    R.seCommonBaseData.coefficientField ≤
      R.commonCoefficientNormalField.restrictScalars k := by
  intro z hz
  change z ∈ R.commonCoefficientNormalField
  exact R.commonCoefficientNormalField.algebraMap_mem ⟨z, hz⟩

/-- The common coefficient normal field, regarded as an extension of the
finite coefficient enlargement that it contains. -/
def commonCoefficientNormalOverExtended :
    IntermediateField (↥R.commonCoefficientExtendedField)
      (CommonCurveAmbient K) :=
  extendScalars R.commonCoefficientExtendedField_le_normalField

/-- The common coefficient normal field remains finite after enlarging
the base from the original inputs to the full coefficient enlargement. -/
theorem commonCoefficientNormalOverExtended_finiteDimensional :
    FiniteDimensional (↥R.commonCoefficientExtendedField)
      (↥R.commonCoefficientNormalOverExtended) := by
  let E₀ := R.seCommonBaseData.coefficientField
  let C := R.commonCoefficientNormalField.restrictScalars k
  letI : Algebra (↥E₀) (↥R.commonCoefficientExtendedField) :=
    (inclusion R.commonCoefficientField_le_extended).toAlgebra
  letI : Algebra (↥R.commonCoefficientExtendedField) (↥C) :=
    (inclusion R.commonCoefficientExtendedField_le_normalField).toAlgebra
  letI : Algebra (↥E₀) (↥C) :=
    (inclusion (R.commonCoefficientField_le_extended.trans
      R.commonCoefficientExtendedField_le_normalField)).toAlgebra
  letI : IsScalarTower (↥E₀) (↥R.commonCoefficientExtendedField) (↥C) :=
    IsScalarTower.of_algebraMap_eq' rfl
  letI : FiniteDimensional (↥E₀) (↥C) := by
    change FiniteDimensional (↥R.seCommonBaseData.coefficientField)
      (↥R.commonCoefficientNormalField)
    exact R.commonCoefficientNormalField_finiteDimensional
  change FiniteDimensional (↥R.commonCoefficientExtendedField) (↥C)
  exact FiniteDimensional.right (↥E₀)
    (↥R.commonCoefficientExtendedField) (↥C)

/-- The common coefficient normal field viewed over the alternative
`sA` coefficient field. -/
def commonCoefficientNormalOverRepeatedSA :
    IntermediateField (↥R.repeatedSAAlternativeInputField)
      (CommonCurveAmbient K) :=
  extendScalars
    (R.repeatedSAAlternativeInputField_le_extended.trans
      R.commonCoefficientExtendedField_le_normalField)

/-- The common coefficient normal field viewed over the alternative
direct-`u` coefficient field. -/
def commonCoefficientNormalOverRepeatedU :
