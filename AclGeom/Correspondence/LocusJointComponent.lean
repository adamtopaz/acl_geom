import AclGeom.Correspondence.LocusQuotientComponents
import Mathlib.FieldTheory.AlgebraicClosure
import Mathlib.RingTheory.IntegralClosure.Algebra.Basic

/-!
# The joint tuple component of the incidence ring

For tuples `x`, `y`, `z` in a field `Ω` over `k`, evaluation at the joint tuple `(x, y, z)` kills
the incidence ideal `I(x, y) + I(y, z)` of `k[X, Y, Z]` (`locusIncidence_le_idealOf`), so it
factors through the incidence ring of `exists_locusIncidence_algEquiv`. If every coordinate of `z`
is algebraic over the field generated by `y`, one algebraicity clause of (8.1), then the kernel of
this evaluation is a minimal prime of the incidence ring, and its zero locus has dense image in
`Spec (k[Y] ⧸ I(y))` along the map induced by the inclusion of the variables `Y`
(`locusIncidence_jointPrime_dominating`). No condition on `x` is needed.

The kernel is the contraction of the kernel of the multiplication map
`k(x, y) ⊗[k(y)] k(y, z) → Ω` along the map of `exists_locusIncidence_dominatingComponents`. That
kernel is a minimal prime because the tensor product is integral over `k(x, y)` and the kernel
meets `k(x, y)` trivially.

This is the generic-point clause of the geometric fiber-product bridge of blueprint §8.1
(8.4c, 8.6) (#5). The endpoint image, the tuple germ layer with relational associativity and the
higher-dimensional family generic-component argument remain open.

This module is part of the formalization of the Evans–Hrushovski–Gismatullin
reconstruction theorem; the source of truth is `sources/blueprint.tex`.

**Status:** proved (#5, C2 support).
-/

open scoped TensorProduct IntermediateField.algebraAdjoinAdjoin
open MvPolynomial

namespace AclGeom

/-- The kernel of the multiplication map of two field embeddings over a common subfield is a
minimal prime of the tensor product, when the right-hand field is algebraic over the common
subfield. -/
private theorem ker_productMap_mem_minimalPrimes {E F G S : Type*} [Field E] [Field F] [Field G]
    [CommRing S] [IsDomain S] [Algebra E F] [Algebra E G] [Algebra E S] [Algebra.IsAlgebraic E G]
    (f : F →ₐ[E] S) (g : G →ₐ[E] S) :
    RingHom.ker (Algebra.TensorProduct.productMap f g) ∈ minimalPrimes (F ⊗[E] G) := by
  have : (RingHom.ker (Algebra.TensorProduct.productMap f g)).IsPrime := RingHom.ker_isPrime _
  have hunder : (RingHom.ker (Algebra.TensorProduct.productMap f g)).under F = ⊥ := by
    refine eq_bot_iff.2 fun a ha ↦ ?_
    rw [Ideal.mem_bot]
    have ha' : algebraMap F (F ⊗[E] G) a ∈ RingHom.ker (Algebra.TensorProduct.productMap f g) :=
      ha
    have h0 : f a = 0 :=
      (Algebra.TensorProduct.productMap_left_apply f g a).symm.trans (RingHom.mem_ker.1 ha')
    exact (RingHom.injective f.toRingHom) (h0.trans (map_zero f).symm)
  have hmin := Ideal.IsIntegral.mem_minimalPrimes_map_under (R := F)
    (RingHom.ker (Algebra.TensorProduct.productMap f g))
  rw [hunder, Ideal.map_bot] at hmin
  exact hmin

/-- If the multiplication map after a ring map `ψ` is a given map `ev`, and `ψ` classifies the
components of `Spec Q` with dense image under `fY` by contraction of minimal primes, then the kernel
of `ev` is a minimal prime of `Q` whose zero locus has dense image under `fY`. -/
private theorem ker_mem_minimalPrimes_of_productMap_comp {A Q E F G S : Type*} [CommRing A]
    [CommRing Q] [Field E] [Field F] [Field G] [CommRing S] [IsDomain S] [Algebra E F]
    [Algebra E G] [Algebra E S] [Algebra.IsAlgebraic E G] (f : F →ₐ[E] S) (g : G →ₐ[E] S)
    (ψ : Q →+* F ⊗[E] G) (ev : Q →+* S)
    (hcomp : (Algebra.TensorProduct.productMap f g : F ⊗[E] G →+* S).comp ψ = ev) (fY : A →+* Q)
    (hset : {Z | Z ∈ irreducibleComponents (PrimeSpectrum Q) ∧
        closure (PrimeSpectrum.comap fY '' Z) = Set.univ} =
      (fun P : Ideal (F ⊗[E] G) ↦ PrimeSpectrum.zeroLocus (Ideal.comap ψ P : Set Q)) ''
        minimalPrimes (F ⊗[E] G)) :
    RingHom.ker ev ∈ minimalPrimes Q ∧
      closure (PrimeSpectrum.comap fY '' PrimeSpectrum.zeroLocus (RingHom.ker ev : Set Q)) =
        Set.univ := by
  have hker : Ideal.comap ψ (RingHom.ker (Algebra.TensorProduct.productMap f g)) =
      RingHom.ker ev :=
    (RingHom.comap_ker _ ψ).trans (congrArg RingHom.ker hcomp)
  have hmem := (Set.ext_iff.1 hset _).2 ⟨_, ker_productMap_mem_minimalPrimes f g,
    congrArg (fun P : Ideal Q ↦ PrimeSpectrum.zeroLocus (P : Set Q)) hker⟩
  have hprime : (RingHom.ker ev).IsPrime := RingHom.ker_isPrime _
  have hmin := PrimeSpectrum.zeroLocus_ideal_mem_irreducibleComponents.1 hmem.1
  rw [hprime.radical] at hmin
  exact ⟨hmin, hmem.2⟩

variable {k Ω : Type*} [Field k] [Field Ω] [Algebra k Ω] {α β γ : Type*}
  (x : α → Ω) (y : β → Ω) (z : γ → Ω)

local notation "𝔅" => Algebra.adjoin k (Set.range (Sum.elim x y))
local notation "ℭ" => Algebra.adjoin k (Set.range (Sum.elim y z))
local notation "𝔎" => IntermediateField.adjoin k (Set.range y)
local notation "𝔏" => IntermediateField.adjoin k (Set.range (Sum.elim x y))
local notation "𝔐" => IntermediateField.adjoin k (Set.range (Sum.elim y z))
local notation "ℐ" => Ideal.map (rename (Sum.inl : α ⊕ β → (α ⊕ β) ⊕ γ) :
    MvPolynomial (α ⊕ β) k →ₐ[k] MvPolynomial ((α ⊕ β) ⊕ γ) k) (idealOf k (Sum.elim x y)) ⊔
  Ideal.map (rename (Sum.elim (Sum.inl ∘ Sum.inr) Sum.inr : β ⊕ γ → (α ⊕ β) ⊕ γ) :
    MvPolynomial (β ⊕ γ) k →ₐ[k] MvPolynomial ((α ⊕ β) ⊕ γ) k) (idealOf k (Sum.elim y z))

/-- Evaluation at the joint tuple kills the incidence ideal of the loci of `(x, y)` and `(y, z)`. -/
theorem locusIncidence_le_idealOf : ℐ ≤ idealOf k (Sum.elim (Sum.elim x y) z) :=
  sup_le
    (Ideal.map_le_iff_le_comap.2 (idealOf_eq_comap_rename (a := Sum.elim (Sum.elim x y) z)
      (b := Sum.elim x y) (g := Sum.inl) rfl).le)
    (Ideal.map_le_iff_le_comap.2 (idealOf_eq_comap_rename (a := Sum.elim (Sum.elim x y) z)
      (b := Sum.elim y z) (g := Sum.elim (Sum.inl ∘ Sum.inr) Sum.inr)
      (funext fun i ↦ by rcases i with b | c <;> rfl)).le)

local notation "𝔈" => Ideal.Quotient.liftₐ ℐ (aeval (Sum.elim (Sum.elim x y) z))
  (locusIncidence_le_idealOf x y z)

/-- The function field of `(y, z)` is algebraic over that of `y` when every coordinate of `z` is
algebraic over the field generated by `y`. -/
private theorem isAlgebraic_locusField (hzy : ∀ i, z i ∈ racl k (Set.range y)) :
    letI : Algebra 𝔎 𝔐 := (IntermediateField.inclusion (IntermediateField.adjoin.mono k _ _
      (Set.Sum.elim_range y z ▸ Set.subset_union_left))).toRingHom.toAlgebra
    Algebra.IsAlgebraic 𝔎 𝔐 := by
  -- The generator containment is proved before the inclusion structure is declared: elaborated
  -- with that local instance in scope, its instance terms make the kernel check time out.
  have hle : 𝔐 ≤ (algebraicClosure 𝔎 Ω).restrictScalars k := by
    rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    rcases i with j | i
    · exact mem_algebraicClosure_iff.2 (isAlgebraic_algebraMap
        (⟨y j, IntermediateField.subset_adjoin k _ ⟨j, rfl⟩⟩ : 𝔎))
    · exact mem_algebraicClosure_iff.2 ((mem_racl_iff k).1 (hzy i))
  let _ : Algebra 𝔎 𝔐 := (IntermediateField.inclusion (IntermediateField.adjoin.mono k _ _
    (Set.Sum.elim_range y z ▸ Set.subset_union_left))).toRingHom.toAlgebra
  let g : 𝔐 →ₐ[𝔎] Ω := { (IntermediateField.val 𝔐).toRingHom with commutes' := fun _ ↦ rfl }
  exact ⟨fun m ↦ (isAlgebraic_algHom_iff g Subtype.val_injective).1
    (mem_algebraicClosure_iff.1 (hle m.2))⟩

/-- A ring map from the incidence ring to `k(x, y) ⊗[k(y)] k(y, z)` with the polynomial-factor
formula, followed by the multiplication map, is evaluation at the joint tuple. -/
private theorem productMap_comp_eq_eval :
    letI : Algebra 𝔎 𝔏 := (IntermediateField.inclusion (IntermediateField.adjoin.mono k _ _
      (Set.Sum.elim_range x y ▸ Set.subset_union_right))).toRingHom.toAlgebra
    letI : Algebra 𝔎 𝔐 := (IntermediateField.inclusion (IntermediateField.adjoin.mono k _ _
      (Set.Sum.elim_range y z ▸ Set.subset_union_left))).toRingHom.toAlgebra
    ∀ (f : 𝔏 →ₐ[𝔎] Ω) (g : 𝔐 →ₐ[𝔎] Ω), (∀ a, f a = a) → (∀ b, g b = b) →
    ∀ ψ : MvPolynomial ((α ⊕ β) ⊕ γ) k ⧸ ℐ →+* 𝔏 ⊗[𝔎] 𝔐,
      (∀ (p : MvPolynomial (α ⊕ β) k) (q : MvPolynomial (β ⊕ γ) k),
        ψ (Ideal.Quotient.mk ℐ
            (rename Sum.inl p * rename (Sum.elim (Sum.inl ∘ Sum.inr) Sum.inr) q)) =
          algebraMap 𝔅 𝔏 (locusCoordinateRingEquiv (Sum.elim x y) (Ideal.Quotient.mk _ p)) ⊗ₜ
            algebraMap ℭ 𝔐 (locusCoordinateRingEquiv (Sum.elim y z) (Ideal.Quotient.mk _ q))) →
      (Algebra.TensorProduct.productMap f g : 𝔏 ⊗[𝔎] 𝔐 →+* Ω).comp ψ =
        (𝔈 : MvPolynomial ((α ⊕ β) ⊕ γ) k ⧸ ℐ →+* Ω) := by
  let _ : Algebra 𝔎 𝔏 := (IntermediateField.inclusion (IntermediateField.adjoin.mono k _ _
    (Set.Sum.elim_range x y ▸ Set.subset_union_right))).toRingHom.toAlgebra
  let _ : Algebra 𝔎 𝔐 := (IntermediateField.inclusion (IntermediateField.adjoin.mono k _ _
    (Set.Sum.elim_range y z ▸ Set.subset_union_left))).toRingHom.toAlgebra
  intro f g hf hg ψ hψ
  refine Ideal.Quotient.ringHom_ext (MvPolynomial.ringHom_ext (fun r ↦ ?_) (fun i ↦ ?_))
  · have h := hψ (C r) 1
    simp only [map_one, mul_one, rename_C] at h
    change Algebra.TensorProduct.productMap f g (ψ (Ideal.Quotient.mk ℐ (C r))) =
      𝔈 (Ideal.Quotient.mk ℐ (C r))
    rw [h]
    simp only [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one,
      locusCoordinateRingEquiv_mk, hf]
    change aeval (Sum.elim x y) (C r) = aeval (Sum.elim (Sum.elim x y) z) (C r)
    exact (aeval_C (Sum.elim x y) r).trans (aeval_C (Sum.elim (Sum.elim x y) z) r).symm
  · rcases i with i | c
    · have h := hψ (X i) 1
      simp only [map_one, mul_one, rename_X] at h
      change Algebra.TensorProduct.productMap f g (ψ (Ideal.Quotient.mk ℐ (X (Sum.inl i)))) =
        𝔈 (Ideal.Quotient.mk ℐ (X (Sum.inl i)))
      rw [h]
      simp only [Algebra.TensorProduct.productMap_apply_tmul, map_one, mul_one,
        locusCoordinateRingEquiv_mk, hf]
      change aeval (Sum.elim x y) (X i) = aeval (Sum.elim (Sum.elim x y) z) (X (Sum.inl i))
      exact (aeval_X (Sum.elim x y) i).trans
        (aeval_X (Sum.elim (Sum.elim x y) z) (Sum.inl i)).symm
    · have h' := hψ 1 (X (Sum.inr c))
      simp only [map_one, one_mul, rename_X, Sum.elim_inr] at h'
      change Algebra.TensorProduct.productMap f g (ψ (Ideal.Quotient.mk ℐ (X (Sum.inr c)))) =
        𝔈 (Ideal.Quotient.mk ℐ (X (Sum.inr c)))
      rw [h']
      simp only [Algebra.TensorProduct.productMap_apply_tmul, map_one, one_mul,
        locusCoordinateRingEquiv_mk, hg]
      change aeval (Sum.elim y z) (X (Sum.inr c)) =
        aeval (Sum.elim (Sum.elim x y) z) (X (Sum.inr c))
      exact (aeval_X (Sum.elim y z) (Sum.inr c)).trans
        (aeval_X (Sum.elim (Sum.elim x y) z) (Sum.inr c)).symm

/-- **The joint tuple component.** If every coordinate of `z` is algebraic over the field
generated by `y`, the kernel of evaluation at the joint tuple `(x, y, z)` on the incidence ring
`k[X, Y, Z] ⧸ (I(x, y) + I(y, z))` is a minimal prime, and its zero locus has dense image in
`Spec (k[Y] ⧸ I(y))` along the map induced by the inclusion of the variables `Y`. -/
theorem locusIncidence_jointPrime_dominating (hzy : ∀ i, z i ∈ racl k (Set.range y)) :
    RingHom.ker 𝔈 ∈ minimalPrimes (MvPolynomial ((α ⊕ β) ⊕ γ) k ⧸ ℐ) ∧
      closure (PrimeSpectrum.comap (Ideal.quotientMapₐ ℐ (rename (Sum.inl ∘ Sum.inr))
          (idealOf_le_comap_rename_comp (a := Sum.elim x y) (b := y) (g := Sum.inr)
            (e := Sum.inl) rfl le_sup_left)).toRingHom ''
        PrimeSpectrum.zeroLocus
          (RingHom.ker 𝔈 : Set (MvPolynomial ((α ⊕ β) ⊕ γ) k ⧸ ℐ))) = Set.univ := by
  let _ : Algebra 𝔎 𝔏 := (IntermediateField.inclusion (IntermediateField.adjoin.mono k _ _
    (Set.Sum.elim_range x y ▸ Set.subset_union_right))).toRingHom.toAlgebra
  let _ : Algebra 𝔎 𝔐 := (IntermediateField.inclusion (IntermediateField.adjoin.mono k _ _
    (Set.Sum.elim_range y z ▸ Set.subset_union_left))).toRingHom.toAlgebra
  have : Algebra.IsAlgebraic 𝔎 𝔐 := isAlgebraic_locusField y z hzy
  obtain ⟨ψ, hψ, hset⟩ := exists_locusIncidence_dominatingComponents (k := k) x y z
  let f : 𝔏 →ₐ[𝔎] Ω := { (IntermediateField.val 𝔏).toRingHom with commutes' := fun _ ↦ rfl }
  let g : 𝔐 →ₐ[𝔎] Ω := { (IntermediateField.val 𝔐).toRingHom with commutes' := fun _ ↦ rfl }
  exact ker_mem_minimalPrimes_of_productMap_comp f g ψ _
    (productMap_comp_eq_eval x y z f g (fun _ ↦ rfl) (fun _ ↦ rfl) ψ hψ) _ hset

end AclGeom
