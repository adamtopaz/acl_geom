import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.RingTheory.Adjoin.Basic

/-!
# Parameter Overlap

**Status:** proved, with a named consumer in the actual curve-completion construction.
These lemmas reach CurveCompletion.connectedGroup_completion_and_extensions: an actual
one-dimensional connected algebraic group over an ACF base embeds openly in a constructed
proper normal integral dimension-one curve, and its individual automorphisms extend uniquely.
The original smooth separated curve is retained. Projectivity, jointly regular extended
families and the full rational/non-affine classifier remain separate source obligations.
The source of truth is `sources/blueprint.tex`, Lemma `affine-action` (#21).
-/

namespace AclGeom.CurveCompletion
noncomputable section
universe u v
variable {k : Type u} {F : Type v} [Field k] [Field F] [Algebra k F]

/-- The actual polynomial parameter subalgebra k[t] inside the given field. Named consumer:
normalizedRing_properties. -/
def parameterRing (t : F) : Subalgebra k F := Algebra.adjoin k ({t} : Set F)
/-- The actual Laurent parameter subalgebra generated by t and its inverse. Named consumer:
overlap_isLocalization. -/
def overlapRing (t : F) : Subalgebra k F := Algebra.adjoin k ({t, t⁻¹} : Set F)
/-- The literal parameter t as an element of its polynomial parameter ring. Named consumer:
overlap_isLocalization. -/
def parameter (t : F) : parameterRing (k := k) t :=
  ⟨t, Algebra.subset_adjoin (Set.mem_singleton t)⟩

/-- The polynomial parameter ring lies in the Laurent parameter ring. Named consumer:
normalizedClosure_le_overlap. -/
theorem parameterRing_le_overlapRing (t : F) :
    parameterRing (k := k) t ≤ overlapRing (k := k) t :=
  Algebra.adjoin_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))

/-- The actual inclusion of the polynomial parameter ring into the overlap. Named consumer:
overlapAlgebra. -/
def parameterToOverlap (t : F) :
    parameterRing (k := k) t →ₐ[k] overlapRing (k := k) t :=
  Subalgebra.inclusion (parameterRing_le_overlapRing t)

/-- The base algebra induced by the literal parameter-ring inclusion. Named consumer:
overlap_isLocalization. -/
@[instance_reducible]
def overlapAlgebra (t : F) :
    Algebra (parameterRing (k := k) t) (overlapRing (k := k) t) :=
  (parameterToOverlap t).toRingHom.toAlgebra

/-- The literal two-parameter overlap is the principal localization of either
parameter chart. Named consumer: the actual integral-closure completion atlas. -/
theorem overlap_isLocalization (t : F) (ht : t ≠ 0) :
    letI := overlapAlgebra (k := k) t
    IsLocalization.Away (parameter (k := k) t) (overlapRing (k := k) t) := by
  let P := parameterRing (k := k) t
  let T := overlapRing (k := k) t
  let := overlapAlgebra (k := k) t
  let a : T := ⟨t, Algebra.subset_adjoin (Set.mem_insert _ _)⟩
  let b : T := ⟨t⁻¹, Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩
  have hab : a * b = 1 := Subtype.ext (mul_inv_cancel₀ ht)
  have hu : IsUnit (algebraMap P T (parameter t)) := by
    change IsUnit a
    exact IsUnit.of_mul_eq_one b hab
  let S : Subalgebra k F :=
    { carrier := {x | ∃ (n : ℕ) (p : P), x * t ^ n = p}
      zero_mem' := ⟨0, 0, by simp⟩
      one_mem' := ⟨0, 1, by simp⟩
      add_mem' := by
        rintro x y ⟨n, p, hp⟩ ⟨m, q, hq⟩
        refine ⟨n + m, p * parameter t ^ m + q * parameter t ^ n, ?_⟩
        change (x + y) * t ^ (n + m) = (p : F) * t ^ m + (q : F) * t ^ n
        rw [pow_add, add_mul]
        rw [← mul_assoc, hp]
        congr 1
        calc
          y * (t ^ n * t ^ m) = (y * t ^ m) * t ^ n := by ac_rfl
          _ = (q : F) * t ^ n := congrArg (fun z ↦ z * t ^ n) hq
      mul_mem' := by
        rintro x y ⟨n, p, hp⟩ ⟨m, q, hq⟩
        refine ⟨n + m, p * q, ?_⟩
        change (x * y) * t ^ (n + m) = (p : F) * (q : F)
        rw [pow_add, mul_mul_mul_comm, hp, hq]
      algebraMap_mem' := fun c ↦ ⟨0, algebraMap k P c, by simp⟩ }
  have hT : T ≤ S := by
    apply Algebra.adjoin_le
    intro x hx
    rcases Set.mem_insert_iff.mp hx with hx | hx
    · exact ⟨0, parameter t, by
        change x * t ^ 0 = t
        simpa only [pow_zero, mul_one] using hx⟩
    · have h := Set.mem_singleton_iff.mp hx
      exact ⟨1, 1, by simpa only [h, pow_one, Subalgebra.coe_one] using inv_mul_cancel₀ ht⟩
  refine IsLocalization.Away.mk (parameter t) hu ?_ ?_
  · intro z
    obtain ⟨n, p, hp⟩ := hT z.property
    exact ⟨n, p, Subtype.ext hp⟩
  · intro p q hpq
    exact ⟨0, by simpa using (Subtype.ext (congrArg (fun z : T ↦ (z : F)) hpq) : p = q)⟩

end
end AclGeom.CurveCompletion
