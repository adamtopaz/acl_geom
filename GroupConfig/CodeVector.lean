import GroupConfig.ConjugateSet
import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# The indexed coefficient vector of a code

Blueprint `sources/group_configuration/03-codes.tex`, `def:code` and `lem:code`, in the indexed
form of the source.

For a finite set `S` of `d` tuples, the source's code `code(S) ∈ K^{𝒩_{d,m}}` is the vector of
coefficients of `P_S = ∏_{s ∈ S} (T - ∑_j s_j U_j)`, indexed by the monomials `T^i U^m` of total
degree at most `d`. These monomials form the finite type
`GroupConfig.FiniteSetCode.CodeIndex ι d`, and the vector is
`GroupConfig.FiniteSetCode.codeVec d S`, whose entries are the coefficients of
`GroupConfig.codePoly S`. The source's code of `S` is `codeVec S.card S`.

* `P_S` is homogeneous of degree `|S|` in `(T, U)`: its coefficients off total degree `|S|`
  vanish (`GroupConfig.FiniteSetCode.coeff_coeff_codePoly_eq_zero`). Hence, for `|S| ≤ d`,
  the nonzero entries of the vector are exactly the scalar coefficient carrier `GroupConfig.code S`
  (`GroupConfig.FiniteSetCode.range_codeVec_diff_zero`).
* `lem:code`(1): the vector is natural (`GroupConfig.FiniteSetCode.codeVec_map`),
  and its entries lie in the ring generated by the coordinates
  (`GroupConfig.FiniteSetCode.range_codeVec_subset_adjoin`).
* `lem:code`(2): two sets of size `d` with the same vector are equal
  (`GroupConfig.FiniteSetCode.codeVec_injective`), so an automorphism fixes the vector
  iff it stabilises the set (`GroupConfig.FiniteSetCode.fixes_codeVec_iff`).
* `lem:code`(3): the vector and the coordinates have the same algebraic closure
  (`GroupConfig.FiniteSetCode.racl_range_codeVec`).
* `lem:code`(4): the vector of a set stable under every automorphism over `L` is definable
  over `L` (`GroupConfig.FiniteSetCode.range_codeVec_subset_dcl`).

This module is part of the formalization of the group configuration theorem
blueprint `sources/group_configuration_blueprint.tex`.

**Status:** `def:code` in its indexed form and `lem:code`(1)–(4) for the indexed coefficient
vector are complete.
-/

namespace GroupConfig

namespace FiniteSetCode

open AclGeom MvPolynomial Set

noncomputable section

/-- `def:code`: the monomials `T^i U^m` of total degree at most `d`, written as pairs `(i, m)`.
-/
def CodeIndex (ι : Type*) (d : ℕ) : Type _ := {p : ℕ × (ι →₀ ℕ) // p.1 + p.2.degree ≤ d}

instance {ι : Type*} [Finite ι] (d : ℕ) : Finite (CodeIndex ι d) := by
  have h : {p : ℕ × (ι →₀ ℕ) | p.1 + p.2.degree ≤ d}.Finite :=
    ((Set.finite_Iic d).prod (Finsupp.finite_of_degree_le d)).subset
      fun p (hp : p.1 + p.2.degree ≤ d) ↦ ⟨Set.mem_Iic.2 (by omega), show p.2.degree ≤ d by omega⟩
  exact h.to_subtype

section Ring

variable {R : Type*} [CommRing R] {ι : Type*} [Fintype ι]

/-- The code polynomial is homogeneous of degree `|S|` in `(T, U)`: its coefficient at
`T^i U^m` vanishes unless `i + |m| = |S|`. -/
theorem coeff_coeff_codePoly_eq_zero (S : Finset (ι → R)) {i : ℕ} {m : ι →₀ ℕ}
    (h : i + m.degree ≠ S.card) : ((codePoly S).coeff i).coeff m = 0 := by
  -- The same product in the variables `Option ι`, with `T = X none`.
  let Q : MvPolynomial (Option ι) R := ∏ s ∈ S, (X none - ∑ j, C (s j) * X (some j))
  have hQ : optionEquivLeft R ι Q = codePoly S := by
    simp only [Q, codePoly, linForm, map_prod, map_sub, map_sum, map_mul,
      optionEquivLeft_X_none, optionEquivLeft_X_some, optionEquivLeft_C]
  have hhom : Q.IsHomogeneous S.card := by
    have := IsHomogeneous.prod S (fun s ↦ X none - ∑ j, C (s j) * X (some j)) (fun _ ↦ 1)
      fun s _ ↦ (isHomogeneous_X R none).sub
        (IsHomogeneous.sum _ _ 1 fun j _ ↦ isHomogeneous_C_mul_X (s j) (some j))
    simpa only [Finset.sum_const, smul_eq_mul, mul_one] using this
  have hdeg : (m.optionElim i).degree = i + m.degree := by
    rw [Finsupp.degree_eq_sum, Fintype.sum_option, Finsupp.degree_eq_sum]
    simp only [Finsupp.optionElim_apply_none, Finsupp.optionElim_apply_some]
  rw [← hQ, optionEquivLeft_coeff_coeff]
  exact hhom.coeff_eq_zero (hdeg.trans_ne h)

/-- `def:code`: the code of `S` as the vector of coefficients of its code polynomial, indexed by
the monomials of total degree at most `d`. The source's code is `codeVec S.card S`. -/
def codeVec (d : ℕ) (S : Finset (ι → R)) : CodeIndex ι d → R :=
  fun p ↦ ((codePoly S).coeff p.1.1).coeff p.1.2

/-- For `|S| ≤ d`, the nonzero entries of the indexed vector form the scalar coefficient
carrier of the code. -/
theorem range_codeVec_diff_zero {d : ℕ} {S : Finset (ι → R)} (hS : S.card ≤ d) :
    range (codeVec d S) \ {0} = code S := by
  ext x
  constructor
  · rintro ⟨⟨p, rfl⟩, hx⟩
    exact coeff_coeff_mem_code hx
  · rintro ⟨i, hi⟩
    obtain ⟨m, hm, rfl⟩ := mem_coeffs_iff.1 hi
    have hne : ((codePoly S).coeff i).coeff m ≠ 0 := mem_support_iff.1 hm
    have hdeg : i + m.degree = S.card :=
      by_contra fun h ↦ hne (coeff_coeff_codePoly_eq_zero S h)
    exact ⟨⟨⟨(i, m), hdeg.le.trans hS⟩, rfl⟩, hne⟩

/-- `lem:code`(1): naturality of the indexed code along injective ring homomorphisms. -/
theorem codeVec_map {R' : Type*} [CommRing R'] (f : R →+* R') (hf : Function.Injective f)
    (d : ℕ) (S : Finset (ι → R)) : codeVec d (S.map (compEmb f hf)) = f ∘ codeVec d S :=
  funext fun p ↦ (map_coeff_coeff_codePoly f hf S p.1.1 p.1.2).symm

/-- `lem:code`(2): sets of the same size `d` with the same indexed code are equal. -/
theorem codeVec_injective [IsDomain R] {d : ℕ} {S S' : Finset (ι → R)} (hS : S.card = d)
    (hS' : S'.card = d) (h : codeVec d S = codeVec d S') : S = S' := by
  apply codePoly_injective
  ext i m
  by_cases hd : i + m.degree = d
  · exact congrFun h ⟨(i, m), hd.le⟩
  · rw [coeff_coeff_codePoly_eq_zero S fun h' ↦ hd (h'.trans hS),
      coeff_coeff_codePoly_eq_zero S' fun h' ↦ hd (h'.trans hS')]

end Ring

section Field

variable {k K : Type*} [Field k] [Field K] [Algebra k K] {ι : Type*} [Fintype ι]

/-- `lem:code`(1): the entries of the indexed code lie in the ring generated over `k` by the
coordinates. -/
theorem range_codeVec_subset_adjoin (d : ℕ) (S : Finset (ι → K)) :
    range (codeVec d S) ⊆ (Algebra.adjoin k (coords S) : Set K) := by
  rintro _ ⟨p, rfl⟩
  by_cases hp : codeVec d S p = 0
  · rw [hp]
    exact zero_mem _
  · exact code_subset_adjoin S (coeff_coeff_mem_code hp)

/-- `lem:code`(2): for `|S| ≤ d`, an automorphism over `k` fixes the indexed code iff it
stabilises `S`. -/
theorem fixes_codeVec_iff (σ : K ≃ₐ[k] K) {d : ℕ} {S : Finset (ι → K)} (hS : S.card ≤ d) :
    ⇑σ ∘ codeVec d S = codeVec d S ↔ S.map (compEmb σ σ.injective) = S := by
  rw [← fixes_code_iff_algEquiv σ S]
  constructor
  · intro h x hx
    rw [← range_codeVec_diff_zero hS] at hx
    obtain ⟨⟨p, rfl⟩, -⟩ := hx
    exact congrFun h p
  · intro h
    funext p
    by_cases hp : codeVec d S p = 0
    · simp only [Function.comp_apply, hp, map_zero]
    · exact h _ (coeff_coeff_mem_code hp)

/-- `lem:code`(3): for `|S| ≤ d`, the indexed code and the coordinates generate the same
relatively algebraically closed subfield. -/
theorem racl_range_codeVec {d : ℕ} {S : Finset (ι → K)} (hS : S.card ≤ d) :
    racl k (range (codeVec d S)) = racl k (coords S) := by
  rw [← racl_code_eq S]
  refine le_antisymm (racl_le_of_subset_racl ?_) (racl_mono ?_)
  · rintro _ ⟨p, rfl⟩
    by_cases hp : codeVec d S p = 0
    · rw [hp]
      exact zero_mem _
    · exact subset_racl k _ (coeff_coeff_mem_code hp)
  · rw [← range_codeVec_diff_zero hS]
    exact sdiff_subset

/-- `lem:code`(4): if every automorphism over `L` stabilises `S`, the entries of its indexed
code lie in `dcl L`. -/
theorem range_codeVec_subset_dcl [IsAlgClosed K] {L : IntermediateField k K}
    {S : Finset (ι → K)}
    (h : ∀ σ : K ≃ₐ[↥L] K,
      S.map (compEmb (σ.restrictScalars k) (σ.restrictScalars k).injective) = S) (d : ℕ) :
    range (codeVec d S) ⊆ dcl L := by
  rintro _ ⟨p, rfl⟩
  by_cases hp : codeVec d S p = 0
  · rw [hp]
    exact zero_mem _
  · exact code_subset_dcl h (coeff_coeff_mem_code hp)

end Field

end

end FiniteSetCode

end GroupConfig
