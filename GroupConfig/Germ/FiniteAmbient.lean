import GroupConfig.Germ.Basic

/-!
# Germ representatives in an ambient field of finite transcendence degree

Blueprint `sources/group_configuration/01-universal-domain.tex`, `rem:finite-trdeg`: the
hypothesis that `K` has infinite transcendence degree over `k` is essential for the germ
quotient of `def:germ`. If the transcendence degree is finite:

* `K` itself is small (`GroupConfig.isSmall_univ_of_trdeg_lt`);
* a locus of positive rank has no generic point over `K`
  (`GroupConfig.not_isGenericOver_of_top_le`);
* every quasi-rational expression over `K` is vacuously a representative with field `K`
  (`GroupConfig.Representative.top`), equivalent to every other representative
  (`GroupConfig.Representative.top_equivalent`);
* hence the equivalence relation generated by `GroupConfig.Representative.Equivalent` identifies
  any two representatives (`GroupConfig.Representative.eqvGen_equivalent`).

Without a universal domain, `Representative.Equivalent` is not shown to be transitive, and
`GroupConfig.Germ` (which assumes `UniversalDomain k K`) is not defined in this situation; the
collapse is stated for the generated equivalence relation.

This module is part of the formalization of the group configuration theorem
blueprint `sources/group_configuration_blueprint.tex`.

**Status:** the collapse asserted in `rem:finite-trdeg` is complete.
-/

namespace GroupConfig

open AclGeom IntermediateField Set

noncomputable section

variable {k K : Type*} [Field k] [Field K] [Algebra k K] {ι κ : Type*}

/-- `rem:finite-trdeg`: if `K` has finite transcendence degree over `k`, then `K` itself is
small. Named consumer: `GroupConfig.Representative.top`. -/
theorem isSmall_univ_of_trdeg_lt (h : Algebra.trdeg k K < Cardinal.aleph0) :
    IsSmall k (univ : Set K) := by
  unfold IsSmall
  rw [erk_empty_eq_toENat_trdeg,
    ((equivOfEq (adjoin_univ k K)).trans topEquiv).trdeg_eq]
  exact Cardinal.toENat_ne_top.2 h

/-- `rem:finite-trdeg`: a locus of positive rank has no generic point over a field containing
all of `K`. Named consumers: `GroupConfig.Representative.top` and
`GroupConfig.Representative.top_equivalent`. -/
theorem not_isGenericOver_of_top_le [Finite ι] {M : IntermediateField k K} (hM : ⊤ ≤ M)
    {a : ι → K} (ha : 1 ≤ erk k ∅ (range a)) (y : ι → K) : ¬ IsGenericOver M a y := by
  intro hy
  have h0 : erk k (M : Set K) (range y) = 0 :=
    (erk_eq_zero_iff k).2 fun _ _ ↦ subset_racl k (M : Set K) (hM mem_top)
  rw [hy.erk_coe_eq, hy.erk_empty_eq] at h0
  rw [h0] at ha
  simp at ha

variable [IsAlgClosed K]

namespace Representative

variable [Finite ι] {a : ι → K} {a' : κ → K}

/-- `rem:finite-trdeg`: if `K` is small, every quasi-rational expression over `K` is vacuously a
representative with field `K` of a germ from a locus of positive rank. -/
def top (hK : IsSmall k (univ : Set K)) (ha : 1 ≤ erk k ∅ (range a))
    (f : QuasiRational (↥(⊤ : IntermediateField k K)) ι κ) : Representative k K a a' where
  M := ⊤
  isAlgClosed := IsAlgClosed.of_ringEquiv K _ (topEquiv (F := k) (E := K)).symm.toRingEquiv
  isSmall := by
    rw [coe_top]
    exact hK
  f := f
  isDefinedAt y hy := absurd hy (not_isGenericOver_of_top_le le_rfl ha y)
  isGenericOver y hy := absurd hy (not_isGenericOver_of_top_le le_rfl ha y)

/-- `rem:finite-trdeg`: the representative with field `K` is vacuously equivalent to every
representative. -/
theorem top_equivalent (hK : IsSmall k (univ : Set K)) (ha : 1 ≤ erk k ∅ (range a))
    (f : QuasiRational (↥(⊤ : IntermediateField k K)) ι κ) (r : Representative k K a a') :
    (top hK ha f).Equivalent r := fun y hy ↦
  absurd hy (not_isGenericOver_of_top_le
    (fun _ _ ↦ subset_racl k _ (Or.inl (mem_top : _ ∈ (⊤ : IntermediateField k K)))) ha y)

/-- `rem:finite-trdeg`: if `K` is small, the equivalence relation generated by
`Representative.Equivalent` identifies any two representatives of germs from a locus of positive
rank; the germ quotient collapses. -/
theorem eqvGen_equivalent (hK : IsSmall k (univ : Set K)) (ha : 1 ≤ erk k ∅ (range a))
    (r r' : Representative k K a a') : Relation.EqvGen Representative.Equivalent r r' := by
  let r₀ : Representative k K a a' := top hK ha ⟨0, fun _ ↦ 0, fun _ ↦ 1⟩
  exact .trans _ r₀ _ (.symm _ _ (.rel _ _ (top_equivalent hK ha _ r)))
    (.rel _ _ (top_equivalent hK ha _ r'))

end Representative

end

end GroupConfig
