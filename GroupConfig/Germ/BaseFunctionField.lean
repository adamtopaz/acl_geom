import GroupConfig.Locus
import AclGeom.Curves.Places
import Mathlib.FieldTheory.SeparablyGenerated

/-!
# The function field of a locus over its base field

For a tuple `v` in a field `K ⊇ k`, `BaseFunctionField k v` is the fraction field of the
coordinate ring `k[X] ⧸ I(v/k)`. It is an abstract model of the subfield `k(v)` of `K`
(`BaseFunctionField.equiv`), with coordinates `BaseFunctionField.coord`. When the tuple is
finite of rank one over a perfect field `k`, it is a function field of one variable with a
separating transcendental element (`BaseFunctionField.exists_separating_transcendental`,
`BaseFunctionField.isFunctionFieldOneVar`). These are the hypotheses of the constant extension
results in `AclGeom.Curves.ConstantExtension`.

This module is part of the formalization of the group configuration theorem
blueprint `sources/group_configuration_blueprint.tex`.

**Status:** proved, with no unproved hypotheses (#21). An input of the genus argument for
Hrushovski–Weil curves.
-/

namespace GroupConfig

open AclGeom MvPolynomial Set
open scoped IntermediateField.algebraAdjoinAdjoin

noncomputable section

variable (k : Type*) {K : Type*} [Field k] [Field K] [Algebra k K] {ι : Type*} (v : ι → K)

/-- The function field of the locus of `v` over `k`: the fraction field of `k[X] ⧸ I(v/k)`. -/
abbrev BaseFunctionField : Type _ := FractionRing (MvPolynomial ι k ⧸ idealOf k v)

namespace BaseFunctionField

/-- The `i`-th coordinate function. -/
def coord (i : ι) : BaseFunctionField k v :=
  algebraMap (MvPolynomial ι k ⧸ idealOf k v) _ (Ideal.Quotient.mk _ (X i))

/-- `BaseFunctionField k v` is the subfield `k(v)` generated by `v`. -/
def equiv : BaseFunctionField k v ≃ₐ[k] IntermediateField.adjoin k (range v) :=
  IsFractionRing.algEquivOfAlgEquiv (locusCoordinateRingEquiv (k := k) v)

theorem equiv_coord (i : ι) :
    equiv k v (coord k v i) =
      ⟨v i, IntermediateField.subset_adjoin k _ (mem_range_self i)⟩ := by
  rw [coord, equiv, IsFractionRing.algEquivOfAlgEquiv_algebraMap, locusCoordinateRingEquiv_mk]
  apply Subtype.ext
  change aeval v (X i) = v i
  rw [aeval_X]

theorem essFiniteType [Finite ι] : Algebra.EssFiniteType k (BaseFunctionField k v) :=
  inferInstance

/-- A tuple of rank one has a function field of transcendence degree one. -/
theorem trdeg_eq_one (hv : erk k ∅ (range v) = 1) :
    Algebra.trdeg k (BaseFunctionField k v) = 1 := by
  have hE : Algebra.trdeg k (IntermediateField.adjoin k (range v)) = 1 := by
    rw [← Cardinal.toENat_eq_one, ← erk_empty_eq_toENat_trdeg, hv]
  have h := (equiv k v).lift_trdeg_eq
  rw [hE, Cardinal.lift_one] at h
  exact Cardinal.lift_eq_one.1 h

/-- **A separating transcendental element.** Over a perfect field, the function field of a
finite tuple of rank one is finite separable over `k(t)` for some transcendental `t`. -/
theorem exists_separating_transcendental [PerfectField k] [Finite ι]
    (hv : erk k ∅ (range v) = 1) :
    ∃ t : BaseFunctionField k v, Transcendental k t ∧
      FiniteDimensional (IntermediateField.adjoin k ({t} : Set (BaseFunctionField k v)))
        (BaseFunctionField k v) ∧
      Algebra.IsSeparable (IntermediateField.adjoin k ({t} : Set (BaseFunctionField k v)))
        (BaseFunctionField k v) := by
  obtain ⟨s, hs, hsep⟩ :=
    exists_isTranscendenceBasis_and_isSeparable_of_perfectField k (BaseFunctionField k v)
  have hcard : s.card = 1 := by
    have h := hs.cardinalMk_eq_trdeg
    rw [Cardinal.mk_coe_finset, trdeg_eq_one k v hv] at h
    exact_mod_cast h
  obtain ⟨t, rfl⟩ := Finset.card_eq_one.1 hcard
  have halg := hs.isAlgebraic_field
  have hr : range ((↑) : ({t} : Finset (BaseFunctionField k v)) → BaseFunctionField k v) =
      {t} := by
    ext
    simp
  rw [hr] at halg
  rw [Finset.coe_singleton] at hsep
  have _ : Algebra.EssFiniteType (IntermediateField.adjoin k ({t} : Set (BaseFunctionField k v)))
      (BaseFunctionField k v) := Algebra.EssFiniteType.of_comp k _ _
  have hfin := Algebra.finite_of_essFiniteType_of_isAlgebraic
    (F := IntermediateField.adjoin k ({t} : Set (BaseFunctionField k v)))
    (E := BaseFunctionField k v)
  exact ⟨t, hs.1.transcendental ⟨t, Finset.mem_singleton_self t⟩, hfin, hsep⟩

/-- Over a perfect field, the function field of a finite tuple of rank one is a function field
of one variable. -/
theorem isFunctionFieldOneVar [PerfectField k] [Finite ι] (hv : erk k ∅ (range v) = 1) :
    AclGeom.IsFunctionFieldOneVar k (BaseFunctionField k v) :=
  let ⟨t, ht, hfd, _⟩ := exists_separating_transcendental k v hv
  ⟨⟨t, ht, hfd⟩⟩

end BaseFunctionField

end

end GroupConfig
