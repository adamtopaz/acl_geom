import GroupConfig.Germ.Graph

/-!
# Canonical bases and codes of germs

Blueprint `sources/group_configuration/04-germs.tex`, `def:germcode` and the last clause of
`lem:germ-aut`.

The *canonical base* `Germ.cb g` of a germ is the field generated over `k` by the field of
definition of its graph ideal; it is the canonical base of a graph point over the field of
any representative (`Germ.cb_mk_eq_canonicalBase`), hence small and contained in the field
of every representative (`Germ.isSmall_cb`, `Germ.cb_mk_le`).  The *code* `Germ.codeSet g`
is a chosen finite set of generators of the field of definition, so that `k(code) = Cb(g)`
(`Germ.adjoin_codeSet`); ranks of germs are ranks of their codes
(`erk_adjoin_eq`).

This module is part of the formalization of the group configuration theorem
blueprint `sources/group_configuration_blueprint.tex`.

**Status:** canonical bases, their containment in representative fields,
smallness and a finite generating carrier for rank and closure calculations are
proved. `codeSet` is not the source's canonical indexed RREF vector; no global
carrier injectivity or coordinatewise naturality is asserted. The separate
canonical-vector and evaluation layers remain to be integrated.
-/

namespace GroupConfig

open AclGeom IntermediateField MvPolynomial Set

noncomputable section

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

/-- Adjoining the subfield generated by a set is adjoining the set. -/
theorem adjoin_coe_closure (s : Set K) :
    adjoin k ((Subfield.closure s : Subfield K) : Set K) = adjoin k s := by
  refine le_antisymm (adjoin_le_iff.2 ?_) (adjoin_le_iff.2 ((Subfield.subset_closure).trans ?_))
  · intro x hx
    exact (Subfield.closure_le (t := (adjoin k s).toSubfield)).2 (subset_adjoin k s) hx
  · exact subset_adjoin k _

/-- The rank of the field generated by a set is the rank of the set. -/
theorem erk_adjoin_eq (C s : Set K) : erk k C ((adjoin k s : IntermediateField k K) : Set K) =
    erk k C s := by
  refine le_antisymm ?_ (erk_mono k C (subset_adjoin k s))
  calc erk k C ((adjoin k s : IntermediateField k K) : Set K)
      ≤ erk k C (racl k (C ∪ s)) :=
        erk_mono k C (adjoin_le_iff.2 (subset_union_right.trans (subset_racl k _)))
    _ = erk k C s := erk_racl k C s

variable [IsAlgClosed K] {ι κ : Type*} {a : ι → K} {a' : κ → K} [IsAlgClosed k]
  [UniversalDomain k K] [Finite ι] [Finite κ]

namespace Germ

/-- `def:germcode`: the canonical base of a germ, the field generated over `k` by the field
of definition of its graph ideal. -/
def cb (g : Germ k a a') : IntermediateField k K := adjoin k (idealFod g.graphIdeal : Set K)

theorem cb_mk (r : Representative k K a a') :
    Germ.cb (⟦r⟧ : Germ k a a') = adjoin k (idealFod r.graphIdeal : Set K) := rfl

/-- The canonical base of a germ is the canonical base of a graph point over the field of a
representative. -/
theorem cb_mk_eq_canonicalBase (r : Representative k K a a') {y : ι → K}
    (hy : IsGenericOver r.M a y) :
    Germ.cb (⟦r⟧ : Germ k a a') = canonicalBase r.M (r.graphPoint y) := by
  rw [cb_mk, r.graphIdeal_eq hy]
  rfl

/-- `lem:germ-aut`, last clause: the canonical base lies in the field of every
representative. -/
theorem cb_mk_le (r : Representative k K a a') : Germ.cb (⟦r⟧ : Germ k a a') ≤ r.M := by
  obtain ⟨y, hy⟩ := exists_isGenericOver r.isSmall a
  rw [cb_mk_eq_canonicalBase r hy]
  exact canonicalBase_le _ _

/-- The canonical base of a germ is small. -/
theorem isSmall_cb (g : Germ k a a') : IsSmall k (g.cb : Set K) := by
  induction g using Quotient.inductionOn with
  | h r =>
    obtain ⟨y, hy⟩ := exists_isGenericOver r.isSmall a
    rw [cb_mk_eq_canonicalBase r hy]
    exact isSmall_canonicalBase _ _

/-- The graph ideal is defined over every field containing the canonical base. -/
theorem idealDefinedOver_graphIdeal (g : Germ k a a') {F : IntermediateField k K}
    (h : g.cb ≤ F) : IdealDefinedOver F.toSubfield g.graphIdeal := by
  refine idealDefinedOver_iff.2 fun x hx ↦ ?_
  exact (mem_toSubfield F x).2 (h (subset_adjoin k _ hx))

/-- `def:germcode`: a code of a germ, a finite set generating the field of definition of its
graph ideal. -/
def codeSet (g : Germ k a a') : Finset K :=
  Classical.choose (exists_finset_closure_eq_idealFod g.graphIdeal)

theorem closure_codeSet (g : Germ k a a') :
    Subfield.closure (g.codeSet : Set K) = idealFod g.graphIdeal :=
  Classical.choose_spec (exists_finset_closure_eq_idealFod g.graphIdeal)

/-- `def:germcode`: the code generates the canonical base over `k`. -/
theorem adjoin_codeSet (g : Germ k a a') : adjoin k (g.codeSet : Set K) = g.cb := by
  rw [cb, ← closure_codeSet, adjoin_coe_closure]

/-- `conv:germ-tuple`: the rank of a germ over a set is the rank of its code, which is the
rank of its canonical base. -/
theorem erk_codeSet_eq (g : Germ k a a') (C : Set K) :
    erk k C (g.codeSet : Set K) = erk k C (g.cb : Set K) := by
  rw [← adjoin_codeSet, erk_adjoin_eq]

end Germ

end

end GroupConfig
