import GroupConfig.Germ.Bijections
import GroupConfig.Germ.HomogeneousSpace

/-!
# The stabiliser of an embedded generic point

Blueprint `sources/group_configuration/09-constructibility.tex`, `thm:constructible`(2), the
germ criterion in the proof of the claim.

Let `f₀` be a Hrushovski–Weil datum of bijections `V → V'` (`thm:hw-bij`), with generic set
`𝓕`, and let `G` be the group generated by its difference set, acting on the homogeneous space
`S` with embedding `ι` of the generic points of `V`. For `γ ∈ G`, a generic point `y₀` of `V`,
and any `f ∈ 𝓕` independent from `γ` and `y₀`, the element `γ` fixes `ι(y₀)` exactly when
`(f γ)(y₀) = f(y₀)` (`Germ.IsHWBij.smul_iota_eq_iff`, `Germ.IsHWBij.mem_stabilizer_iota_iff`).
No independence of `y₀` from `γ` is assumed. On the way, `f γ` is independent from `γ` and from
every set from which `f` is (`Germ.IsHWBij.indepOver_cb_comp`).

The proof follows the source. `f γ ∈ 𝓕` is interalgebraic with `f` over `γ`, so it is
independent from `γ` and `y₀`. For `f₁ ∈ 𝓕` independent from everything else, `h = f₁⁻¹ f` is an
admissible witness for the equivalence relation of `S`, and `f₁⁻¹` is injective on points
generic over its canonical base.

This module is part of the formalization of the group configuration theorem
blueprint `sources/group_configuration_blueprint.tex`.

**Status:** the stabiliser criterion of `thm:constructible`(2) complete; the constructibility of
`H` is not part of this module.
-/

namespace GroupConfig

open AclGeom IntermediateField Set

noncomputable section

variable {k K : Type*} [Field k] [Field K] [Algebra k K] [IsAlgClosed k] [IsAlgClosed K]
  [UniversalDomain k K] {ι κ : Type*} [Finite ι] [Finite κ] {a : ι → K} {a' : κ → K}

attribute [local instance] isAlgClosed_racl

namespace Germ

namespace IsHWBij

variable {f₀ : Germ k a a'} (hb : IsHWBij f₀) {δ₀ : Germ k a a} (hδ₀ : δ₀ ∈ diffSet f₀)
include hb hδ₀

/-- `thm:hw-bij`, last claim, with a further set: if a member `f` of the generic set is
independent from `G` in the group and from `Y`, then so is `f G`, which is interalgebraic with
`f` over `G`. Consumers: the stabiliser criterion below and the stabiliser parameter relation
of `thm:constructible`(2). -/
theorem indepOver_cb_comp (hw : IsHW δ₀) {f : Germ k a a'} (hf : f ∈ orbit f₀)
    {G : Germ k a a} (hG : G ∈ IsHW.prodSet δ₀) {Y : Set K}
    (hind : IndepOver k ∅ (f.cb : Set K) ((G.cb : Set K) ∪ Y)) :
    IndepOver k ∅ ((Germ.comp f G).cb : Set K) ((G.cb : Set K) ∪ Y) := by
  obtain ⟨G', hG'⟩ := isUnit_iff.1 (hw.isUnit_of_mem_prodSet hG)
  obtain ⟨hfG, -⟩ := hb.comp_mem_orbit hδ₀ hf hG (hind.mono_right subset_union_left).symm
  have heq : erk k ((G.cb : Set K) ∪ Y) ((Germ.comp f G).cb : Set K) =
      erk k ((G.cb : Set K) ∪ Y) (f.cb : Set K) := by
    refine erk_eq_of_subset_racl ?_ ?_
    · exact (cb_comp_le_racl f G).trans (racl_mono (k := k)
        (union_subset (subset_union_left.trans subset_union_left) subset_union_right))
    · exact (cb_le_of_isInverse f hG').trans (racl_mono (k := k)
        (union_subset subset_union_right (subset_union_left.trans subset_union_left)))
  refine indepOver_cb_of_erk_eq _ ?_
  rw [empty_union, heq, ← empty_union ((G.cb : Set K) ∪ Y), erk_cb_eq_of_indepOver hind,
    erk_cb_eq_of_mem_orbit hf, erk_cb_eq_of_mem_orbit hfG]

/-- `thm:constructible`(2), the stabiliser criterion: for a member `f` of the generic set
independent from `γ` and from a generic point `y₀`, `γ` fixes `ι(y₀)` exactly when
`(f γ)(y₀) = f(y₀)`. -/
theorem smul_iota_eq_iff (hw : IsHW δ₀) (γ : ↥hw.prodSubgroup) {y₀ : ι → K} (hy₀ : IsGen k a y₀)
    {f : Germ k a a'} (hf : f ∈ orbit f₀)
    (hind : IndepOver k ∅ (f.cb : Set K) (((hw.val γ).cb : Set K) ∪ range y₀)) :
    γ • hw.iota hy₀ = hw.iota hy₀ ↔
      (Germ.comp f (hw.val γ)).evalGen y₀ = f.evalGen y₀ := by
  -- Independence is inherited by sets algebraic over independent sets.
  have mono : ∀ {A A' B B' : Set K}, A' ⊆ racl k A → B' ⊆ racl k B → IndepOver k ∅ A B →
      IndepOver k ∅ A' B' := fun {A _ B _} hA hB h ↦ by
    have h1 : IndepOver k ∅ (racl k (∅ ∪ A) : Set K) (racl k (∅ ∪ B) : Set K) :=
      indepOver_racl_right_iff.2 (indepOver_racl_left_iff.2 h)
    rw [empty_union, empty_union] at h1
    exact (h1.mono_left hA).mono_right hB
  set G := hw.val γ with hG
  set C : Set K := (G.cb : Set K) ∪ range y₀ with hC
  have hGmem : G ∈ IsHW.prodSet δ₀ := hw.val_mem γ
  -- `f G` is independent from `G` and `y₀`.
  have hfGC : IndepOver k ∅ ((Germ.comp f G).cb : Set K) C :=
    hb.indepOver_cb_comp hδ₀ hw hf hGmem hind
  /- A member `f₁` independent from everything, and the difference germ `h = f₁⁻¹ f`. -/
  obtain ⟨f₁, hf₁, hf₁ind⟩ := exists_mem_orbit_indepOver f₀ (f.isSmall_cb.union
    (G.isSmall_cb.union (IsSmall.of_finite (finite_range y₀))))
  obtain ⟨g₁, hg₁⟩ := isInvertible_of_mem_orbit hb.isInvertible hf₁
  have hg₁le : (g₁.cb : Set K) ⊆ racl k (f₁.cb : Set K) := hg₁.cb_le
  have hh : Germ.comp g₁ f ∈ orbit δ₀ := by
    rw [← diffSet_eq_orbit hδ₀]
    exact ⟨f₁, hf₁, f, hf, g₁, hg₁, hf₁ind.mono_right subset_union_left, rfl⟩
  have hf₁fC : IndepOver k ∅ ((f₁.cb : Set K) ∪ f.cb) C := hind.union_left hf₁ind
  have hfGW : ((Germ.comp f G).cb : Set K) ∪ range y₀ ⊆ racl k ((f.cb : Set K) ∪ C) :=
    union_subset ((cb_comp_le_racl f G).trans (racl_mono (k := k)
      (union_subset (subset_union_left.trans subset_union_right) subset_union_left)))
      ((subset_union_right.trans subset_union_right).trans (subset_racl k _))
  have hf₁fG : IndepOver k ∅ (f₁.cb : Set K) (((Germ.comp f G).cb : Set K) ∪ range y₀) :=
    mono (subset_racl k _) hfGW hf₁ind
  have hf₁f : IndepOver k ∅ (f₁.cb : Set K) ((f.cb : Set K) ∪ range y₀) :=
    hf₁ind.mono_right (union_subset_union_right _ subset_union_right)
  -- `y₀` is independent from `f₁` together with `f G`, and with `f`.
  have hyfG : IndepOver k ∅ (range y₀) ((g₁.cb : Set K) ∪ (Germ.comp f G).cb) :=
    mono (subset_racl k _) (union_subset (hg₁le.trans (racl_mono (k := k) subset_union_left))
      (subset_union_right.trans (subset_racl k _)))
      ((hfGC.mono_right subset_union_right).union_left hf₁fG).symm
  have hyf : IndepOver k ∅ (range y₀) ((g₁.cb : Set K) ∪ f.cb) :=
    mono (subset_racl k _) (union_subset (hg₁le.trans (racl_mono (k := k) subset_union_left))
      (subset_union_right.trans (subset_racl k _)))
      ((hind.mono_right subset_union_right).union_left hf₁f).symm
  /- `h` is an admissible witness for the relation of the pairs `(G, y₀)` and `(1, y₀)`. -/
  have hwit : IndepOver k ∅ ((Germ.comp g₁ f).cb : Set K)
      ((hw.smulPair γ (hw.onePair hy₀)).base ∪ (hw.onePair hy₀).base) := by
    refine mono ((cb_comp_le_racl g₁ f).trans (racl_le_of_subset_racl (union_subset
      (subset_union_right.trans (subset_racl k _))
      (hg₁le.trans (racl_mono (k := k) subset_union_left))))) ?_ hf₁fC
    change (((G * 1).cb : Set K) ∪ range y₀) ∪ (((1 : Germ k a a).cb : Set K) ∪ range y₀) ⊆ _
    rw [mul_one]
    refine union_subset (union_subset (subset_union_left.trans (subset_racl k _))
      (subset_union_right.trans (subset_racl k _))) (union_subset ?_
      (subset_union_right.trans (subset_racl k _)))
    exact (cb_id_le a (racl k (∅ : Set K))).trans (racl_mono (k := k) (empty_subset _))
  /- The values of `f G` and `f` at `y₀` are generic and independent from `f₁`. -/
  have hzind (g : Germ k a a') (hgy : IndepOver k ∅ (range y₀) (g.cb : Set K))
      (hf₁g : IndepOver k ∅ (f₁.cb : Set K) ((g.cb : Set K) ∪ range y₀)) :
      IndepOver k ∅ (range (g.evalGen y₀)) (g₁.cb : Set K) := by
    refine mono (?_ : range (g.evalGen y₀) ⊆ racl k ((g.cb : Set K) ∪ range y₀)) hg₁le hf₁g.symm
    rintro _ ⟨j, rfl⟩
    exact g.evalGen_mem_racl hy₀ hgy j
  have hfGy : IndepOver k ∅ (range y₀) ((Germ.comp f G).cb : Set K) :=
    (hfGC.mono_right subset_union_right).symm
  have hfy : IndepOver k ∅ (range y₀) (f.cb : Set K) := (hind.mono_right subset_union_right).symm
  have hz := hzind _ hfGy hf₁fG
  have hz' := hzind _ hfy hf₁f
  have hinj : g₁.evalGen ((Germ.comp f G).evalGen y₀) = g₁.evalGen (f.evalGen y₀) ↔
      (Germ.comp f G).evalGen y₀ = f.evalGen y₀ := by
    refine ⟨fun e ↦ ?_, fun e ↦ by rw [e]⟩
    rw [← hg₁.symm.evalGen_evalGen ((Germ.comp f G).isGen_evalGen hy₀ hfGy) hz,
      ← hg₁.symm.evalGen_evalGen (f.isGen_evalGen hy₀ hfy) hz', e]
  have key : (Germ.comp g₁ f * (hw.smulPair γ (hw.onePair hy₀)).γ).evalGen y₀ =
      (Germ.comp g₁ f * (hw.onePair hy₀).γ).evalGen y₀ ↔
        (Germ.comp f G).evalGen y₀ = f.evalGen y₀ := by
    change (Germ.comp g₁ f * (G * 1)).evalGen y₀ = (Germ.comp g₁ f * 1).evalGen y₀ ↔ _
    rw [mul_one, mul_one, mul_def, comp_assoc, evalGen_comp g₁ _ hy₀ hyfG,
      evalGen_comp g₁ f hy₀ hyf, hinj]
  change hw.ofPair (hw.smulPair γ (hw.onePair hy₀)) = hw.ofPair (hw.onePair hy₀) ↔ _
  rw [hw.ofPair_eq_ofPair]
  exact ⟨fun hr ↦ key.1 (hr _ hh hwit), fun he ↦ hw.rel_of_witness hh hwit (key.2 he)⟩

/-- `thm:constructible`(2): membership in the stabiliser `H` of `ι(y₀)`, by the germ criterion. -/
theorem mem_stabilizer_iota_iff (hw : IsHW δ₀) (γ : ↥hw.prodSubgroup) {y₀ : ι → K}
    (hy₀ : IsGen k a y₀) {f : Germ k a a'} (hf : f ∈ orbit f₀)
    (hind : IndepOver k ∅ (f.cb : Set K) (((hw.val γ).cb : Set K) ∪ range y₀)) :
    γ ∈ MulAction.stabilizer (↥hw.prodSubgroup) (hw.iota hy₀) ↔
      (Germ.comp f (hw.val γ)).evalGen y₀ = f.evalGen y₀ :=
  MulAction.mem_stabilizer_iff.trans (hb.smul_iota_eq_iff hδ₀ hw γ hy₀ hf hind)

end IsHWBij

end Germ

end

end GroupConfig
