import GroupConfig.Germ.Bijections
import GroupConfig.Germ.HomogeneousSpace

/-!
# The group of germs of a family of bijections and its homogeneous space

Blueprint `sources/group_configuration/09-constructibility.tex`, the group-theoretic parts of
`thm:constructible`.

* For a Hrushovski–Weil datum of bijections `f₀ : V → V'` (`thm:hw-bij`), the group `G`
  generated by the difference set consists exactly of the germs `f₁⁻¹ f₂` with `f₁, f₂` in the
  orbit `𝓕` of `f₀`, with no independence required (`Germ.IsHWBij.mem_prodSet_iff`). This is the
  first claim of `thm:constructible`(1).
* The group of a Hrushovski–Weil datum acts transitively on its homogeneous space
  (`Germ.IsHW.isPretransitive`). For the stabiliser `H` of a point `s`, for instance
  `s = ι(y₀)`, the orbit map `G/H → S`, `γH ↦ γ · s`, is a bijection
  (`Germ.IsHW.bijective_ofQuotientStabilizer`). It is packaged as a `G`-equivariant equivalence
  (`Germ.IsHW.quotientStabilizerEquiv`, `Germ.IsHW.quotientStabilizerEquiv_mk`,
  `Germ.IsHW.quotientStabilizerEquiv_smul`). This is the orbit-map clause of
  `thm:constructible`(2).

The constructibility claims of `thm:constructible` are not part of this module.

This module is part of the formalization of the group configuration theorem
blueprint `sources/group_configuration_blueprint.tex`.

**Status:** the group-theoretic claims of `thm:constructible` complete; its constructibility
claims are proved in `GroupConfig.Constructible.CanonicalPresentation`.
-/

namespace GroupConfig

open AclGeom IntermediateField Set

noncomputable section

variable {k K : Type*} [Field k] [Field K] [Algebra k K] [IsAlgClosed k] [IsAlgClosed K]
  [UniversalDomain k K] {ι κ : Type*} [Finite ι] [Finite κ] {a : ι → K} {a' : κ → K}

namespace Germ

namespace IsHWBij

variable {f₀ : Germ k a a'} (hb : IsHWBij f₀)
include hb

/-- `thm:constructible`(1): the group generated by the difference set consists of the germs
`f₁⁻¹ f₂` with `f₁, f₂ ∈ 𝓕`. -/
theorem mem_prodSet_iff {δ₀ : Germ k a a} (hδ₀ : δ₀ ∈ diffSet f₀) {γ : Germ k a a} :
    γ ∈ IsHW.prodSet δ₀ ↔ ∃ f₁ ∈ orbit f₀, ∃ f₂ ∈ orbit f₀, ∃ g₁ : Germ k a' a,
      IsInverse g₁ f₁ ∧ γ = Germ.comp g₁ f₂ := by
  constructor
  · intro hγ
    obtain ⟨f, hf, hind⟩ := exists_mem_orbit_indepOver f₀ γ.isSmall_cb
    obtain ⟨hmem, -⟩ := hb.comp_mem_orbit hδ₀ hf hγ hind.symm
    obtain ⟨g, hg⟩ := isInvertible_of_mem_orbit hb.isInvertible hf
    refine ⟨f, hf, Germ.comp f γ, hmem, g, hg, ?_⟩
    rw [← comp_assoc, hg.1, id_comp]
  · rintro ⟨f₁, hf₁, f₂, hf₂, g₁, hg₁, rfl⟩
    obtain ⟨f, hf, hind⟩ := exists_mem_orbit_indepOver f₀ (f₁.isSmall_cb.union f₂.isSmall_cb)
    obtain ⟨g, hg⟩ := isInvertible_of_mem_orbit hb.isInvertible hf
    have h₁ : Germ.comp g₁ f ∈ diffSet f₀ :=
      ⟨f₁, hf₁, f, hf, g₁, hg₁, (hind.mono_right subset_union_left).symm, rfl⟩
    have h₂ : Germ.comp g f₂ ∈ diffSet f₀ :=
      ⟨f, hf, f₂, hf₂, g, hg, hind.mono_right subset_union_right, rfl⟩
    rw [diffSet_eq_orbit hδ₀] at h₁ h₂
    refine ⟨_, h₁, _, h₂, ?_⟩
    rw [mul_def, ← comp_assoc, comp_assoc g₁ f g, hg.2, comp_id]

end IsHWBij

namespace IsHW

variable {g₀ : Germ k a a} (hw : IsHW g₀)

/-- `thm:hw`(e): the group acts transitively on the homogeneous space. -/
instance isPretransitive : MulAction.IsPretransitive (↥hw.prodSubgroup) hw.Space :=
  ⟨hw.exists_smul_eq⟩

/-- `thm:constructible`(2), the orbit map: for the stabiliser `H` of a point `s` of the
homogeneous space, `γH ↦ γ · s` is a bijection from `G/H` onto the space. It is
equivariant by `MulAction.ofQuotientStabilizer_smul`. -/
theorem bijective_ofQuotientStabilizer (s : hw.Space) :
    Function.Bijective (MulAction.ofQuotientStabilizer (↥hw.prodSubgroup) s) := by
  refine ⟨MulAction.injective_ofQuotientStabilizer _ s, fun t ↦ ?_⟩
  obtain ⟨δ, rfl⟩ := hw.exists_smul_eq s t
  exact ⟨QuotientGroup.mk δ, MulAction.ofQuotientStabilizer_mk _ _ _⟩

/-- `thm:constructible`(2): the homogeneous space is `G/H` for the stabiliser `H` of any of its
points `s`, through `γH ↦ γ · s`. -/
def quotientStabilizerEquiv (s : hw.Space) :
    ↥hw.prodSubgroup ⧸ MulAction.stabilizer (↥hw.prodSubgroup) s ≃ hw.Space :=
  Equiv.ofBijective _ (hw.bijective_ofQuotientStabilizer s)

theorem quotientStabilizerEquiv_mk (s : hw.Space) (γ : ↥hw.prodSubgroup) :
    hw.quotientStabilizerEquiv s (QuotientGroup.mk γ) = γ • s := by
  change MulAction.ofQuotientStabilizer (↥hw.prodSubgroup) s (QuotientGroup.mk γ) = γ • s
  exact MulAction.ofQuotientStabilizer_mk _ _ _

/-- The equivalence `G/H ≃ S` is `G`-equivariant. -/
theorem quotientStabilizerEquiv_smul (s : hw.Space) (γ : ↥hw.prodSubgroup)
    (q : ↥hw.prodSubgroup ⧸ MulAction.stabilizer (↥hw.prodSubgroup) s) :
    hw.quotientStabilizerEquiv s (γ • q) = γ • hw.quotientStabilizerEquiv s q := by
  change MulAction.ofQuotientStabilizer (↥hw.prodSubgroup) s (γ • q) =
    γ • MulAction.ofQuotientStabilizer (↥hw.prodSubgroup) s q
  exact MulAction.ofQuotientStabilizer_smul _ _ _ _

end IsHW

end Germ

end

end GroupConfig
