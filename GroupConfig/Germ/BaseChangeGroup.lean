import GroupConfig.Germ.BaseChangeHW
import GroupConfig.Germ.HomogeneousSpace

/-!
# Base change of the group and the homogeneous space of a Hrushovski–Weil datum

Blueprint `sources/group_configuration/08-proof.tex`, `lem:hw-basechange`, the statements about
`G` and `S`.

Let `g₀` be a Hrushovski–Weil datum over `K₀` (`def:hw-hyp`) whose canonical base is independent
from a small algebraically closed field `K₁ ⊇ K₀`, and let `g₀''` be its base change over `K₁`
(`Germ.IsHW.baseChange`).

* Base change of germs is an injective monoid homomorphism (`Germ.baseChangeHom`).
* It maps the group `G` of `g₀` onto the group of `g₀''`
  (`Germ.IsHW.baseChange_mem_prodSet`, `Germ.IsHW.exists_of_mem_prodSet_baseChange`). Hence the
  generic set of `g₀''` generates `G` (`Germ.IsHW.prodSubgroupEquiv`).
* On pairs whose point is generic over `K₁`, the equivalence relation `E''` of `thm:hw`
  computed over `K₁` coincides with `E` (`Germ.IsHW.rel_lowerPair_iff`).
* The homogeneous space over `K₁` is therefore equivariantly in bijection with the homogeneous
  space over `K₀`, compatibly with the embeddings of the generic points
  (`Germ.IsHW.spaceEquiv`).

This module is part of the formalization of the group configuration theorem
blueprint `sources/group_configuration_blueprint.tex`.

**Status:** the statements of `lem:hw-basechange` about `G`, `E` and `S` are complete under the
hypotheses of `GroupConfig.Germ.BaseChangeHW`: the representing tuple `a` is independent from
`K₁` over `K₀`. The source's arbitrary small `K₁` is `GroupConfig.Germ.BaseChangeArbitrary`.
-/

namespace GroupConfig

open AclGeom IntermediateField Set

noncomputable section

variable {k K : Type*} [Field k] [Field K] [Algebra k K] [IsAlgClosed K] {ι : Type*} [Finite ι]
  {a : ι → K} (K₀ K₁ : IntermediateField k K) [IsAlgClosed (↥K₀)] [IsAlgClosed (↥K₁)]
  [UniversalDomain (↥K₀) K] [UniversalDomain (↥K₁) K] (h₀₁ : K₀ ≤ K₁)
  (hK₁ : IsSmall (↥K₀) (K₁ : Set K)) (ha : IndepOver (↥K₀) ∅ (range a) (K₁ : Set K))

namespace Germ

/-- Base change of germs on `V` as a monoid homomorphism. -/
def baseChangeHom : Germ (↥K₀) a a →* Germ (↥K₁) a a where
  toFun g := g.baseChange K₀ K₁ h₀₁ hK₁ ha ha
  map_one' := id_baseChange K₀ K₁ h₀₁ hK₁ ha
  map_mul' g g' := comp_baseChange K₀ K₁ h₀₁ hK₁ ha ha ha g g'

theorem baseChangeHom_apply (g : Germ (↥K₀) a a) :
    baseChangeHom K₀ K₁ h₀₁ hK₁ ha g = g.baseChange K₀ K₁ h₀₁ hK₁ ha ha := rfl

namespace IsHW

variable {g₀ : Germ (↥K₀) a a} (hw : IsHW g₀)
  (h₀ : IndepOver (↥K₀) ∅ (g₀.cb : Set K) (K₁ : Set K))
include hw h₀

/-! ### The group -/

/-- `lem:hw-basechange`: base change maps the group generated by the generic set into the group
generated by the generic set of the base change. -/
theorem baseChange_mem_prodSet {γ : Germ (↥K₀) a a} (hγ : γ ∈ prodSet g₀) :
    γ.baseChange K₀ K₁ h₀₁ hK₁ ha ha ∈ prodSet (g₀.baseChange K₀ K₁ h₀₁ hK₁ ha ha) := by
  /- A member `h` of the generic set independent from `γ` and `K₁`, with `h γ` in the generic
  set and independent from `K₁` (`lem:keyrank`), so that `γ = h⁻¹ (h γ)`. -/
  obtain ⟨h, hh, hind⟩ := exists_mem_orbit_indepOver g₀ (γ.isSmall_cb.union hK₁)
  obtain ⟨hmem, hmemK⟩ := hw.keyrank hγ hh hind
  obtain ⟨h', hh'⟩ := isUnit_iff.1 (hw.isUnit_of_mem hh)
  have hγeq : γ = h' * (h * γ) := by
    rw [← mul_assoc, show h' * h = 1 from hh'.1, one_mul]
  refine ⟨_, baseChange_mem_orbit K₀ K₁ h₀₁ hK₁ ha ha h₀ (hw.inv h hh h' hh')
    (indepOver_of_cb_le hh'.cb_le (hind.mono_right subset_union_right)), _,
    baseChange_mem_orbit K₀ K₁ h₀₁ hK₁ ha ha h₀ hmem hmemK, ?_⟩
  rw [← baseChangeHom_apply K₀ K₁ h₀₁ hK₁ ha, ← baseChangeHom_apply K₀ K₁ h₀₁ hK₁ ha,
    ← baseChangeHom_apply K₀ K₁ h₀₁ hK₁ ha, ← map_mul, ← hγeq]

omit hw in
/-- `lem:hw-basechange`: every element of the group of the base change is a base change. -/
theorem exists_of_mem_prodSet_baseChange {γ : Germ (↥K₁) a a}
    (hγ : γ ∈ prodSet (g₀.baseChange K₀ K₁ h₀₁ hK₁ ha ha)) :
    ∃ γ₀ ∈ prodSet g₀, γ₀.baseChange K₀ K₁ h₀₁ hK₁ ha ha = γ := by
  obtain ⟨f₁, hf₁, f₂, hf₂, rfl⟩ := hγ
  obtain ⟨g₁, hg₁, -, rfl⟩ := exists_of_mem_orbit_baseChange K₀ K₁ h₀₁ hK₁ ha ha h₀ hf₁
  obtain ⟨g₂, hg₂, -, rfl⟩ := exists_of_mem_orbit_baseChange K₀ K₁ h₀₁ hK₁ ha ha h₀ hf₂
  exact ⟨g₁ * g₂, ⟨g₁, hg₁, g₂, hg₂, rfl⟩, map_mul (baseChangeHom K₀ K₁ h₀₁ hK₁ ha) g₁ g₂⟩

/-- Base change on the group generated by the generic set. -/
def prodSubgroupHom :
    ↥hw.prodSubgroup →* ↥(hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).prodSubgroup :=
  ((Units.map (baseChangeHom K₀ K₁ h₀₁ hK₁ ha)).comp hw.prodSubgroup.subtype).codRestrict _
    fun δ ↦ baseChange_mem_prodSet K₀ K₁ h₀₁ hK₁ ha hw h₀ (hw.val_mem δ)

theorem val_prodSubgroupHom (δ : ↥hw.prodSubgroup) :
    (hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).val (prodSubgroupHom K₀ K₁ h₀₁ hK₁ ha hw h₀ δ) =
      (hw.val δ).baseChange K₀ K₁ h₀₁ hK₁ ha ha := rfl

theorem prodSubgroupHom_bijective :
    Function.Bijective (prodSubgroupHom K₀ K₁ h₀₁ hK₁ ha hw h₀) := by
  refine ⟨fun δ δ' h ↦ hw.val_injective ?_, fun ε ↦ ?_⟩
  · have h' := congrArg (hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).val h
    rw [val_prodSubgroupHom, val_prodSubgroupHom] at h'
    exact baseChange_injective K₀ K₁ h₀₁ hK₁ ha ha h'
  · obtain ⟨γ₀, hγ₀, hγ₀eq⟩ := exists_of_mem_prodSet_baseChange K₀ K₁ h₀₁ hK₁ ha h₀
      ((hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).val_mem ε)
    refine ⟨hw.ofMem hγ₀, (hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).val_injective ?_⟩
    rw [val_prodSubgroupHom, val_ofMem, hγ₀eq]

/-- `lem:hw-basechange`: the generic set of the base change generates the group `G`; base change
is an isomorphism of the groups. -/
def prodSubgroupEquiv :
    ↥hw.prodSubgroup ≃* ↥(hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).prodSubgroup :=
  MulEquiv.ofBijective _ (prodSubgroupHom_bijective K₀ K₁ h₀₁ hK₁ ha hw h₀)

theorem val_prodSubgroupEquiv (δ : ↥hw.prodSubgroup) :
    (hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).val (prodSubgroupEquiv K₀ K₁ h₀₁ hK₁ ha hw h₀ δ) =
      (hw.val δ).baseChange K₀ K₁ h₀₁ hK₁ ha ha := rfl

/-! ### The equivalence relation and the homogeneous space -/

omit hw in
/-- The pair over `K₀` underlying a pair over `K₁`. -/
def lowerPair (p : Pair (g₀.baseChange K₀ K₁ h₀₁ hK₁ ha ha)) : Pair g₀ where
  γ := Classical.choose (exists_of_mem_prodSet_baseChange K₀ K₁ h₀₁ hK₁ ha h₀ p.mem)
  mem := (Classical.choose_spec (exists_of_mem_prodSet_baseChange K₀ K₁ h₀₁ hK₁ ha h₀ p.mem)).1
  pt := p.pt
  isGen := ((isGen_base_iff K₀ K₁ h₀₁ hK₁ ha).1 p.isGen).1

omit hw in
theorem baseChange_lowerPair (p : Pair (g₀.baseChange K₀ K₁ h₀₁ hK₁ ha ha)) :
    (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p).γ.baseChange K₀ K₁ h₀₁ hK₁ ha ha = p.γ :=
  (Classical.choose_spec (exists_of_mem_prodSet_baseChange K₀ K₁ h₀₁ hK₁ ha h₀ p.mem)).2

omit hw in
/-- The base of a pair and of its underlying pair have the same closure over `K₁`. -/
theorem racl_base_lowerPair (p : Pair (g₀.baseChange K₀ K₁ h₀₁ hK₁ ha ha)) :
    racl (↥K₁) (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p).base = racl (↥K₁) p.base := by
  refine racl_union_congr ?_ rfl
  exact (racl_cb_baseChange K₀ K₁ h₀₁ hK₁ ha ha _).symm.trans
    (congrArg (fun f : Germ (↥K₁) a a ↦ racl (↥K₁) (f.cb : Set K))
      (baseChange_lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p))

/-- The defining equation of `E''` for the base change of a witness independent from `K₁` and
from the underlying pair is the defining equation of `E`. -/
theorem evalGen_mul_lowerPair (p : Pair (g₀.baseChange K₀ K₁ h₀₁ hK₁ ha ha)) {h : Germ (↥K₀) a a}
    (hh : h ∈ orbit g₀)
    (hind : IndepOver (↥K₀) ∅ (h.cb : Set K)
      ((K₁ : Set K) ∪ (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p).base)) :
    (h.baseChange K₀ K₁ h₀₁ hK₁ ha ha * p.γ).evalGen p.pt =
      (h * (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p).γ).evalGen p.pt := by
  obtain ⟨q, hq⟩ : ∃ q, q = lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p := ⟨_, rfl⟩
  have hbc : q.γ.baseChange K₀ K₁ h₀₁ hK₁ ha ha = p.γ := by
    rw [hq]
    exact baseChange_lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p
  have hpt : q.pt = p.pt := by
    rw [hq]
    rfl
  rw [← hq] at hind ⊢
  /- `h q.γ` is independent from `K₁` and from the point (`lem:keyrank`). -/
  have hind' : IndepOver (↥K₀) ∅ (h.cb : Set K)
      ((q.γ.cb : Set K) ∪ ((K₁ : Set K) ∪ range q.pt)) :=
    hind.mono_right (union_subset (q.cb_subset_base.trans subset_union_right)
      (union_subset subset_union_left (q.range_subset_base.trans subset_union_right)))
  obtain ⟨-, hK⟩ := hw.keyrank q.mem hh hind'
  have hK' : IndepOver (↥K₀) (K₁ : Set K) (range p.pt) ((h * q.γ).cb : Set K) := by
    have := (indepOver_union_right_iff.1 hK).2
    rw [empty_union, hpt] at this
    exact this.symm
  have hy : IndepOver (↥K₁) ∅ (range p.pt)
      (((h * q.γ).baseChange K₀ K₁ h₀₁ hK₁ ha ha).cb : Set K) :=
    (indepOver_cb_baseChange_iff K₀ K₁ h₀₁ hK₁ ha ha _ _).2 hK'
  rw [← hbc, ← baseChangeHom_apply K₀ K₁ h₀₁ hK₁ ha, ← baseChangeHom_apply K₀ K₁ h₀₁ hK₁ ha,
    ← map_mul, baseChangeHom_apply]
  exact evalGen_baseChange K₀ K₁ h₀₁ hK₁ ha ha _ p.isGen hy

/-- `lem:hw-basechange`: on pairs whose point is generic over `K₁`, the equivalence relation
`E''` of `thm:hw` over `K₁` coincides with `E`. -/
theorem rel_lowerPair_iff (p q : Pair (g₀.baseChange K₀ K₁ h₀₁ hK₁ ha ha)) :
    (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p).Rel (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ q) ↔ p.Rel q := by
  /- A witness independent from `K₁` and from both underlying pairs. -/
  obtain ⟨h, hh, hind⟩ := exists_mem_orbit_indepOver g₀
    (hK₁.union ((lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p).isSmall_base.union
      (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ q).isSmall_base))
  have hhK : IndepOver (↥K₀) ∅ (h.cb : Set K) (K₁ : Set K) := hind.mono_right subset_union_left
  have hhb : IndepOver (↥K₀) ∅ (h.cb : Set K)
      ((lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p).base ∪ (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ q).base) :=
    hind.mono_right subset_union_right
  /- Its base change is a witness over `K₁`. -/
  have hh'' := baseChange_mem_orbit K₀ K₁ h₀₁ hK₁ ha ha h₀ hh hhK
  have hind'' : IndepOver (↥K₁) ∅ ((h.baseChange K₀ K₁ h₀₁ hK₁ ha ha).cb : Set K)
      (p.base ∪ q.base) := by
    have h1 : IndepOver (↥K₀) (K₁ : Set K) (h.cb : Set K)
        ((lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p).base ∪ (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ q).base) := by
      have := (indepOver_union_right_iff.1 hind).2
      rwa [empty_union] at this
    refine (indepOver_congr₀ (racl_cb_baseChange K₀ K₁ h₀₁ hK₁ ha ha h).symm
      (racl_union_congr (racl_base_lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p)
        (racl_base_lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ q))).1 ?_
    exact (indepOver_base_le_iff K₀ K₁ h₀₁ _ _).2 h1
  have hep := evalGen_mul_lowerPair K₀ K₁ h₀₁ hK₁ ha hw h₀ p hh
    (hind.mono_right (union_subset_union_right _ subset_union_left))
  have heq := evalGen_mul_lowerPair K₀ K₁ h₀₁ hK₁ ha hw h₀ q hh
    (hind.mono_right (union_subset_union_right _ subset_union_right))
  constructor
  · intro hr
    refine (hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).rel_of_witness hh'' hind'' ?_
    rw [hep, heq]
    exact hr h hh hhb
  · intro hr
    refine hw.rel_of_witness hh hhb ?_
    have := hr _ hh'' hind''
    rwa [hep, heq] at this

/-- The map from the homogeneous space over `K₁` to the homogeneous space over `K₀`. -/
def spaceMap : (hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).Space → hw.Space :=
  Quotient.lift (fun p ↦ hw.ofPair (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p))
    fun _ _ hr ↦ hw.ofPair_eq_ofPair.2 ((rel_lowerPair_iff K₀ K₁ h₀₁ hK₁ ha hw h₀ _ _).2 hr)

theorem spaceMap_ofPair (p : Pair (g₀.baseChange K₀ K₁ h₀₁ hK₁ ha ha)) :
    spaceMap K₀ K₁ h₀₁ hK₁ ha hw h₀ ((hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).ofPair p) =
      hw.ofPair (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p) := rfl

/-- The underlying pair of a base change of a pair over `K₀`. -/
theorem lowerPair_eq {γ : Germ (↥K₀) a a} (hγ : γ ∈ prodSet g₀) {y : ι → K}
    (hy : IsGen (↥K₁) a y) :
    lowerPair K₀ K₁ h₀₁ hK₁ ha h₀
      ⟨γ.baseChange K₀ K₁ h₀₁ hK₁ ha ha, baseChange_mem_prodSet K₀ K₁ h₀₁ hK₁ ha hw h₀ hγ, y, hy⟩ =
      ⟨γ, hγ, y, ((isGen_base_iff K₀ K₁ h₀₁ hK₁ ha).1 hy).1⟩ :=
  Pair.ext (baseChange_injective K₀ K₁ h₀₁ hK₁ ha ha
    (baseChange_lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ _)) rfl

theorem spaceMap_bijective : Function.Bijective (spaceMap K₀ K₁ h₀₁ hK₁ ha hw h₀) := by
  refine ⟨fun s s' ↦ ?_, fun s ↦ ?_⟩
  · refine (hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).ind (fun p ↦ ?_) s
    refine (hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).ind (fun p' ↦ ?_) s'
    intro h
    rw [spaceMap_ofPair, spaceMap_ofPair] at h
    exact (hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).ofPair_eq_ofPair.2
      ((rel_lowerPair_iff K₀ K₁ h₀₁ hK₁ ha hw h₀ _ _).1 (hw.ofPair_eq_ofPair.1 h))
  · /- A generic point over `K₀` independent from `K₁`, and a translate of its image. -/
    obtain ⟨y, hy⟩ := exists_isGenericOver (k := ↥K₀) hK₁.racl a
    have hyK : IndepOver (↥K₀) ∅ (range y) (K₁ : Set K) :=
      hy.indepOver.mono_right (subset_racl (↥K₀) _)
    have hy₁ : IsGen (↥K₁) a y := (isGen_base_iff K₀ K₁ h₀₁ hK₁ ha).2 ⟨hy.isGen, hyK⟩
    obtain ⟨δ, rfl⟩ := hw.exists_smul_eq (hw.iota hy.isGen) s
    refine ⟨(hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).ofPair
      ⟨(hw.val δ).baseChange K₀ K₁ h₀₁ hK₁ ha ha,
        baseChange_mem_prodSet K₀ K₁ h₀₁ hK₁ ha hw h₀ (hw.val_mem δ), y, hy₁⟩, ?_⟩
    rw [spaceMap_ofPair, lowerPair_eq K₀ K₁ h₀₁ hK₁ ha hw h₀ (hw.val_mem δ) hy₁,
      hw.ofPair_eq_smul_iota]
    congr 1
    exact hw.val_injective (by rw [val_ofMem])

/-- `lem:hw-basechange`: the homogeneous space over `K₁` is in bijection with the homogeneous
space over `K₀`. -/
def spaceEquiv : (hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).Space ≃ hw.Space :=
  Equiv.ofBijective _ (spaceMap_bijective K₀ K₁ h₀₁ hK₁ ha hw h₀)

/-- `lem:hw-basechange`: the bijection of homogeneous spaces is equivariant along the
isomorphism of groups. -/
theorem spaceEquiv_smul (δ : ↥hw.prodSubgroup) (s : (hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).Space) :
    spaceEquiv K₀ K₁ h₀₁ hK₁ ha hw h₀ (prodSubgroupEquiv K₀ K₁ h₀₁ hK₁ ha hw h₀ δ • s) =
      δ • spaceEquiv K₀ K₁ h₀₁ hK₁ ha hw h₀ s := by
  refine (hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).ind (fun p ↦ ?_) s
  change spaceMap K₀ K₁ h₀₁ hK₁ ha hw h₀ ((hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).ofPair
      ((hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).smulPair _ p)) =
    δ • spaceMap K₀ K₁ h₀₁ hK₁ ha hw h₀ ((hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).ofPair p)
  rw [spaceMap_ofPair, spaceMap_ofPair, smul_ofPair]
  refine congrArg hw.ofPair (Pair.ext ?_ rfl)
  refine baseChange_injective K₀ K₁ h₀₁ hK₁ ha ha ?_
  change _ = (hw.val δ * (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p).γ).baseChange K₀ K₁ h₀₁ hK₁ ha ha
  rw [baseChange_lowerPair,
    ← baseChangeHom_apply K₀ K₁ h₀₁ hK₁ ha (hw.val δ * (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p).γ),
    map_mul, baseChangeHom_apply K₀ K₁ h₀₁ hK₁ ha (hw.val δ),
    baseChangeHom_apply K₀ K₁ h₀₁ hK₁ ha (lowerPair K₀ K₁ h₀₁ hK₁ ha h₀ p).γ,
    baseChange_lowerPair]
  rfl

/-- `lem:hw-basechange`: the bijection of homogeneous spaces is compatible with the embeddings
of the generic points. -/
theorem spaceEquiv_iota {y : ι → K} (hy : IsGen (↥K₁) a y) :
    spaceEquiv K₀ K₁ h₀₁ hK₁ ha hw h₀ ((hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).iota hy) =
      hw.iota ((isGen_base_iff K₀ K₁ h₀₁ hK₁ ha).1 hy).1 := by
  change spaceMap K₀ K₁ h₀₁ hK₁ ha hw h₀ ((hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).ofPair
    ((hw.baseChange K₀ K₁ h₀₁ hK₁ ha h₀).onePair hy)) = _
  rw [spaceMap_ofPair]
  refine congrArg hw.ofPair (Pair.ext ?_ rfl)
  refine baseChange_injective K₀ K₁ h₀₁ hK₁ ha ha ?_
  rw [baseChange_lowerPair]
  exact (id_baseChange K₀ K₁ h₀₁ hK₁ ha).symm

