import Mathlib.RingTheory.MvPolynomial.Basic
import Mathlib.Algebra.MvPolynomial.Degrees
import Mathlib.LinearAlgebra.Basis.VectorSpace
import GroupConfig.Rref

/-!
# Fields of definition of ideals

Blueprint `sources/group_configuration/02-fields-of-definition.tex`,
`lem:ideal-filtration`, `def:fod`, `thm:weil-fod`.

An ideal `I` of `K[X]` (`X` indexed by a finite type) is filtered by total
degree; the degree-`d` piece is encoded as the subspace `degSubspace I d` of
coefficient vectors indexed by the monomials of degree at most `d`.  An ideal
is *defined over* a subfield `F` if it is generated by its polynomials with
coefficients in `F` (`IdealDefinedOver`).  The two notions are compatible
(`idealDefinedOver_iff_forall_degSubspace`): the nontrivial direction extracts,
from a representation of a polynomial of degree `≤ d` as a combination of
`F`-polynomials of the ideal, its `F`-components with respect to a basis of
`K` over `F` (`coordPoly`), which are `F`-polynomials of the ideal of degree
`≤ d`.

The *field of definition* `idealFod I` is the subfield generated by the fields
of definition of all the degree pieces; Weil's theorem `idealDefinedOver_iff`
says that `F` is a field of definition of `I` iff `idealFod I ≤ F`.  By
noetherianity the fields of definition along the degree filtration stabilise
(`exists_forall_idealFod_eq`), so
`idealFod I` is finitely generated (`exists_finset_closure_eq_idealFod`).  Field
automorphisms act compatibly (`idealFod_map`), and an automorphism fixes `I` iff
it fixes `idealFod I` pointwise (`ideal_map_eq_self_iff`).

This module is part of the formalization of the group configuration theorem
blueprint `sources/group_configuration_blueprint.tex`.

**Status:** the smallest field of definition of a polynomial ideal in finitely
many variables, its finite generators, and its compatibility with automorphisms
are proved over arbitrary fields. All three degree-filtration clauses are proved,
including monotonicity and the increasing-union description. The scalar-extension
remark and canonical bases remain separate obligations.
-/

namespace GroupConfig

open Module Set MvPolynomial

noncomputable section

variable {K : Type*} [Field K] {ι : Type*}

/-! ### Monomials of bounded degree and coefficient vectors -/

/-- The monomials in the variables `ι` of total degree at most `d`. -/
def Monomials (ι : Type*) (d : ℕ) : Type _ := {m : ι →₀ ℕ // m.sum (fun _ e ↦ e) ≤ d}

instance (d : ℕ) [Finite ι] : Finite (Monomials ι d) := by
  classical
  refine Finite.of_injective
    (fun m : Monomials ι d ↦ fun i : ι ↦ (⟨m.1 i, Nat.lt_succ_of_le ?_⟩ : Fin (d + 1))) ?_
  · refine le_trans ?_ m.2
    by_cases hi : i ∈ m.1.support
    · exact Finset.single_le_sum (f := fun j ↦ m.1 j) (fun _ _ ↦ Nat.zero_le _) hi
    · simp [Finsupp.notMem_support_iff.1 hi]
  · intro m m' h
    exact Subtype.ext (Finsupp.ext fun i ↦ by simpa using congrArg (fun f ↦ (f i).1) h)

/-- A (classically chosen) linear order on the monomials of bounded degree, used only to
compute reduced row echelon bases. -/
instance (d : ℕ) [Finite ι] : LinearOrder (Monomials ι d) :=
  LinearOrder.lift' (Finite.equivFin (Monomials ι d)) (Finite.equivFin _).injective

/-- The coefficient vector of a polynomial on the monomials of degree at most `d`. -/
def coeffVec (d : ℕ) : MvPolynomial ι K →ₗ[K] (Monomials ι d → K) :=
  LinearMap.pi fun m ↦ lcoeff K m.1

@[simp]
theorem coeffVec_apply (d : ℕ) (f : MvPolynomial ι K) (m : Monomials ι d) :
    coeffVec d f m = f.coeff m.1 := rfl

/-- Polynomials of degree at most `d` are determined by their coefficient vectors. -/
theorem coeffVec_injOn (d : ℕ) :
    InjOn (coeffVec (K := K) (ι := ι) d) (restrictTotalDegree ι K d : Set (MvPolynomial ι K)) := by
  intro f hf g hg h
  rw [SetLike.mem_coe, mem_restrictTotalDegree] at hf hg
  ext m
  by_cases hm : m.sum (fun _ e ↦ e) ≤ d
  · exact congrFun h ⟨m, hm⟩
  · push Not at hm
    rw [coeff_eq_zero_of_totalDegree_lt (lt_of_le_of_lt hf hm),
      coeff_eq_zero_of_totalDegree_lt (lt_of_le_of_lt hg hm)]

/-- The degree-`d` piece of an ideal, as a subspace of the coefficient space. -/
def degSubspace (I : Ideal (MvPolynomial ι K)) (d : ℕ) : Submodule K (Monomials ι d → K) :=
  (I.restrictScalars K ⊓ restrictTotalDegree ι K d).map (coeffVec d)

theorem mem_degSubspace_iff {I : Ideal (MvPolynomial ι K)} {d : ℕ} {w : Monomials ι d → K} :
    w ∈ degSubspace I d ↔ ∃ f ∈ I, f.totalDegree ≤ d ∧ coeffVec d f = w := by
  simp only [degSubspace, Submodule.mem_map, Submodule.mem_inf, Submodule.restrictScalars_mem,
    mem_restrictTotalDegree]
  constructor
  · rintro ⟨f, ⟨hfI, hfd⟩, rfl⟩
    exact ⟨f, hfI, hfd, rfl⟩
  · rintro ⟨f, hfI, hfd, rfl⟩
    exact ⟨f, ⟨hfI, hfd⟩, rfl⟩

theorem coeffVec_mem_degSubspace {I : Ideal (MvPolynomial ι K)} {d : ℕ} {f : MvPolynomial ι K}
    (hfI : f ∈ I) (hfd : f.totalDegree ≤ d) : coeffVec d f ∈ degSubspace I d :=
  mem_degSubspace_iff.2 ⟨f, hfI, hfd, rfl⟩

/-! ### Polynomials with coefficients in a subfield -/

section Subfield

variable (F : Subfield K)

/-- Scalar extension of polynomials along the inclusion of a subfield. -/
abbrev mapF : MvPolynomial ι F →+* MvPolynomial ι K := MvPolynomial.map F.subtype

theorem coeff_mapF (g : MvPolynomial ι F) (m : ι →₀ ℕ) : (mapF F g).coeff m = (g.coeff m : K) :=
  coeff_map _ _ _

/-- A polynomial all of whose coefficients lie in `F` is the extension of an `F`-polynomial. -/
theorem exists_mapF_eq_of_coeff_mem {f : MvPolynomial ι K} (hf : ∀ m, f.coeff m ∈ F) :
    ∃ g : MvPolynomial ι F, mapF F g = f := by
  apply mem_range_map_iff_coeffs_subset.mpr
  intro c hc
  obtain ⟨m, -, rfl⟩ := mem_coeffs_iff.mp hc
  exact ⟨⟨f.coeff m, hf m⟩, rfl⟩

theorem totalDegree_mapF (g : MvPolynomial ι F) : (mapF F g).totalDegree = g.totalDegree := by
  unfold totalDegree
  rw [support_map_of_injective _ F.subtype_injective]

/-- `I` is *defined over* `F` if it is generated by its polynomials with coefficients in `F`. -/
def IdealDefinedOver (I : Ideal (MvPolynomial ι K)) : Prop :=
  I = (I.comap (mapF F)).map (mapF F)

theorem idealDefinedOver_iff_le {I : Ideal (MvPolynomial ι K)} :
    IdealDefinedOver F I ↔ I ≤ (I.comap (mapF F)).map (mapF F) := by
  constructor
  · intro h
    exact h.le
  · intro h
    exact le_antisymm h Ideal.map_comap_le

/-- The ideal generated by the `F`-polynomials of `I`, described inside `K[X]`. -/
theorem map_comap_eq_span (I : Ideal (MvPolynomial ι K)) :
    (I.comap (mapF F)).map (mapF F) = Ideal.span {f | f ∈ I ∧ ∀ m, f.coeff m ∈ F} := by
  change Ideal.span _ = _
  congr 1
  ext f
  constructor
  · rintro ⟨g, hg, rfl⟩
    exact ⟨Ideal.mem_comap.1 hg, fun m ↦ by rw [coeff_mapF]; exact Subtype.mem _⟩
  · rintro ⟨hfI, hf⟩
    obtain ⟨g, rfl⟩ := exists_mapF_eq_of_coeff_mem F hf
    exact ⟨g, Ideal.mem_comap.2 hfI, rfl⟩

/-- `I` is defined over `F` iff it is generated by its polynomials with coefficients in `F`. -/
theorem idealDefinedOver_iff_span {I : Ideal (MvPolynomial ι K)} :
    IdealDefinedOver F I ↔ I = Ideal.span {f | f ∈ I ∧ ∀ m, f.coeff m ∈ F} := by
  unfold IdealDefinedOver
  rw [map_comap_eq_span]

theorem idealDefinedOver_of_le_span {I : Ideal (MvPolynomial ι K)}
    (h : I ≤ Ideal.span {f | f ∈ I ∧ ∀ m, f.coeff m ∈ F}) : IdealDefinedOver F I := by
  rw [idealDefinedOver_iff_le, map_comap_eq_span]
  exact h

/-- The polynomials of an ideal defined over `F` with coefficients in `F` generate it. -/
theorem IdealDefinedOver.span_eq {I : Ideal (MvPolynomial ι K)} (h : IdealDefinedOver F I) :
    Ideal.span {f | f ∈ I ∧ ∀ m, f.coeff m ∈ F} = I :=
  ((idealDefinedOver_iff_span F).1 h).symm

/-! ### Coefficient projections -/

end Subfield

section Coord

variable {R : Type*} [CommRing R] [Algebra R K]

/-- Apply an `R`-linear functional of `K` to every coefficient of a polynomial. -/
def coordPoly (l : K →ₗ[R] R) (p : MvPolynomial ι K) : MvPolynomial ι R :=
  ∑ m ∈ p.support, monomial m (l (p.coeff m))

theorem coeff_coordPoly (l : K →ₗ[R] R) (p : MvPolynomial ι K) (m : ι →₀ ℕ) :
    (coordPoly l p).coeff m = l (p.coeff m) := by
  classical
  unfold coordPoly
  rw [coeff_sum]
  simp only [coeff_monomial]
  by_cases hm : m ∈ p.support
  · rw [Finset.sum_eq_single m]
    · simp
    · intro m' _ hm'
      simp [hm']
    · intro h
      exact absurd hm h
  · rw [Finset.sum_eq_zero]
    · rw [notMem_support_iff.1 hm, map_zero]
    · intro m' hm'
      have : m' ≠ m := fun h ↦ hm (h ▸ hm')
      simp [this]

theorem coordPoly_add (l : K →ₗ[R] R) (p q : MvPolynomial ι K) :
    coordPoly l (p + q) = coordPoly l p + coordPoly l q := by
  refine MvPolynomial.ext _ _ fun m ↦ ?_
  simp [coeff_coordPoly]

theorem coordPoly_sum (l : K →ₗ[R] R) {α : Type*} (s : Finset α) (p : α → MvPolynomial ι K) :
    coordPoly l (∑ i ∈ s, p i) = ∑ i ∈ s, coordPoly l (p i) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    refine MvPolynomial.ext _ _ fun m ↦ ?_
    simp [coeff_coordPoly]
  | insert i s hi ih =>
    rw [Finset.sum_insert hi, Finset.sum_insert hi, coordPoly_add, ih]

/-- The coefficient projection is `R[X]`-linear: it commutes with multiplication by
`R`-polynomials. -/
theorem coordPoly_mul_map (l : K →ₗ[R] R) (c : MvPolynomial ι K) (g : MvPolynomial ι R) :
    coordPoly l (c * MvPolynomial.map (algebraMap R K) g) = coordPoly l c * g := by
  classical
  refine MvPolynomial.ext _ _ fun m ↦ ?_
  simp only [coeff_coordPoly, coeff_mul, map_sum, coeff_map]
  refine Finset.sum_congr rfl fun x _ ↦ ?_
  have : c.coeff x.1 * algebraMap R K (g.coeff x.2) = (g.coeff x.2) • c.coeff x.1 := by
    rw [Algebra.smul_def, mul_comm]
  rw [this, map_smul, smul_eq_mul, mul_comm]

/-- Coefficient projections of elements of an extended ideal lie in the ideal. -/
theorem coordPoly_mem_of_mem_map (l : K →ₗ[R] R) {J : Ideal (MvPolynomial ι R)}
    {f : MvPolynomial ι K} (hf : f ∈ J.map (MvPolynomial.map (algebraMap R K))) :
    coordPoly l f ∈ J := by
  have hf' : f ∈ Submodule.span (MvPolynomial ι K)
      (MvPolynomial.map (algebraMap R K) '' (J : Set (MvPolynomial ι R))) := hf
  obtain ⟨n, c, g, hsum⟩ := Submodule.mem_span_set'.1 hf'
  choose gJ hgJ hgJeq using fun i ↦ (Set.mem_image _ _ _).1 (g i).2
  rw [← hsum, coordPoly_sum]
  refine Submodule.sum_mem _ fun i _ ↦ ?_
  rw [smul_eq_mul, ← hgJeq i, coordPoly_mul_map]
  exact J.mul_mem_left _ (hgJ i)

theorem totalDegree_coordPoly_le (l : K →ₗ[R] R) (p : MvPolynomial ι K) :
    (coordPoly l p).totalDegree ≤ p.totalDegree := by
  refine Finset.sup_le fun m hm ↦ le_totalDegree ?_
  rw [mem_support_iff, coeff_coordPoly] at hm
  rw [mem_support_iff]
  exact fun h ↦ hm (by rw [h, map_zero])

/-- A polynomial is recovered from its coefficient projections along a basis of `K` over
`R`. -/
theorem sum_smul_map_coordPoly {J : Type*} [DecidableEq J] (b : Basis J R K)
    (p : MvPolynomial ι K) :
    ∑ j ∈ p.support.biUnion (fun m ↦ (b.repr (p.coeff m)).support),
      b j • MvPolynomial.map (algebraMap R K) (coordPoly (b.coord j) p) = p := by
  classical
  refine MvPolynomial.ext _ _ fun m ↦ ?_
  simp only [coeff_sum, coeff_smul, coeff_map, coeff_coordPoly, Basis.coord_apply, smul_eq_mul]
  have hx := b.linearCombination_repr (p.coeff m)
  rw [Finsupp.linearCombination_apply] at hx
  by_cases hm : m ∈ p.support
  · have hsub : (b.repr (p.coeff m)).support ⊆
        p.support.biUnion fun m ↦ (b.repr (p.coeff m)).support :=
      Finset.subset_biUnion_of_mem (fun m ↦ (b.repr (p.coeff m)).support) hm
    rw [Finsupp.sum_of_support_subset _ hsub (fun i a ↦ a • b i) (by simp)] at hx
    conv_rhs => rw [← hx]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [Algebra.smul_def, mul_comm]
  · rw [notMem_support_iff.1 hm]
    refine Finset.sum_eq_zero fun j _ ↦ ?_
    simp

end Coord

section Subfield

variable (F : Subfield K)

/-- The coefficient projection commutes with multiplication by `F`-polynomials. -/
theorem coordPoly_mul_mapF (l : K →ₗ[F] F) (c : MvPolynomial ι K) (g : MvPolynomial ι F) :
    coordPoly l (c * mapF F g) = coordPoly l c * g :=
  coordPoly_mul_map l c g

/-! ### Degree pieces of ideals defined over a subfield -/

/-- A polynomial of `I` of degree at most `d` lies in the ideal generated by the
`F`-polynomials of `I` as soon as the degree-`d` piece of `I` is defined over `F`. -/
theorem mem_map_comap_of_definedOver {I : Ideal (MvPolynomial ι K)} {d : ℕ}
    (h : DefinedOver (degSubspace I d) F) {f : MvPolynomial ι K} (hf : f ∈ I)
    (hfd : f.totalDegree ≤ d) : f ∈ (I.comap (mapF F)).map (mapF F) := by
  set T : Set (MvPolynomial ι F) :=
    {g | g ∈ I.comap (mapF F) ∧ (mapF F g).totalDegree ≤ d}
  -- `F`-valued vectors of the degree piece come from `F`-polynomials of the ideal.
  have hS : {v : Monomials ι d → K | v ∈ degSubspace I d ∧ ∀ m, v m ∈ F} ⊆
      coeffVec d '' (mapF F '' T) := by
    rintro v ⟨hv, hvF⟩
    obtain ⟨f₁, hf₁I, hf₁d, rfl⟩ := mem_degSubspace_iff.1 hv
    have hcoef : ∀ m, f₁.coeff m ∈ F := by
      intro m
      by_cases hm : m.sum (fun _ e ↦ e) ≤ d
      · exact hvF ⟨m, hm⟩
      · push Not at hm
        rw [coeff_eq_zero_of_totalDegree_lt (lt_of_le_of_lt hf₁d hm)]
        exact F.zero_mem
    obtain ⟨g, rfl⟩ := exists_mapF_eq_of_coeff_mem F hcoef
    exact ⟨mapF F g, ⟨g, ⟨Ideal.mem_comap.2 hf₁I, hf₁d⟩, rfl⟩, rfl⟩
  have hdef : degSubspace I d =
      Submodule.span K {v : Monomials ι d → K | v ∈ degSubspace I d ∧ ∀ m, v m ∈ F} := h
  have hw : coeffVec d f ∈
      Submodule.span K {v : Monomials ι d → K | v ∈ degSubspace I d ∧ ∀ m, v m ∈ F} := by
    rw [← hdef]
    exact coeffVec_mem_degSubspace hf hfd
  have hw' := Submodule.span_mono hS hw
  rw [← Submodule.map_span (coeffVec d)] at hw'
  obtain ⟨f', hf', hff'⟩ := Submodule.mem_map.1 hw'
  -- `f'` has degree at most `d`, so it is `f`.
  have hTdeg : Submodule.span K (mapF F '' T) ≤ restrictTotalDegree ι K d := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨g, ⟨-, hgd⟩, rfl⟩
    rw [SetLike.mem_coe, mem_restrictTotalDegree]
    exact hgd
  have hfd' : f ∈ restrictTotalDegree ι K d := (mem_restrictTotalDegree ι d f).2 hfd
  have heq : f' = f := coeffVec_injOn d (hTdeg hf') hfd' hff'
  have hsub : Submodule.span K (mapF F '' T) ≤
      ((I.comap (mapF F)).map (mapF F)).restrictScalars K := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨g, ⟨hg, -⟩, rfl⟩
    exact Ideal.mem_map_of_mem _ hg
  rw [← heq]
  exact hsub hf'

/-- `lem:ideal-filtration`, easy direction: if every degree piece is spanned by `F`-valued
vectors, the ideal is generated by `F`-polynomials. -/
theorem idealDefinedOver_of_degSubspace {I : Ideal (MvPolynomial ι K)}
    (h : ∀ d, DefinedOver (degSubspace I d) F) : IdealDefinedOver F I := by
  rw [idealDefinedOver_iff_le]
  exact fun f hf ↦ mem_map_comap_of_definedOver F (h _) hf le_rfl

/-- `lem:ideal-filtration` (3): if `I` is generated by polynomials of degree at most `d`, then
`I` is defined over `F` as soon as its degree-`d` piece is. -/
theorem idealDefinedOver_of_span {I : Ideal (MvPolynomial ι K)} {S : Set (MvPolynomial ι K)}
    (hS : Ideal.span S = I) {d : ℕ} (hd : ∀ f ∈ S, f.totalDegree ≤ d)
    (h : DefinedOver (degSubspace I d) F) : IdealDefinedOver F I := by
  subst hS
  rw [idealDefinedOver_iff_le]
  exact Ideal.span_le.2 fun f hf ↦
    mem_map_comap_of_definedOver F h (Ideal.subset_span hf) (hd f hf)

/-- `lem:ideal-filtration`, main direction: if `I` is generated by `F`-polynomials, every
degree piece is spanned by `F`-valued vectors. -/
theorem degSubspace_definedOver {I : Ideal (MvPolynomial ι K)} (h : IdealDefinedOver F I)
    (d : ℕ) : DefinedOver (degSubspace I d) F := by
  classical
  unfold DefinedOver
  refine le_antisymm ?_ (Submodule.span_le.2 fun v hv ↦ hv.1)
  intro w hw
  obtain ⟨f, hfI, hfd, rfl⟩ := mem_degSubspace_iff.1 hw
  set J := I.comap (mapF F)
  have hIJ : I = J.map (mapF F) := h
  -- The `F`-components of `f` are `F`-polynomials of the ideal of degree at most `d`.
  have hcomp : ∀ l : K →ₗ[F] F, coordPoly l f ∈ J := fun l ↦
    coordPoly_mem_of_mem_map l (hIJ ▸ hfI)
  have hmem : ∀ l : K →ₗ[F] F, coeffVec d (mapF F (coordPoly l f)) ∈ degSubspace I d :=
    fun l ↦ coeffVec_mem_degSubspace (Ideal.mem_comap.1 (hcomp l))
      ((totalDegree_mapF F _).trans_le ((totalDegree_coordPoly_le l f).trans hfd))
  have hval : ∀ l : K →ₗ[F] F, ∀ m, coeffVec d (mapF F (coordPoly l f)) m ∈ F := by
    intro l m
    rw [coeffVec_apply, coeff_mapF]
    exact Subtype.mem _
  -- Reconstruct `f` from its components along a basis of `K` over `F`.
  let b := Basis.ofVectorSpace F K
  let J₀ : Finset (Basis.ofVectorSpaceIndex F K) :=
    f.support.biUnion fun m ↦ (b.repr (f.coeff m)).support
  have hrepr : coeffVec d f =
      ∑ j ∈ J₀, (b j : K) • coeffVec d (mapF F (coordPoly (b.coord j) f)) := by
    funext m
    simp only [Finset.sum_apply, Pi.smul_apply, coeffVec_apply, coeff_mapF, coeff_coordPoly,
      Basis.coord_apply, smul_eq_mul]
    have hx := b.linearCombination_repr (f.coeff m.1)
    rw [Finsupp.linearCombination_apply] at hx
    by_cases hm : m.1 ∈ f.support
    · have hsub : (b.repr (f.coeff m.1)).support ⊆ J₀ :=
        Finset.subset_biUnion_of_mem (fun m ↦ (b.repr (f.coeff m)).support) hm
      rw [Finsupp.sum_of_support_subset _ hsub (fun i a ↦ a • b i) (by simp)] at hx
      conv_lhs => rw [← hx]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      rw [Subfield.smul_def, smul_eq_mul, mul_comm]
    · rw [notMem_support_iff.1 hm]
      refine (Finset.sum_eq_zero fun j _ ↦ ?_).symm
      simp
  rw [hrepr]
  exact Submodule.sum_mem _ fun j _ ↦
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨hmem _, hval _⟩)

/-- Supplemental `lem:ideal-filtration`(2): a smaller degree piece is defined
over every field defining the larger piece. -/
theorem degSubspace_definedOver_of_le (F : Subfield K)
    {I : Ideal (MvPolynomial ι K)} {d d' : ℕ} (hd : d' ≤ d)
    (h : DefinedOver (degSubspace I d) F) : DefinedOver (degSubspace I d') F := by
  let J := (I.comap (mapF F)).map (mapF F)
  have hJ : IdealDefinedOver F J := by
    unfold IdealDefinedOver J
    exact (Ideal.map_comap_map (I := I.comap (mapF F)) (f := mapF F)).symm
  have heq : degSubspace I d' = degSubspace J d' := by
    ext v
    rw [mem_degSubspace_iff, mem_degSubspace_iff]
    constructor
    · rintro ⟨f, hf, hfd, hfv⟩
      exact ⟨f, mem_map_comap_of_definedOver F h hf (hfd.trans hd), hfd, hfv⟩
    · rintro ⟨f, hf, hfd, hfv⟩
      exact ⟨f, Ideal.map_comap_le hf, hfd, hfv⟩
  rw [heq]
  exact degSubspace_definedOver F hJ d'

/-- `lem:ideal-filtration`: an ideal is defined over `F` iff all its degree pieces are. -/
theorem idealDefinedOver_iff_forall_degSubspace {I : Ideal (MvPolynomial ι K)} :
    IdealDefinedOver F I ↔ ∀ d, DefinedOver (degSubspace I d) F :=
  ⟨degSubspace_definedOver F, idealDefinedOver_of_degSubspace F⟩

end Subfield

/-! ### Equivariance of the degree pieces -/

section Equivariance

variable (σ : K ≃+* K)

theorem totalDegree_map_ringEquiv (p : MvPolynomial ι K) :
    (MvPolynomial.map σ.toRingHom p).totalDegree = p.totalDegree := by
  unfold totalDegree
  rw [support_map_of_injective _ σ.injective]

theorem coeffVec_map (d : ℕ) (p : MvPolynomial ι K) :
    coeffVec d (MvPolynomial.map σ.toRingHom p) = mapVec σ (coeffVec d p) := by
  funext m
  simp [coeff_map]

/-- The degree pieces of the image ideal are the images of the degree pieces. -/
theorem degSubspace_map (I : Ideal (MvPolynomial ι K)) (d : ℕ) :
    degSubspace (I.map (MvPolynomial.map σ.toRingHom)) d =
      (degSubspace I d).map (mapVec σ) := by
  ext w
  rw [mem_degSubspace_iff, Submodule.mem_map]
  constructor
  · rintro ⟨f, hf, hfd, rfl⟩
    obtain ⟨g, hg, rfl⟩ :=
      (Ideal.mem_map_iff_of_surjective _ (map_surjective σ.toRingHom σ.surjective)).1 hf
    rw [totalDegree_map_ringEquiv] at hfd
    exact ⟨coeffVec d g, coeffVec_mem_degSubspace hg hfd, (coeffVec_map σ d g).symm⟩
  · rintro ⟨v, hv, rfl⟩
    obtain ⟨g, hg, hgd, rfl⟩ := mem_degSubspace_iff.1 hv
    exact ⟨MvPolynomial.map σ.toRingHom g, Ideal.mem_map_of_mem _ hg,
      by rw [totalDegree_map_ringEquiv]; exact hgd, coeffVec_map σ d g⟩

end Equivariance

/-! ### The field of definition of an ideal -/

variable [Finite ι]

/-- Supplemental `lem:ideal-filtration`(2): the fields of definition of degree
pieces increase with degree, even though their coordinate spaces differ. -/
theorem fod_degSubspace_mono (I : Ideal (MvPolynomial ι K)) :
    Monotone fun d ↦ fod (degSubspace I d) := by
  intro d' d hd
  apply DefinedOver.fod_le
  exact degSubspace_definedOver_of_le _ hd (DefinedOver.of_fod_le le_rfl)

/-- `def:fod`: the field of definition of an ideal, generated by the fields of definition
of its degree pieces. -/
def idealFod (I : Ideal (MvPolynomial ι K)) : Subfield K :=
  ⨆ d, fod (degSubspace I d)

theorem fod_degSubspace_le_idealFod (I : Ideal (MvPolynomial ι K)) (d : ℕ) :
    fod (degSubspace I d) ≤ idealFod I :=
  le_iSup (fun d ↦ fod (degSubspace I d)) d

/-- `def:fod`: the field of definition is the increasing union of the fields
of definition of the degree pieces. -/
theorem mem_idealFod_iff (I : Ideal (MvPolynomial ι K)) {x : K} :
    x ∈ idealFod I ↔ ∃ d, x ∈ fod (degSubspace I d) :=
  Subfield.mem_iSup_of_directed (fod_degSubspace_mono I).directed_le

/-- `lem:ideal-filtration`(3): a bounded degree piece generates the ideal, and
all larger degree pieces detect exactly the fields defining the ideal. -/
theorem exists_forall_idealDefinedOver_iff (I : Ideal (MvPolynomial ι K)) :
    ∃ d₀ : ℕ, Ideal.span {f | f ∈ I ∧ f.totalDegree ≤ d₀} = I ∧
      ∀ d, d₀ ≤ d → ∀ F : Subfield K,
        IdealDefinedOver F I ↔ DefinedOver (degSubspace I d) F := by
  classical
  obtain ⟨S, hS⟩ := IsNoetherian.noetherian I
  let d₀ := S.sup fun f ↦ f.totalDegree
  have hspan : Ideal.span {f | f ∈ I ∧ f.totalDegree ≤ d₀} = I := by
    refine le_antisymm (Ideal.span_le.2 fun _ hf ↦ hf.1) ?_
    refine hS.symm.le.trans (Ideal.span_mono ?_)
    intro f hf
    have hfI : f ∈ I := by
      rw [← hS]
      exact Ideal.subset_span hf
    exact ⟨hfI, Finset.le_sup (f := fun f ↦ f.totalDegree) (Finset.mem_coe.1 hf)⟩
  refine ⟨d₀, hspan, fun d hd F ↦ ⟨fun h ↦ degSubspace_definedOver F h d, ?_⟩⟩
  intro h
  exact idealDefinedOver_of_span F hspan (fun _ hf ↦ hf.2.trans hd) h

/-- `thm:weil-fod`: a subfield is a field of definition of `I` iff it contains `idealFod I`. -/
theorem idealDefinedOver_iff {F : Subfield K} {I : Ideal (MvPolynomial ι K)} :
    IdealDefinedOver F I ↔ idealFod I ≤ F := by
  rw [idealDefinedOver_iff_forall_degSubspace]
  constructor
  · intro h
    exact iSup_le fun d ↦ (h d).fod_le
  · intro h d
    exact DefinedOver.of_fod_le ((fod_degSubspace_le_idealFod I d).trans h)

/-- `idealFod I` is itself a field of definition of `I`. -/
theorem idealDefinedOver_idealFod (I : Ideal (MvPolynomial ι K)) :
    IdealDefinedOver (idealFod I) I :=
  idealDefinedOver_iff.2 le_rfl

/-- `lem:ideal-filtration` (3) and `def:fod`: by noetherianity, the fields of definition of
the degree pieces stabilise at the field of definition of the ideal. -/
theorem exists_forall_idealFod_eq (I : Ideal (MvPolynomial ι K)) :
    ∃ d₀ : ℕ, ∀ d, d₀ ≤ d → idealFod I = fod (degSubspace I d) := by
  classical
  obtain ⟨S, hS⟩ := IsNoetherian.noetherian I
  refine ⟨S.sup fun f ↦ f.totalDegree, fun d hd ↦ ?_⟩
  refine le_antisymm (idealDefinedOver_iff.1 ?_) (fod_degSubspace_le_idealFod I d)
  refine idealDefinedOver_of_span _ hS (fun f hf ↦ ?_) (DefinedOver.of_fod_le le_rfl)
  exact (Finset.le_sup (f := fun f ↦ f.totalDegree) (Finset.mem_coe.1 hf)).trans hd

/-- `thm:weil-fod`: the field of definition of an ideal is finitely generated. -/
theorem exists_finset_closure_eq_idealFod (I : Ideal (MvPolynomial ι K)) :
    ∃ s : Finset K, Subfield.closure (s : Set K) = idealFod I := by
  obtain ⟨d₀, hd₀⟩ := exists_forall_idealFod_eq I
  rw [hd₀ d₀ le_rfl]
  exact exists_finset_closure_eq_fod (W := degSubspace I d₀)

/-! ### Equivariance of the field of definition -/

section Equivariance

variable (σ : K ≃+* K)

/-- `thm:weil-fod`: the field of definition of the image ideal is the image of the field of
definition. -/
theorem idealFod_map (I : Ideal (MvPolynomial ι K)) :
    idealFod (I.map (MvPolynomial.map σ.toRingHom)) = (idealFod I).map σ.toRingHom := by
  unfold idealFod
  rw [Subfield.map_iSup]
  exact iSup_congr fun d ↦ by rw [degSubspace_map, fod_map]

/-- `thm:weil-fod`: a field automorphism fixes `I` iff it fixes `idealFod I` pointwise. -/
theorem ideal_map_eq_self_iff (I : Ideal (MvPolynomial ι K)) :
    I.map (MvPolynomial.map σ.toRingHom) = I ↔ ∀ x ∈ idealFod I, σ x = x := by
  constructor
  · intro hI
    have hfix : ∀ d, ∀ y ∈ fod (degSubspace I d), σ y = y := fun d ↦
      (map_eq_self_iff (degSubspace I d) σ).1 (by rw [← degSubspace_map σ I d, hI])
    exact fun x hx ↦ (iSup_le fun d ↦ fun y hy ↦ hfix d y hy :
      idealFod I ≤ RingHom.eqLocusField σ.toRingHom (RingHom.id K)) hx
  · intro hfix
    set F := RingHom.eqLocusField σ.toRingHom (RingHom.id K)
    have hI : I = (I.comap (mapF F)).map (mapF F) :=
      idealDefinedOver_iff.2 fun x hx ↦ hfix x hx
    have hsub : σ.toRingHom.comp F.subtype = F.subtype := RingHom.ext fun x ↦ x.2
    have hcomp : (MvPolynomial.map σ.toRingHom).comp (mapF F) =
        (mapF F : MvPolynomial ι F →+* MvPolynomial ι K) :=
      RingHom.ext fun g ↦ by simp only [RingHom.comp_apply, mapF, map_map, hsub]
    conv_lhs => rw [hI]
    rw [Ideal.map_map, hcomp]
    exact hI.symm

end Equivariance

end

end GroupConfig
