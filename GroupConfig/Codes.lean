import GroupConfig.Rank
import Mathlib.Algebra.Polynomial.Roots
import Mathlib.Algebra.Polynomial.Lifts

/-!
# Codes of finite sets of tuples

Blueprint `sources/group_configuration/03-codes.tex`, `def:code` and `lem:code`(1)–(3).

A finite set `S` of tuples `s : ι → R` is encoded by the polynomial
`codePoly S = ∏_{s ∈ S} (T - ∑_j s_j U_j)`, a monic polynomial in `T` over `R[U]`, and by
its scalar coefficient carrier `code S`, the finite set of nonzero scalar coefficients.
The indexed coefficients are retained by `codePoly S`; equality of scalar carriers alone
is not asserted to determine the tuples.  The code polynomial
determines `S` (`codePoly_injective`, via its roots over the domain `R[U]`) and is natural
in `R` (`codePoly_map`), so an automorphism fixes `code S` pointwise iff it stabilises `S`
(`fixes_code_iff`).  The code lies in the ring generated by the coordinates of `S`
(`code_subset_adjoin`), and the coordinates are algebraic over the field generated by the
code (`mem_racl_code`, by specialising the variables `U` to unit vectors), so the code and
the coordinates have the same relative algebraic closure (`racl_code_eq`).

`lem:code`(4) and the codes of conjugate sets (`def:conjset`, `lem:conjcode`) need the
Galois description of definable closure. They remain separate obligations here
and are consumers of the pending `GroupConfig.ConjugateSet` layer.

**Status:** the indexed coding polynomial is injective over domains, and
scalar coefficient carriers are finite and natural. The fixed-point/stabilizer
criterion, containment in the coordinate ring, and equality of relative
algebraic closures are proved. The finite degree-bounded coefficient-vector
presentation and the definable-closure/conjugate-set clauses remain separate.
No injectivity of the scalar coefficient carrier is claimed.
-/

namespace GroupConfig

open AclGeom MvPolynomial Set

noncomputable section

/-! ### Embeddings of tuples -/

section Emb

variable {ι R R' : Type*}

/-- Composition with an injective map, as an embedding of tuples. -/
def compEmb (f : R → R') (hf : Function.Injective f) : (ι → R) ↪ (ι → R') :=
  ⟨fun s ↦ f ∘ s, hf.comp_left⟩

@[simp]
theorem compEmb_apply (f : R → R') (hf : Function.Injective f) (s : ι → R) :
    compEmb f hf s = f ∘ s := rfl

end Emb

/-! ### Linear forms and the code polynomial -/

section Ring

variable {R : Type*} [CommRing R] {ι : Type*} [Fintype ι]

/-- The linear form `∑ j, s j * U j` attached to a tuple `s`. -/
def linForm (s : ι → R) : MvPolynomial ι R := ∑ j, C (s j) * X j

theorem coeff_linForm_single (s : ι → R) (j : ι) :
    (linForm s).coeff (Finsupp.single j 1) = s j := by
  classical
  simp only [linForm, coeff_sum, coeff_C_mul, coeff_X]
  rw [Finset.sum_eq_single j]
  · simp
  · intro j' _ hj'
    have : Finsupp.single j' (1 : ℕ) ≠ Finsupp.single j 1 := fun h ↦
      hj' ((Finsupp.single_left_inj one_ne_zero).1 h)
    simp [this]
  · intro h
    exact absurd (Finset.mem_univ j) h

theorem linForm_injective : Function.Injective (linForm (R := R) (ι := ι)) := by
  intro s s' h
  funext j
  rw [← coeff_linForm_single s j, ← coeff_linForm_single s' j, h]

/-- Naturality of linear forms. -/
theorem map_linForm {R' : Type*} [CommRing R'] (f : R →+* R') (s : ι → R) :
    MvPolynomial.map f (linForm s) = linForm (f ∘ s) := by
  simp [linForm, map_sum]

/-- `def:code`: the code polynomial `∏_{s ∈ S} (T - ∑_j s_j U_j)` of a finite set of tuples,
as a monic polynomial in `T` over `R[U]`. -/
def codePoly (S : Finset (ι → R)) : Polynomial (MvPolynomial ι R) :=
  ∏ s ∈ S, (Polynomial.X - Polynomial.C (linForm s))

theorem codePoly_monic (S : Finset (ι → R)) : (codePoly S).Monic :=
  Polynomial.monic_prod_of_monic _ _ fun s _ ↦ Polynomial.monic_X_sub_C (linForm s)

/-- Naturality of the code polynomial along injective ring homomorphisms. -/
theorem codePoly_map {R' : Type*} [CommRing R'] (f : R →+* R') (hf : Function.Injective f)
    (S : Finset (ι → R)) :
    codePoly (S.map (compEmb f hf)) = (codePoly S).map (MvPolynomial.map f) := by
  unfold codePoly
  rw [Finset.prod_map, Polynomial.map_prod]
  refine Finset.prod_congr rfl fun s _ ↦ ?_
  rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, map_linForm, compEmb_apply]

theorem roots_codePoly [IsDomain R] (S : Finset (ι → R)) :
    (codePoly S).roots = S.val.map linForm := by
  unfold codePoly
  rw [Finset.prod_eq_multiset_prod,
    ← Polynomial.roots_multiset_prod_X_sub_C (S.val.map linForm), Multiset.map_map]
  rfl

/-- `lem:code`(2): the code polynomial determines the set. -/
theorem codePoly_injective [IsDomain R] : Function.Injective (codePoly (R := R) (ι := ι)) := by
  intro S S' h
  have h' := congrArg Polynomial.roots h
  rw [roots_codePoly, roots_codePoly] at h'
  exact Finset.val_injective (Multiset.map_injective linForm_injective h')

/-! ### The code -/

/-- `def:code`: the code of `S`, the set of all coefficients of its code polynomial. -/
def code (S : Finset (ι → R)) : Set R :=
  {x | ∃ i, x ∈ ((codePoly S).coeff i).coeffs}

theorem mem_code_iff {S : Finset (ι → R)} {x : R} :
    x ∈ code S ↔ ∃ i, x ∈ ((codePoly S).coeff i).coeffs :=
  Iff.rfl

theorem code_finite (S : Finset (ι → R)) : (code S).Finite := by
  refine ((Finset.range ((codePoly S).natDegree + 1)).finite_toSet.biUnion
    fun i _ ↦ ((codePoly S).coeff i).coeffs.finite_toSet).subset ?_
  rintro x ⟨i, hi⟩
  refine mem_iUnion₂.2 ⟨i, Finset.mem_range.2 ?_, hi⟩
  by_contra h
  push Not at h
  rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)] at hi
  simp [coeffs_zero] at hi

theorem coeff_coeff_mem_code {S : Finset (ι → R)} {i : ℕ} {m : ι →₀ ℕ}
    (h : ((codePoly S).coeff i).coeff m ≠ 0) : ((codePoly S).coeff i).coeff m ∈ code S :=
  ⟨i, mem_coeffs_iff.2 ⟨m, mem_support_iff.2 h, rfl⟩⟩

/-- `lem:code`(1): naturality of codes. -/
theorem code_map {R' : Type*} [CommRing R'] (f : R →+* R') (hf : Function.Injective f)
    (S : Finset (ι → R)) : code (S.map (compEmb f hf)) = f '' code S := by
  ext x
  simp only [mem_code_iff, codePoly_map f hf, Polynomial.coeff_map, mem_image]
  constructor
  · rintro ⟨i, hi⟩
    obtain ⟨m, hm, rfl⟩ := mem_coeffs_iff.1 hi
    rw [coeff_map]
    refine ⟨((codePoly S).coeff i).coeff m, ⟨i, mem_coeffs_iff.2 ⟨m, ?_, rfl⟩⟩, rfl⟩
    rwa [support_map_of_injective _ hf] at hm
  · rintro ⟨y, ⟨i, hi⟩, rfl⟩
    obtain ⟨m, hm, rfl⟩ := mem_coeffs_iff.1 hi
    refine ⟨i, mem_coeffs_iff.2 ⟨m, ?_, ?_⟩⟩
    · rwa [support_map_of_injective _ hf]
    · rw [coeff_map]

/-- The coefficients of the code polynomial of a mapped set. -/
theorem map_coeff_coeff_codePoly {R' : Type*} [CommRing R'] (f : R →+* R')
    (hf : Function.Injective f) (S : Finset (ι → R)) (i : ℕ) (m : ι →₀ ℕ) :
    f (((codePoly S).coeff i).coeff m) = ((codePoly (S.map (compEmb f hf))).coeff i).coeff m := by
  rw [codePoly_map f hf, Polynomial.coeff_map, coeff_map]

/-- `lem:code`(2): an injective endomorphism fixes the code pointwise iff it stabilises the
set. -/
theorem fixes_code_iff [IsDomain R] (f : R →+* R) (hf : Function.Injective f)
    (S : Finset (ι → R)) :
    (∀ x ∈ code S, f x = x) ↔ S.map (compEmb f hf) = S := by
  constructor
  · intro h
    apply codePoly_injective
    rw [codePoly_map f hf]
    ext i m
    rw [Polynomial.coeff_map, coeff_map]
    by_cases hm : ((codePoly S).coeff i).coeff m = 0
    · rw [hm, map_zero]
    · exact h _ (coeff_coeff_mem_code hm)
  · intro h x hx
    obtain ⟨i, hi⟩ := hx
    obtain ⟨m, -, rfl⟩ := mem_coeffs_iff.1 hi
    rw [map_coeff_coeff_codePoly f hf, h]

end Ring

/-! ### Codes over a field -/

section Field

variable {k K : Type*} [Field k] [Field K] [Algebra k K] {ι : Type*} [Fintype ι]

/-- `lem:code`(2) for automorphisms over `k`: `σ` fixes the code pointwise iff `σ S = S`. -/
theorem fixes_code_iff_algEquiv (σ : K ≃ₐ[k] K) (S : Finset (ι → K)) :
    (∀ x ∈ code S, σ x = x) ↔ S.map (compEmb σ σ.injective) = S :=
  fixes_code_iff σ.toRingEquiv.toRingHom σ.injective S

/-- The set of coordinates of the tuples of `S`. -/
def coords (S : Finset (ι → K)) : Set K := ⋃ s ∈ S, range s

/-- `lem:code`(1): the code lies in the ring generated over `k` by the coordinates. -/
theorem code_subset_adjoin (S : Finset (ι → K)) :
    code S ⊆ (Algebra.adjoin k (coords S) : Set K) := by
  have hS : ∀ s ∈ S, ∀ j, s j ∈ Algebra.adjoin k (coords S) := fun s hs j ↦
    Algebra.subset_adjoin (mem_iUnion₂.2 ⟨s, hs, mem_range_self j⟩)
  let lift : {s // s ∈ S} ↪ (ι → Algebra.adjoin k (coords S)) :=
    ⟨fun s j ↦ ⟨s.1 j, hS s.1 s.2 j⟩, fun s s' h ↦ Subtype.ext (funext fun j ↦
      congrArg Subtype.val (congrFun h j))⟩
  have hinj : Function.Injective ⇑(algebraMap (Algebra.adjoin k (coords S)) K) :=
    Subtype.val_injective
  have hS' : (S.attach.map lift).map (compEmb _ hinj) = S := by
    rw [Finset.map_map,
      show lift.trans (compEmb _ hinj) = Function.Embedding.subtype _ from
        Function.Embedding.ext fun s ↦ rfl,
      Finset.attach_map_val]
  have hcode : code S =
      ⇑(algebraMap (Algebra.adjoin k (coords S)) K) '' code (S.attach.map lift) := by
    conv_lhs => rw [← hS']
    exact code_map (algebraMap (Algebra.adjoin k (coords S)) K) hinj (S.attach.map lift)
  rw [hcode]
  rintro _ ⟨y, -, rfl⟩
  exact y.2

section Single

variable [DecidableEq ι]

/-- Specialising the variables `U` to the `j`-th unit vector picks out the `j`-th
coordinate. -/
theorem aeval_single_linForm (s : ι → K) (j : ι) :
    aeval (Pi.single j (1 : K)) (linForm s) = s j := by
  simp [linForm, Pi.single_apply]

/-- The code polynomial specialised at the `j`-th unit vector is `∏_{s ∈ S} (T - s_j)`. -/
theorem map_aeval_single_codePoly (S : Finset (ι → K)) (j : ι) :
    (codePoly S).map (aeval (Pi.single j (1 : K))).toRingHom =
      ∏ s ∈ S, (Polynomial.X - Polynomial.C (s j)) := by
  unfold codePoly
  rw [Polynomial.map_prod]
  refine Finset.prod_congr rfl fun s _ ↦ ?_
  rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
  congr 2
  exact aeval_single_linForm s j

omit [Fintype ι] in
/-- Specialisations at unit vectors lie in the ring generated by the coefficients. -/
theorem aeval_single_mem_adjoin (p : MvPolynomial ι K) (j : ι) :
    aeval (Pi.single j (1 : K)) p ∈ Algebra.adjoin k (p.coeffs : Set K) := by
  change eval (Pi.single j (1 : K)) p ∈ _
  rw [eval_eq]
  refine Subalgebra.sum_mem _ fun m hm ↦ Subalgebra.mul_mem _ ?_
    (Subalgebra.prod_mem _ fun i _ ↦ Subalgebra.pow_mem _ ?_ _)
  · exact Algebra.subset_adjoin (mem_coeffs_iff.2 ⟨m, hm, rfl⟩)
  · rw [Pi.single_apply]
    split_ifs
    · exact Subalgebra.one_mem _
    · exact Subalgebra.zero_mem _

end Single

/-- `lem:code`(3): every coordinate of every tuple of `S` is algebraic over the field generated
by the code. -/
theorem mem_racl_code {S : Finset (ι → K)} {s : ι → K} (hs : s ∈ S) (j : ι) :
    s j ∈ racl k (code S) := by
  classical
  rw [mem_racl_iff_isAlgebraic_adjoin]
  -- The specialised code polynomial has coefficients in the ring generated by the code.
  have hq : (codePoly S).map (aeval (Pi.single j (1 : K))).toRingHom ∈
      Polynomial.lifts (algebraMap (Algebra.adjoin k (code S)) K) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro i
    rw [Polynomial.coeff_map]
    refine ⟨⟨_, ?_⟩, rfl⟩
    refine (Algebra.adjoin_mono ?_) (aeval_single_mem_adjoin (k := k) _ j)
    intro x hx
    obtain ⟨m, hm, rfl⟩ := mem_coeffs_iff.1 (Finset.mem_coe.1 hx)
    exact coeff_coeff_mem_code (mem_support_iff.1 hm)
  obtain ⟨q', hq'map, -, hq'monic⟩ :=
    Polynomial.lifts_and_degree_eq_and_monic hq ((codePoly_monic S).map _)
  -- It is monic and vanishes at `s j`, so `s j` is integral over that ring.
  refine IsIntegral.isAlgebraic ⟨q', hq'monic, ?_⟩
  rw [← Polynomial.eval_map, hq'map, map_aeval_single_codePoly, Polynomial.eval_prod]
  exact Finset.prod_eq_zero hs (by simp)

/-- `lem:code`(3): the code and the coordinates generate the same relatively algebraically
closed subfield. -/
theorem racl_code_eq (S : Finset (ι → K)) : racl k (code S) = racl k (coords S) := by
  refine le_antisymm (racl_le_of_subset_racl ?_) (racl_le_of_subset_racl ?_)
  · intro x hx
    exact Algebra.adjoin_le (S := (racl k (coords S)).toSubalgebra) (subset_racl k _)
      (code_subset_adjoin (k := k) S hx)
  · intro x hx
    unfold coords at hx
    obtain ⟨s, hs, j, rfl⟩ := mem_iUnion₂.1 hx
    exact mem_racl_code hs j

end Field

end

end GroupConfig
