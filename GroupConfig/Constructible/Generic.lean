import GroupConfig.Constructible.Closure
import GroupConfig.Locus
import Mathlib.Data.ENat.BigOperators
/-!
# Generic quantification by finite sampling

Supplemental `sources/group_configuration/09-constructibility.tex`,
`lem:gen-constructible` and `lem:genquant`.

Automorphisms over the coefficient field preserve constructible membership.
Conjugacy therefore makes membership constant on generic points of a represented
base locus. A constructible subset of that locus containing no generic point
lies in a proper polynomial zero set over its coefficient field.

For N parameter coordinates, adjoining those parameters lowers rank on at most
N members of a finite family with additive joint rank. Consequently, among at
least 2N+1 generic samples, a predicate holds on every generic point over the
parameter field exactly when it holds on at least N+1 samples. This also equals
holding on some generic point. Finite Boolean closure makes the resulting locus
constructible over the field generated by the sample coordinates.

**Status:** these statements are proved for loci represented by finite tuples,
with algebraically closed base and ambient fields in a universal domain where
stated. The coefficient field M is only assumed small, not algebraically closed.
The sampling theorem also permits zero-dimensional loci. Arbitrary-prime
realization is in `GroupConfig.PrimeLocus`, and group-of-germs extraction is in
`GroupConfig.Main`. The constructible presentation, chart and reconstruction
conclusions remain separate obligations.
-/

set_option linter.mathlibStandardSet true

namespace GroupConfig

open AclGeom IntermediateField Set MvPolynomial
open scoped BigOperators

variable {k K ι κ α : Type*} [Field k] [Field K] [Algebra k K]

/-! ### Rank loss in an independent finite family -/

-- Sole consumer: card_rank_drop_le. Finite subadditivity from the binary theorem.
private theorem erk_iUnion_le_sum {α : Type*} [Fintype α] (C : Set K)
    (S : α → Set K) : erk k C (⋃ i, S i) ≤ ∑ i, erk k C (S i) := by
  classical
  have h (s : Finset α) : erk k C (⋃ i ∈ s, S i) ≤ ∑ i ∈ s, erk k C (S i) := by
    induction s using Finset.induction_on with
    | empty => simp [erk_empty]
    | @insert i s hi ih =>
      rw [Finset.sum_insert hi, Finset.set_biUnion_insert]
      exact (erk_union_le k C _ _).trans (add_le_add le_rfl ih)
  simpa using h Finset.univ

open scoped Classical in
/-- The rank-counting step of the generic quantifier: adjoining U can lower
rank on at most rank(U/C) members of a finite independent family of finite sets.
The independence hypothesis states additivity of their total rank. -/
theorem card_rank_drop_le {α : Type*} [Fintype α] (C U : Set K)
    (S : α → Set K) (hS : ∀ i, (S i).Finite)
    (hind : erk k C (⋃ i, S i) = ∑ i, erk k C (S i)) :
    ((Finset.univ.filter fun i ↦ erk k (C ∪ U) (S i) < erk k C (S i)).card : ℕ∞) ≤
      erk k C U := by
  classical
  let d (i : α) : ℕ∞ := if erk k (C ∪ U) (S i) < erk k C (S i) then 1 else 0
  have hdrop (i : α) : erk k (C ∪ U) (S i) + d i ≤ erk k C (S i) := by
    dsimp only [d]
    split_ifs with h
    · exact (ENat.add_one_le_iff (erk_ne_top k (hS i) _)).2 h
    · simpa using erk_base_mono k (subset_union_left : C ⊆ C ∪ U) (S i)
  have hsum : (∑ i, erk k (C ∪ U) (S i)) + (∑ i, d i) ≤
      ∑ i, erk k C (S i) := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_le_sum fun i _ ↦ hdrop i
  have hbound : (∑ i, erk k C (S i)) ≤ erk k C U + ∑ i, erk k (C ∪ U) (S i) := by
    calc (∑ i, erk k C (S i)) = erk k C (⋃ i, S i) := hind.symm
      _ ≤ erk k C (U ∪ ⋃ i, S i) := erk_mono k C subset_union_right
      _ = erk k C U + erk k (C ∪ U) (⋃ i, S i) := erk_union_eq k C U _
      _ ≤ erk k C U + ∑ i, erk k (C ∪ U) (S i) :=
        add_le_add le_rfl (erk_iUnion_le_sum (k := k) (C ∪ U) S)
  have hfinite : (∑ i, erk k (C ∪ U) (S i)) ≠ ⊤ :=
    ENat.sum_ne_top.2 fun i _ ↦ erk_ne_top k (hS i) _
  have hcount : (∑ i, d i) ≤ erk k C U :=
    (ENat.add_le_add_iff_left hfinite).1 (by
      simpa only [add_comm (erk k C U)] using hsum.trans hbound)
  simpa [d, ← Finset.sum_filter] using hcount

/-! ### Constructible predicates and generic orbits -/

open scoped Classical in
/-- A finite cardinality threshold on constructible predicates is constructible.
The named consumer is the majority formula in the generic quantifier. -/
theorem IsConstructibleOver.card_le {α : Type*} [Fintype α]
    (s : α → Set (ι → K)) (hs : ∀ i, IsConstructibleOver k (s i)) (n : ℕ) :
    IsConstructibleOver k {x | n ≤ (Finset.univ.filter fun i ↦ x ∈ s i).card} := by
  classical
  have hc : IsConstructibleOver k
      (⋃ I : {I : Finset α // n ≤ I.card}, ⋂ i : (I : Finset α), s (i : α)) :=
    IsConstructibleOver.iUnion fun I ↦ IsConstructibleOver.iInter fun i ↦ hs i
  convert hc using 1
  ext x
  simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_iInter]
  constructor
  · intro hx
    refine ⟨⟨Finset.univ.filter (fun i ↦ x ∈ s i), hx⟩, ?_⟩
    intro i
    exact (Finset.mem_filter.1 i.2).2
  · rintro ⟨I, hI⟩
    refine I.2.trans (Finset.card_le_card ?_)
    intro i hi
    exact Finset.mem_filter.2 ⟨Finset.mem_univ i, hI ⟨i, hi⟩⟩

/-- The automorphism invariance needed for generic-orbit constancy: polynomials
with coefficients in k have invariant vanishing under automorphisms over k. -/
theorem IsConstructibleOver.mem_comp_algEquiv_iff {s : Set (ι → K)}
    (hs : IsConstructibleOver k s) (σ : K ≃ₐ[k] K) (x : ι → K) :
    (σ ∘ x) ∈ s ↔ x ∈ s := by
  obtain ⟨cells, hcells⟩ := isConstructibleOver_iff_exists_polynomial_data.mp hs
  rw [hcells, hcells]
  have hzero (p : MvPolynomial ι k) :
      MvPolynomial.aeval (σ ∘ x) p = 0 ↔ MvPolynomial.aeval x p = 0 := by
    change MvPolynomial.aeval (fun i ↦ σ.toAlgHom (x i)) p = 0 ↔
      MvPolynomial.aeval x p = 0
    rw [← MvPolynomial.comp_aeval_apply (f := x) σ.toAlgHom p]
    exact map_eq_zero_iff _ σ.injective
  simp only [ne_eq, hzero]

/-- An invariant set has constant membership on the generic points of a represented
locus. This is supplemental `lem:gen-constructible`(1), via generic-point conjugacy. -/
theorem IsGenericOver.mem_iff_of_invariant [IsAlgClosed K] [Finite κ]
    {M : IntermediateField k K} {a y z : κ → K} {s : Set (κ → K)}
    (hy : IsGenericOver M a y) (hz : IsGenericOver M a z)
    (hinv : ∀ σ : K ≃ₐ[↥M] K, ∀ v, (σ ∘ v) ∈ s ↔ v ∈ s) : y ∈ s ↔ z ∈ s := by
  obtain ⟨σ, hσ⟩ := hy.exists_algEquiv hz
  simpa only [show σ ∘ y = z from funext hσ] using (hinv σ y).symm

/-! ### The parameter field and polynomial fibers -/

private theorem racl_restrictScalars (M : IntermediateField k K) (U : Set K) :
    (racl (↥M) U).restrictScalars k = racl k ((M : Set K) ∪ U) := by
  ext z
  change z ∈ racl (↥M) U ↔ z ∈ racl k ((M : Set K) ∪ U)
  rw [mem_racl_iff, mem_racl_iff, ← restrictScalars_adjoin k M U]
  rfl

private theorem constructible_left_fiber (x : ι → k)
    {s : Set ((ι ⊕ κ) → K)} (hs : IsConstructibleOver k s) :
    IsConstructibleOver k {y | Sum.elim (fun i ↦ algebraMap k K (x i)) y ∈ s} := by
  have hp := hs.preimage_polynomial (Sum.elim (fun i : ι ↦ C (x i))
    (fun j : κ ↦ X j))
  have hmap : (fun (y : κ → K) i ↦ aeval y
      (Sum.elim (fun i : ι ↦ C (x i)) (fun j : κ ↦ X j) i)) =
      (fun y ↦ Sum.elim (fun i ↦ algebraMap k K (x i)) y) := by
    funext y i
    cases i <;> simp
  convert hp using 1
  ext y
  simp only [Set.mem_preimage, Set.mem_ofPred_eq]
  exact (congrArg (fun z ↦ z ∈ s) (congrFun hmap y)).symm.to_iff

private theorem constructible_right_fiber (y : κ → k)
    {s : Set ((ι ⊕ κ) → K)} (hs : IsConstructibleOver k s) :
    IsConstructibleOver k {x | Sum.elim x (fun j ↦ algebraMap k K (y j)) ∈ s} := by
  have hp := hs.preimage_polynomial (Sum.elim (fun i : ι ↦ X i)
    (fun j : κ ↦ C (y j)))
  have hmap : (fun (x : ι → K) i ↦ aeval x
      (Sum.elim (fun i : ι ↦ X i) (fun j : κ ↦ C (y j)) i)) =
      (fun x ↦ Sum.elim x (fun j ↦ algebraMap k K (y j))) := by
    funext x i
    cases i <;> simp
  convert hp using 1
  ext x
  simp only [Set.mem_preimage, Set.mem_ofPred_eq]
  exact (congrArg (fun z ↦ z ∈ s) (congrFun hmap x)).symm.to_iff

/-! ### Finite sampling and the generic quantifier -/

open scoped Classical in
private theorem sampling_iff {Y : Type*} [Fintype α] (n : ℕ) (t : α → Y)
    (bad : α → Prop) [DecidablePred bad] (P Q : Y → Prop)
    (hb : (Finset.univ.filter bad).card ≤ n) (hr : 2 * n + 1 ≤ Fintype.card α)
    (hg : ∀ i, ¬bad i → P (t i))
    (hu : ∀ y z, P y → P z → (Q y ↔ Q z)) :
    ((∀ y, P y → Q y) ↔ n + 1 ≤ (Finset.univ.filter fun i ↦ Q (t i)).card) ∧
    ((∀ y, P y → Q y) ↔ ∃ y, P y ∧ Q y) := by
  classical
  have hgood : ∃ i, ¬bad i := by
    by_contra! h
    have heq : Finset.univ.filter bad = Finset.univ := by
      ext i
      simp [h i]
    rw [heq, Finset.card_univ] at hb
    omega
  constructor
  · constructor
    · intro h
      have hsub : (Finset.univ.filter fun i ↦ ¬Q (t i)) ⊆ Finset.univ.filter bad := by
        intro i hi
        refine Finset.mem_filter.2 ⟨Finset.mem_univ i, ?_⟩
        by_contra hbi
        exact (Finset.mem_filter.1 hi).2 (h (t i) (hg i hbi))
      have hle := (Finset.card_le_card hsub).trans hb
      have hc := Finset.card_filter_add_card_filter_not (s := Finset.univ)
        (fun i ↦ Q (t i))
      rw [Finset.card_univ] at hc
      omega
    · intro h
      have hex : ∃ i, Q (t i) ∧ ¬bad i := by
        by_contra! hnot
        have hsub : (Finset.univ.filter fun i ↦ Q (t i)) ⊆ Finset.univ.filter bad := by
          intro i hi
          exact Finset.mem_filter.2 ⟨Finset.mem_univ i, hnot i (Finset.mem_filter.1 hi).2⟩
        have hle := (Finset.card_le_card hsub).trans hb
        omega
      obtain ⟨i, hqi, hbi⟩ := hex
      intro y hy
      exact (hu (t i) y (hg i hbi) hy).1 hqi
  · constructor
    · intro h
      obtain ⟨i, hi⟩ := hgood
      exact ⟨t i, hg i hi, h (t i) (hg i hi)⟩
    · rintro ⟨z, hz, hqz⟩ y hy
      exact (hu z y hz hy).1 hqz

open scoped Classical in
/-- The majority formula for generic quantification over a represented base locus.
The field M need not be algebraically closed. The assumptions on the samples are
exact genericity over M and additivity of their joint rank over M. -/
theorem generic_quantifier_iff [IsAlgClosed k] [IsAlgClosed K] [UniversalDomain k K]
    [Fintype ι] [Finite κ] [Fintype α] (M : IntermediateField k K)
    (hM : IsSmall k (M : Set K)) (a : κ → K) (t : α → κ → K)
    (ht : ∀ i, IsGenericOver M a (t i))
    (hind : erk k (M : Set K) (⋃ i, range (t i)) = ∑ i, erk k (M : Set K) (range (t i)))
    (hr : 2 * Fintype.card ι + 1 ≤ Fintype.card α)
    {s : Set ((ι ⊕ κ) → K)} (hs : IsConstructibleOver (↥M) s) (x : ι → K) :
    ((∀ y, IsGenericOver ((racl (↥M) (range x)).restrictScalars k) a y → Sum.elim x y ∈ s) ↔
      Fintype.card ι + 1 ≤ (Finset.univ.filter fun i ↦ Sum.elim x (t i) ∈ s).card) ∧
    ((∀ y, IsGenericOver ((racl (↥M) (range x)).restrictScalars k) a y → Sum.elim x y ∈ s) ↔
      ∃ y, IsGenericOver ((racl (↥M) (range x)).restrictScalars k) a y ∧ Sum.elim x y ∈ s) := by
  classical
  let E := racl (↥M) (range x)
  have hE : E.restrictScalars k = racl k ((M : Set K) ∪ range x) :=
    racl_restrictScalars M (range x)
  have hsmall : IsSmall k ((E.restrictScalars k : IntermediateField k K) : Set K) := by
    rw [hE]
    exact (hM.union (IsSmall.of_finite (finite_range x))).racl
  have hcount := card_rank_drop_le (k := k) (M : Set K) (range x)
    (fun i ↦ range (t i)) (fun i ↦ finite_range (t i)) hind
  have hbound : erk k (M : Set K) (range x) ≤ (Fintype.card ι : ℕ∞) := by
    calc
      _ ≤ (range x).encard := erk_le_encard k _ _
      _ ≤ (Set.univ : Set ι).encard := by
        simpa only [Set.image_univ] using Set.encard_image_le x Set.univ
      _ = _ := by simp [ENat.card_eq_coe_fintype_card]
  have hb : (Finset.univ.filter fun i ↦
      erk k ((M : Set K) ∪ range x) (range (t i)) < erk k (M : Set K) (range (t i))).card ≤
      Fintype.card ι := by
    exact_mod_cast hcount.trans hbound
  have hg (i : α) (hi : ¬erk k ((M : Set K) ∪ range x) (range (t i)) <
      erk k (M : Set K) (range (t i))) :
      IsGenericOver ((racl (↥M) (range x)).restrictScalars k) a (t i) := by
    have heq : erk k ((M : Set K) ∪ range x) (range (t i)) =
        erk k (M : Set K) (range (t i)) :=
      le_antisymm (erk_base_mono k subset_union_left _) (not_lt.1 hi)
    have hind' : IndepOver k ∅ (range (t i)) (E.restrictScalars k : Set K) := by
      apply indepOver_of_erk_eq (finite_range (t i))
      rw [empty_union, hE, erk_racl_base, heq, (ht i).erk_coe_eq]
    have hself := isGenericOver_self_of_indepOver hsmall hind'
    change AclGeom.idealOf (↥((racl (↥M) (range x)).restrictScalars k)) (t i) = _
    rw [hself, (ht i).idealOf_eq]
  have hf : IsConstructibleOver (↥E) {y | Sum.elim x y ∈ s} := by
    let xE : ι → E := fun i ↦ ⟨x i, subset_racl (↥M) (range x) (mem_range_self i)⟩
    exact constructible_left_fiber xE hs.extend_base
  have hu (y z : κ → K) (hy : IsGenericOver ((racl (↥M) (range x)).restrictScalars k) a y)
      (hz : IsGenericOver ((racl (↥M) (range x)).restrictScalars k) a z) :
      Sum.elim x y ∈ s ↔ Sum.elim x z ∈ s := by
    apply hy.mem_iff_of_invariant hz
    intro σ v
    -- Rebuild over E so scalar-restriction instances do not leak into rewriting.
    let σE : K ≃ₐ[↥E] K :=
      { σ.toRingEquiv with commutes' := σ.commutes }
    exact hf.mem_comp_algEquiv_iff σE v
  exact sampling_iff (Fintype.card ι) t
    (fun i ↦ erk k ((M : Set K) ∪ range x) (range (t i)) < erk k (M : Set K) (range (t i)))
    (fun y ↦ IsGenericOver ((racl (↥M) (range x)).restrictScalars k) a y)
    (fun y ↦ Sum.elim x y ∈ s) hb hr hg hu

open scoped Classical in
/-- The generic-quantifier majority locus is constructible over the field generated
by all sample coordinates over M. -/
theorem constructible_generic_quantifier [IsAlgClosed k] [IsAlgClosed K]
    [UniversalDomain k K] [Fintype ι] [Finite κ] [Fintype α]
    (M : IntermediateField k K) (hM : IsSmall k (M : Set K))
    (a : κ → K) (t : α → κ → K) (ht : ∀ i, IsGenericOver M a (t i))
    (hind : erk k (M : Set K) (⋃ i, range (t i)) = ∑ i, erk k (M : Set K) (range (t i)))
    (hr : 2 * Fintype.card ι + 1 ≤ Fintype.card α)
    {s : Set ((ι ⊕ κ) → K)} (hs : IsConstructibleOver (↥M) s) :
    IsConstructibleOver (↥(adjoin (↥M) (⋃ i, range (t i))))
      {x | ∀ y, IsGenericOver ((racl (↥M) (range x)).restrictScalars k) a y →
        Sum.elim x y ∈ s} := by
  classical
  let E := adjoin (↥M) (⋃ i, range (t i))
  have hf (i : α) : IsConstructibleOver (↥E) {x | Sum.elim x (t i) ∈ s} := by
    let ti : κ → E := fun j ↦ ⟨t i j,
      subset_adjoin (↥M) _ (mem_iUnion.2 ⟨i, mem_range_self j⟩)⟩
    exact constructible_right_fiber ti hs.extend_base
  have h := IsConstructibleOver.card_le (fun i ↦ {x | Sum.elim x (t i) ∈ s}) hf
    (Fintype.card ι + 1)
  convert h using 1
  ext x
  exact (generic_quantifier_iff M hM a t ht hind hr hs x).1

/-! ### A proper zero set containing a constructible set with no generic point -/

-- The sole consumer is exists_polynomial_zero_of_no_generic below.
private theorem separating_polynomial {s : Set (ι → K)} (hs : IsConstructibleOver k s)
    (e : ι → K) (he : e ∉ s)
    (hspec : ∀ x ∈ s, ∀ p : MvPolynomial ι k, aeval e p = 0 → aeval x p = 0) :
    ∃ p : MvPolynomial ι k, aeval e p ≠ 0 ∧ ∀ x ∈ s, aeval x p = 0 := by
  classical
  obtain ⟨cells, hcells⟩ := isConstructibleOver_iff_exists_polynomial_data.mp hs
  have hcell (c : {c // c ∈ cells}) : ∃ p : MvPolynomial ι k,
      aeval e p ≠ 0 ∧ ∀ x ∈ s,
        (∀ i, aeval x (c.1.g i) = 0) → aeval x c.1.f ≠ 0 → aeval x p = 0 := by
    by_cases hg : ∃ i, aeval e (c.1.g i) ≠ 0
    · obtain ⟨i, hi⟩ := hg
      exact ⟨c.1.g i, hi, fun x _ hx _ ↦ hx i⟩
    · have hge : ∀ i, aeval e (c.1.g i) = 0 := by simpa using hg
      have hfe : aeval e c.1.f = 0 := by
        by_contra hf
        exact he ((hcells e).2 ⟨c.1, c.2, hge, hf⟩)
      exact ⟨1, by simp, fun x hx _ hfx ↦ (hfx (hspec x hx c.1.f hfe)).elim⟩
  choose p hpe hpx using hcell
  refine ⟨∏ c, p c, ?_, ?_⟩
  · rw [map_prod]
    exact Finset.prod_ne_zero_iff.2 fun c _ ↦ hpe c
  · intro x hx
    obtain ⟨c, hc, hcg, hcf⟩ := (hcells x).1 hx
    rw [map_prod]
    exact Finset.prod_eq_zero (Finset.mem_univ (⟨c, hc⟩ : {c // c ∈ cells}))
      (hpx ⟨c, hc⟩ x hx hcg hcf)

/-- A constructible subset of a represented irreducible locus that contains no
point generic over the algebraic closure of its coefficient field is contained
in a proper polynomial zero set over that field. This is the final clause of
supplemental `lem:gen-constructible`(2). -/
theorem exists_polynomial_zero_of_no_generic [IsAlgClosed k] [IsAlgClosed K]
    [UniversalDomain k K] [Finite ι] (M : IntermediateField k K)
    (hM : IsSmall k (M : Set K)) (a : ι → K) {s : Set (ι → K)}
    (hs : IsConstructibleOver (↥M) s)
    (hV : ∀ x ∈ s, ∀ p ∈ locusIdeal k a, aeval x p = 0)
    (hno : ∀ e, IsGenericOver (racl k (M : Set K)) a e → e ∉ s) :
    ∃ p : MvPolynomial ι (↥M),
      MvPolynomial.map (algebraMap (↥M) K) p ∉ locusIdeal k a ∧
      ∀ x ∈ s, aeval x p = 0 := by
  obtain ⟨e, he⟩ := exists_isGenericOver hM.racl a
  have hMN : M ≤ racl k (M : Set K) := subset_racl k (M : Set K)
  have heM := he.of_le hMN
  have hspec : ∀ x ∈ s, ∀ p : MvPolynomial ι (↥M),
      aeval e p = 0 → aeval x p = 0 := by
    intro x hx p hp
    have hmap := map_mem_locusIdeal (↥M) ((mem_idealOf_iff (↥M)).2 hp)
    rw [heM.locusIdeal_eq] at hmap
    have hz := hV x hx _ hmap
    simpa only [MvPolynomial.aeval_map_algebraMap] using hz
  obtain ⟨p, hp, hps⟩ := separating_polynomial hs e (hno e he) hspec
  refine ⟨p, ?_, hps⟩
  rw [← heM.locusIdeal_eq, map_mem_locusIdeal_iff]
  exact fun h ↦ hp ((mem_idealOf_iff (↥M)).1 h)

end GroupConfig
